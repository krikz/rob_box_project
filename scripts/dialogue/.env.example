# Ключи для консоли диалога v2 (scripts/dialogue/chat.py) и замера понимания
# фразы (scripts/dialog/understanding_measure.py).
#
#   cp scripts/dialogue/.env.example scripts/dialogue/.env
#
# .env здесь НЕ коммитится (правило `.env` в корневом .gitignore ловит
# файл на любой глубине). Переменная, уже экспортированная в шелле,
# имеет приоритет над этим файлом — так CI не подхватывает локальные ключи.
#
# Достаточно ОДНОГО ключа. Цепочка по умолчанию - "deepseek" (--providers);
# провайдер без ключа не собирается, и консоль об этом говорит.

# ── MiniMax (primary на роботе: MiniMax-M3, tools + streaming) ─────────
# https://platform.minimaxi.com/user-center/basic-information/interface-key
MINIMAX_API_KEY=

# ── DeepSeek (fallback: дешёвый и быстрый) ────────────────────────────
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ── Jev (System One): классификатор варианта C замера понимания ───────
# JEV_MODEL необязателен (по умолчанию jev-1.13.0).
JEV_API_KEY=

# ── Опциональные провайдеры (см. --providers) ─────────────────────────
# MiMo (Xiaomi)
MIMO_API_KEY=
# Qwen (Alibaba DashScope)
DASHSCOPE_API_KEY=

# ── Дефолты запуска (перебиваются флагами CLI) ────────────────────────
# Цепочка провайдеров: первый — primary, остальные — fallback.
# ROBBOX_LLM_PROVIDERS=deepseek
# Файл e2e-памяти консоли (--db): «запомни…» переживает запуск. Вне боевой /data.
# ROBBOX_LOCAL_DB=~/.rob_box/console_memory.e2e.db
