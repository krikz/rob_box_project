+def _find_worktree_for_branch(repo_root: Path, branch_name: str) -> Optional[Path]:
+    """Return the worktree path that currently checks out ``branch_name``, or None.
+
+    Parses ``git worktree list --porcelain`` which emits one worktree as::
+
+        worktree /abs/path
+        HEAD <sha>
+        branch refs/heads/<branch>
+        ...
+
+    We match by ``branch refs/heads/<branch_name>`` and return the absolute
+    worktree path. Detached worktrees (no ``branch`` line) and any other
+    format mismatch are skipped silently — the only authoritative source
+    for "is this branch already checked out?" is that line, and we want
+    ``None`` (caller creates new) on every non-match.
+
+    Used by ``_ensure_git_worktree`` to detect the worktree-collision case
+    before issuing ``git worktree add`` (which fails with a fatal error
+    instead of a clean reuse path). Bounded timeout and stderr discarded
+    — this is a fast read-only check and any failure should fall through
+    to the existing ``worktree add`` path, which will surface its own
+    error if the branch truly is busy.
+
+    Ретро t_695f5138 (t_bc3ac7fb).
+    """
+    try:
+        result = subprocess.run(
+            ["git", "-C", str(repo_root), "worktree", "list", "--porcelain"],
+            capture_output=True,
+            text=True, encoding='utf-8', errors='replace',
+            timeout=30,
+            check=False,
+        )
+    except Exception:
+        return None
+    if result.returncode != 0:
+        return None
+    target_branch = f"refs/heads/{branch_name}"
+    current_path: Optional[Path] = None
+    for line in (result.stdout or "").splitlines():
+        if line.startswith("worktree "):
+            current_path = Path(line[len("worktree "):].strip()).expanduser()
+            continue
+        if line.startswith("branch "):
+            # ``line`` here still has the ``branch `` prefix; strip it
+            # before comparing to ``refs/heads/<branch>``. Reset on every
+            # branch line so a detached worktree (no ``branch`` line) is
+            # treated as "this slot didn't match" without poisoning the
+            # next worktree's state.
+            if current_path is not None and line[len("branch "):].strip() == target_branch:
+                return current_path
+            current_path = None
+    return None
+
+
