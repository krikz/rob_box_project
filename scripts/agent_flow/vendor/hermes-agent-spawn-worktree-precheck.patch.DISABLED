+class WorktreeBranchBusyError(RuntimeError):
+    """Raised when the requested worktree branch is already checked out.
+
+    Distinct from a generic ``RuntimeError`` so the dispatch loop can
+    route this specific failure mode through the dependency-blocked
+    path (``force_trip=True``) without consuming one of the
+    ``consecutive_failures`` retries. Retries are pointless here: the
+    holding worktree won't disappear between attempts, so a normal
+    retry-then-block cycle would burn two spawn_failed counters and
+    end in the same ``blocked`` state — except with two distinct
+    error events to triage, instead of one.
+
+    Ретро t_695f5138 (t_bc3ac7fb).
+    """
+
+
 def _ensure_git_worktree(repo_root: Path, target: Path, branch_name: str) -> None:
     """Materialize ``target`` as a linked git worktree under ``repo_root``."""
     target = target.expanduser()
@@ -8009,6 +8080,44 @@
         target_common = _git_common_dir(target)
         if target_common == repo_common:
             return
+    # Pre-spawn worktree-collision guard (ретро t_695f5138 / t_bc3ac7fb).
+    #
+    # ``git worktree add`` fatally rejects creating a new worktree for a
+    # branch that is already checked out somewhere else. When this fires
+    # mid-dispatch the failure surfaces as ``spawn_failed`` and the
+    # dispatcher retries — but the busy worktree never becomes free
+    # between attempts (an active worker holds it), so every retry
+    # immediately fails again until the breaker trips. The card then
+    # sits in ``blocked`` while triage keeps producing duplicate cards
+    # for the same branch.
+    #
+    # Detect the collision BEFORE invoking ``worktree add``. If the
+    # branch is already checked out at our own ``target``, the existing
+    # path-equals-target early return above handles it. Otherwise:
+    #
+    # * If the existing checkout lives at a path that is NOT ``target``,
+    #   raise ``WorktreeBranchBusyError`` with the occupied path so the
+    #   dispatch loop can route it through the dependency-blocked
+    #   path (force_trip=True, no spawn_failed retry storm).
+    #
+    # The check is best-effort: when ``git worktree list`` itself fails
+    # we fall through to ``worktree add`` and let it surface the
+    # canonical error — false negatives are observable, false positives
+    # are not.
+    existing = _find_worktree_for_branch(repo_root, branch_name)
+    if existing is not None:
+        existing_resolved = existing.resolve(strict=False)
+        target_resolved = target.resolve(strict=False)
+        if existing_resolved != target_resolved:
+            raise WorktreeBranchBusyError(
+                f"WORKTREE_BRANCH_BUSY: branch {branch_name!r} is already "
+                f"checked out at {existing_resolved} (requested target "
+                f"{target_resolved}). Reuse requires the worktree's path to "
+                f"match the task target; otherwise the task cannot dispatch "
+                f"without colliding with the active checkout. Wait for the "
+                f"holding worker to release the branch or rerun with a "
+                f"distinct branch_name."
+            )
     target.parent.mkdir(parents=True, exist_ok=True)
     if _git_branch_exists(repo_root, branch_name):
         cmd = ["git", "-C", str(repo_root), "worktree", "add", str(target), branch_name]
@@ -10808,6 +10917,23 @@
