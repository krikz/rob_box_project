+# ---------------------------------------------------------------------------
+# create_task(): per-task skills must belong to the assignee profile
+# Regression for t_6c6c98fb / t_ba12fefc — an LLM worker passed
+# assignee=architect with skills=["devops"] (a skill owned by a different
+# profile). The task was created, then the worker crashed on spawn when
+# `--skills devops` failed to resolve. create_task must reject that
+# combination up front with a readable error.
+# ---------------------------------------------------------------------------
+
+
+def test_create_task_rejects_skill_not_in_assignee_profile(kanban_home, monkeypatch):
+    """skills=[...] containing a foreign skill is rejected at creation."""
+    monkeypatch.setattr(
+        kb,
+        "_profile_skill_names",
+        lambda assignee: frozenset(
+            {"architecture-doc-review", "plan", "spike", "simplify-code"}
+        ),
+    )
+    with kb.connect() as conn:
+        with pytest.raises(ValueError, match=r"'devops' skill not installed in profile 'architect'"):
+            kb.create_task(
+                conn,
+                title="foreign skill",
+                assignee="architect",
+                skills=["devops"],
+            )
+        # Multiple foreign skills are all named at once.
+        with pytest.raises(ValueError, match=r"'devops', 'tester' skills not installed"):
+            kb.create_task(
+                conn,
+                title="foreign skills",
+                assignee="architect",
+                skills=["devops", "tester"],
+            )
+
+
+def test_create_task_accepts_skills_from_assignee_profile(kanban_home, monkeypatch):
+    """Skills that ARE installed on the assignee profile pass through."""
+    monkeypatch.setattr(
+        kb,
+        "_profile_skill_names",
+        lambda assignee: frozenset({"architecture-doc-review", "plan", "spike"}),
+    )
+    with kb.connect() as conn:
+        tid = kb.create_task(
+            conn,
+            title="own skills",
+            assignee="architect",
+            skills=["architecture-doc-review", "plan"],
+        )
+        task = kb.get_task(conn, tid)
+        assert task.skills == ["architecture-doc-review", "plan"]
+
+
+def test_create_task_skill_validation_skips_unknown_profile(kanban_home, monkeypatch):
+    """None from _profile_skill_names means 'no profile to validate' → skip.
+
+    External/plugin worker lanes are first-class assignees with no skills
+    tree; their tasks must not be rejected for carrying arbitrary skills.
+    """
+    monkeypatch.setattr(kb, "_profile_skill_names", lambda assignee: None)
+    with kb.connect() as conn:
+        tid = kb.create_task(
+            conn,
+            title="external lane",
+            assignee="external-worker",
+            skills=["some-plugin-skill"],
+        )
+        assert kb.get_task(conn, tid).assignee == "external-worker"
+
