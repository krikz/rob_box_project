+
+ARCHITECTURAL_KEYWORDS = (
+    "ADR-",
+    "ADR №",
+    "architecture decision",
+    "pre-merge gate",
+    "merge-gate",
+    "dispatcher",
+    "skill-validation",
+    "agent-flow",
+    "процесс-фикс",
+    "архитект",
+    "ADR ",
+    "process-fix",
+)
+NON_ARCHITECT_PROFILES = ("backend", "frontend", "tester")
+_TEST_SKILL_MARKERS = ("test-driven-development", "pytest", "jest")
+
+
+def _validate_scope_for_assignee(
+    assignee: Optional[str],
+    body: Optional[str],
+    skills: Optional[Iterable[str]],
+    *,
+    force: bool = False,
+) -> Optional[str]:
+    """Hint-only mis-scope detection for ``kanban create`` (ADR-0036 §4.1).
+
+    Returns a structured warning string when an implementation profile
+    (backend / frontend / tester) is being asked to do work that reads as
+    an architectural or process-fix decision AND the worker is being
+    pointed at a TDD-shaped skill. The intent is to flag — without
+    blocking — the classic mis-scope loop (ADR-0035 retrospective,
+    card t_e2ae0c29: ``assignee=backend`` + ``skills=[test-driven-
+    development]`` running 5h31m on what is really an ADR doc + a
+    merge-gate refactor).
+
+    Heuristic (no LLM, by design — ADR-0036 §5):
+
+      warn iff (and only iff):
+        assignee ∈ NON_ARCHITECT_PROFILES
+        AND body contains any ARCHITECTURAL_KEYWORDS substring
+        AND any of skills ∩ _TEST_SKILL_MARKERS is non-empty
+
+    Side effects when triggered:
+      * emit ``warnings.warn(...)`` so the CLI prints it to stderr;
+      * append a structured ``task_event`` row (kind='scope_hint') so the
+        dashboard surfaces the warning inline with the card.
+
+    ``force=True`` suppresses both side effects (Шифу override — escape
+    hatch via ``--force-scope``). Returns ``None`` when suppressed or the
+    heuristic does not match.
+
+    Returns:
+        The structured warning message string when a hint fires (the
+        caller may embed it in a comment), or ``None`` otherwise.
+    """
+    if force:
+        return None
+    if not assignee or not body:
+        return None
+    canonical = _canonical_assignee(assignee) or assignee
+    if canonical not in NON_ARCHITECT_PROFILES:
+        return None
+    body_lower = body.lower()
+    matched_kw: Optional[str] = None
+    for kw in ARCHITECTURAL_KEYWORDS:
+        if kw.lower() in body_lower:
+            matched_kw = kw
+            break
+    if matched_kw is None:
+        return None
+    skill_list = list(skills or ())
+    if not any(s in _TEST_SKILL_MARKERS for s in skill_list):
+        return None
+    msg = (
+        f"scope-hint: assignee={canonical!r} is in NON_ARCHITECT_PROFILES "
+        f"but body contains architectural keyword {matched_kw!r} AND a "
+        f"TDD-shaped skill was requested. This pattern matches ADR-0035 / "
+        f"t_e2ae0c29 (5h31m mis-scope loop). Hint only — re-evaluate "
+        f"assignee (architect / devops typically own this) or pass "
+        f"--force-scope to suppress."
+    )
+    warnings.warn(msg, stacklevel=2)
