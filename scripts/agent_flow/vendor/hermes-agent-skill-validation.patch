+def test_create_task_skill_validation_empty_profile(kanban_home, monkeypatch):
+    """Empty frozenset means 'profile exists but has no skills'.
+
+    A bare profile (e.g. created with `--no-skills`) has zero skills, so ANY
+    per-task skill is foreign and the worker would fail at spawn trying to
+    load it. Rejecting here with the readable error is strictly better than
+    the spawn-time crash it replaces.
+    """
+    monkeypatch.setattr(kb, "_profile_skill_names", lambda assignee: frozenset())
+    with kb.connect() as conn:
+        with pytest.raises(ValueError, match=r"'anything' skill not installed in profile 'bare'.*Installed skills: \(none\)"):
+            kb.create_task(
+                conn,
+                title="empty profile",
+                assignee="bare",
+                skills=["anything"],
+            )
