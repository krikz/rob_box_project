+def test_profile_skill_names_follows_symlinked_categories(kanban_home, monkeypatch):
+    """Skills under a symlinked category dir are part of the profile's set.
+
+    Regression for t_1ab37fa8 (retro: SOUL.md ↔ Hermes-profile drift). Hermes
+    ships the shared skill library at ``$HERMES_HOME/skills/<category>/<skill>``
+    and every profile's ``skills/<category>`` is a SYMLINK to it, so the
+    skill loader (which uses ``iter_skill_index_files`` with
+    ``followlinks=True``) sees those skills. The kanban validator used
+    ``Path.rglob`` which does NOT follow symlinks, so every skill under a
+    symlinked category (e.g. ``software-development``, ``research``,
+    ``productivity``) was reported as missing and any per-task
+    ``skills=[...]`` referencing it was rejected with
+    ``"<skill> not installed in profile"``. After the fix both real-file
+    skills and symlinked-category skills must be discoverable.
+    """
+    # Shared source-of-truth skill library.
+    shared = kanban_home / "skills"
+    (shared / "shared-cat" / "shared-skill").mkdir(parents=True)
+    (shared / "shared-cat" / "shared-skill" / "SKILL.md").write_text(
+        "---\nname: shared-skill\n---\n", encoding="utf-8"
+    )
+    # A skill that lives ONLY in the shared tree (under a symlinked
+    # category in the profile — the bug case).
+    (shared / "shared-cat" / "symlinked-skill").mkdir(parents=True)
+    (shared / "shared-cat" / "symlinked-skill" / "SKILL.md").write_text(
+        "---\nname: symlinked-skill\n---\n", encoding="utf-8"
+    )
+    # A skill that lives ONLY in the shared tree under a NON-symlinked
+    # category (control case — must still be discovered).
+    (shared / "other-cat" / "regular-skill").mkdir(parents=True)
+    (shared / "other-cat" / "regular-skill" / "SKILL.md").write_text(
+        "---\nname: regular-skill\n---\n", encoding="utf-8"
+    )
+
+    # Profile whose skills tree mixes real dirs and symlinked categories.
+    profile_dir = kanban_home / "profiles" / "symtest"
+    skills_dir = profile_dir / "skills"
+    (skills_dir / "real-cat" / "real-only-skill").mkdir(parents=True)
+    (skills_dir / "real-cat" / "real-only-skill" / "SKILL.md").write_text(
+        "---\nname: real-only-skill\n---\n", encoding="utf-8"
+    )
+    # Symlink the shared-cat into the profile tree — exactly how Hermes
+    # ships category dirs in production profiles.
+    os.symlink(shared / "shared-cat", skills_dir / "shared-cat")
+    # Copy a category the easy way (real dir with one skill already
+    # present in the shared tree).
+    (skills_dir / "other-cat").mkdir(parents=True)
+    (skills_dir / "other-cat" / "regular-skill").symlink_to(
+        shared / "other-cat" / "regular-skill"
+    )
+
+    monkeypatch.setattr(
+        "hermes_cli.profiles.profile_exists", lambda name: True
+    )
+    monkeypatch.setattr(
+        "hermes_cli.profiles.get_profile_dir", lambda name: profile_dir
+    )
+
+    found = kb._profile_skill_names("symtest")
+    # The bug: Path.rglob never descends into ``shared-cat`` because it's a
+    # symlink; ``shared-skill`` and ``symlinked-skill`` would be missing and
+    # any ``skills=[shared-skill]`` would be wrongly rejected.
+    assert "shared-skill" in found, (
+        "Skills under a symlinked category dir must be discovered "
+        "(regression t_1ab37fa8): " + repr(sorted(found))
+    )
+    assert "symlinked-skill" in found, (
+        "Skill added purely under a symlinked category must be discovered: "
+        + repr(sorted(found))
+    )
+    # Control: real-file skills still resolve.
+    assert "real-only-skill" in found
+    # Regular-skill is reachable both via the profile's own category AND the
+    # shared tree; either way it must show up exactly once in the set.
+    assert "regular-skill" in found
