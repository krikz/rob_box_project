+def test_decompose_is_idempotent_on_existing_children(kanban_home):
+    """Retro t_1d467636: re-decomposing a root that already has children must
+    NOT create a duplicate fan-out.
+
+    Models the real incident: after the first fan-out the root was moved back
+    to triage (requeue/unblock) and the decomposer ran again. The status gate
+    alone cannot protect against that — the child_ids check must."""
+    with kb.connect() as conn:
+        tid = kb.create_task(conn, title="ship a feature", triage=True)
+
+    # Give the root one child directly (as if it had been decomposed before).
+    with kb.connect() as conn:
+        child_ids = kb.decompose_triage_task(
+            conn,
+            tid,
+            root_assignee="orchestrator",
+            children=[{"title": "research", "body": "look it up", "assignee": "researcher", "parents": []}],
+            author="me",
+        )
+        assert child_ids and len(child_ids) == 1
+        first_children = set(child_ids)
+        # Move the root BACK to triage — this is what actually happened on
+        # 16.08: the same root was decomposed at 08:07Z and again at 09:10Z.
+        conn.execute("UPDATE tasks SET status='triage' WHERE id=?", (tid,))
+
+    llm_payload = jsonlib.dumps({
+        "fanout": True,
+        "rationale": "test split",
+        "tasks": [
+            {"title": "research", "body": "look it up", "assignee": "researcher", "parents": []},
+            {"title": "build", "body": "code it", "assignee": "engineer", "parents": [0]},
+        ],
+    })
+
+    patches = _patch_list_profiles(["orchestrator", "researcher", "engineer"])
+    for p in patches:
+        p.start()
+    try:
+        with _patch_aux_client(llm_payload), _patch_extra_body() as mock_llm:
+            outcome = decomp.decompose_task(tid, author="me")
+    finally:
+        for p in patches:
+            p.stop()
+
+    assert outcome.ok is False
+    assert "already decomposed" in outcome.reason
+
+    with kb.connect() as conn:
+        children = set(kb.parent_ids(conn, tid))
+    assert children == first_children
+
