+def test_decompose_defers_when_maintenance_probe_fires(kanban_home):
+    """Retro t_1d467636: active MAINTENANCE/peak => no children, log defer.
+
+    The probe is a shell command with exit 0 == MAINTENANCE active. When it
+    fires, decompose_task must NOT call the LLM and must NOT create children.
+    """
+    with kb.connect() as conn:
+        tid = kb.create_task(conn, title="ship a feature", triage=True)
+
+    patches = _patch_list_profiles(["orchestrator", "researcher", "engineer"])
+    for p in patches:
+        p.start()
+    try:
+        with patch(
+            "hermes_cli.kanban_decompose._load_config",
+            return_value={"kanban": {"maintenance_probe_command": "exit 0"}},
+        ), patch(
+            "agent.auxiliary_client.call_llm"
+        ) as mock_llm:
+            outcome = decomp.decompose_task(tid, author="me")
+    finally:
+        for p in patches:
+            p.stop()
+
+    assert outcome.ok is False
+    assert "defer decompose (MAINTENANCE)" in outcome.reason
+    mock_llm.assert_not_called()
+
+    with kb.connect() as conn:
+        root = kb.get_task(conn, tid)
+        children = kb.child_ids(conn, tid)
+    # Root stays in triage, no children created.
+    assert root is not None
+    assert root.status == "triage"
+    assert children == []
+
+
