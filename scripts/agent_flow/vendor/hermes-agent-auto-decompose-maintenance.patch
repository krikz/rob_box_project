+def _maintenance_probe_reason(cfg: dict) -> Optional[str]:
+    """Return a human-readable reason when the MAINTENANCE/peak probe fires.
+
+    The probe is a shell command configured via ``kanban.maintenance_probe_command``
+    (or the env var ``HERMES_KANBAN_MAINTENANCE_PROBE``). Exit code 0 means
+    MAINTENANCE is active and the decomposer must defer (no new cards created).
+
+    Returns ``None`` when no probe is configured or the probe itself fails
+    (fail-open — a broken probe must not halt decomposition; the merge-gate G1
+    gate behaves the same way). The command runs with a bounded timeout so a
+    hung git fetch can't stall the dispatcher tick.
+    """
+    kanban_cfg = cfg.get("kanban", {}) if isinstance(cfg, dict) else {}
+    cmd = (
+        kanban_cfg.get("maintenance_probe_command")
+        or os.environ.get("HERMES_KANBAN_MAINTENANCE_PROBE")
+        or ""
+    ).strip()
+    if not cmd:
+        return None
+    try:
+        proc = subprocess.run(
+            cmd,
+            shell=True,
+            capture_output=True,
+            text=True,
+            timeout=15,
+        )
+    except Exception as exc:
+        logger.warning(
+            "decompose: MAINTENANCE probe failed (%s) — proceeding fail-open", exc,
+        )
+        return None
+    if proc.returncode == 0:
+        return "MAINTENANCE/peak window active (probe exit 0)"
+    return None
+
