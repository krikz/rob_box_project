diff --git a/tests/hermes_cli/test_crp.py b/tests/hermes_cli/test_crp.py
new file mode 100644
index 000000000..7cb9760fb
--- /dev/null
+++ b/tests/hermes_cli/test_crp.py
@@ -0,0 +1,247 @@
+"""Tests for hermes_cli.crp — CRP (Consultation Request Pack) validator.
+
+SASE (arXiv 2509.06216) defines CRP as a 4-field decision-point artifact
+(options, recommendation, escalation_target, decision). We adopt the
+subset that fits our kanban, with strict validation: a worker that emits
+a CRP must enumerate at least one option, name a recommendation that
+matches an option, and name an escalation target. The legacy free-text
+``reason`` is preserved for blocks that don't carry a CRP.
+
+These tests pin the structural contract so a future refactor can't
+silently relax it back to "anything goes" (the exact drift the schema
+was added to fix — see add-research-2026-08-19.md §6.2).
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from hermes_cli.crp import (
+    CRPSchemaError,
+    deserialize_crp,
+    format_crp_for_humans,
+    serialize_crp,
+    validate_crp,
+)
+
+
+def _good_crp() -> dict:
+    return {
+        "options": [
+            {"name": "fix A", "tradeoffs": "simple, touches 1 file", "cost": "low"},
+            {"name": "fix B", "tradeoffs": "robust, touches 3 files", "cost": "medium"},
+        ],
+        "recommendation": "fix A",
+        "escalation_target": "user",
+    }
+
+
+# ------------------------------------------------------------------
+# validate_crp: happy path
+# ------------------------------------------------------------------
+
+
+def test_validate_crp_accepts_canonical_form() -> None:
+    crp = validate_crp(_good_crp())
+    assert crp["recommendation"] == "fix A"
+    assert crp["escalation_target"] == "user"
+    assert len(crp["options"]) == 2
+    # decision is optional and omitted when absent
+    assert "decision" not in crp
+
+
+def test_validate_crp_preserves_decision_when_set() -> None:
+    payload = _good_crp()
+    payload["decision"] = "ship fix A; we'll revisit fix B next sprint"
+    crp = validate_crp(payload)
+    assert crp["decision"].startswith("ship fix A")
+
+
+def test_validate_crp_strips_empty_optional_fields() -> None:
+    payload = {
+        "options": [{"name": "fix A"}],
+        "recommendation": "fix A",
+        "escalation_target": "user",
+    }
+    crp = validate_crp(payload)
+    # tradeoffs/cost not present in the source — should not appear as "" in the output
+    assert "tradeoffs" not in crp["options"][0]
+    assert "cost" not in crp["options"][0]
+
+
+# ------------------------------------------------------------------
+# validate_crp: structural errors
+# ------------------------------------------------------------------
+
+
+def test_validate_crp_rejects_none() -> None:
+    with pytest.raises(CRPSchemaError, match="crp is required"):
+        validate_crp(None)
+
+
+def test_validate_crp_rejects_non_dict() -> None:
+    with pytest.raises(CRPSchemaError, match="must be an object"):
+        validate_crp("just a string")
+
+
+def test_validate_crp_rejects_missing_options() -> None:
+    payload = {"recommendation": "x", "escalation_target": "user"}
+    with pytest.raises(CRPSchemaError, match="options must be a list"):
+        validate_crp(payload)
+
+
+def test_validate_crp_rejects_empty_options() -> None:
+    payload = {"options": [], "recommendation": "x", "escalation_target": "user"}
+    with pytest.raises(CRPSchemaError, match="at least 1 option"):
+        validate_crp(payload)
+
+
+def test_validate_crp_rejects_option_without_name() -> None:
+    payload = {
+        "options": [{"tradeoffs": "no name"}],
+        "recommendation": "no name",
+        "escalation_target": "user",
+    }
+    with pytest.raises(CRPSchemaError, match="options\\[0\\]\\.name"):
+        validate_crp(payload)
+
+
+def test_validate_crp_rejects_recommendation_not_in_options() -> None:
+    payload = {
+        "options": [{"name": "fix A"}],
+        "recommendation": "fix Z",
+        "escalation_target": "user",
+    }
+    with pytest.raises(CRPSchemaError, match="does not match any option"):
+        validate_crp(payload)
+
+
+def test_validate_crp_rejects_missing_escalation_target() -> None:
+    payload = {
+        "options": [{"name": "fix A"}],
+        "recommendation": "fix A",
+    }
+    with pytest.raises(CRPSchemaError, match="escalation_target"):
+        validate_crp(payload)
+
+
+def test_validate_crp_rejects_empty_escalation_target() -> None:
+    payload = {
+        "options": [{"name": "fix A"}],
+        "recommendation": "fix A",
+        "escalation_target": "   ",
+    }
+    with pytest.raises(CRPSchemaError, match="non-empty string"):
+        validate_crp(payload)
+
+
+def test_validate_crp_rejects_option_with_non_dict_entry() -> None:
+    payload = {
+        "options": ["not a dict"],
+        "recommendation": "not a dict",
+        "escalation_target": "user",
+    }
+    # The recommendation check happens first because the option shape
+    # error masks the name match. Either error is acceptable; the key
+    # contract is that the validator does not return silently.
+    with pytest.raises(CRPSchemaError):
+        validate_crp(payload)
+
+
+# ------------------------------------------------------------------
+# validate_crp: size caps (defensive against runaway agent output)
+# ------------------------------------------------------------------
+
+
+def test_validate_crp_caps_option_name_length() -> None:
+    payload = {
+        "options": [{"name": "x" * 200}],
+        "recommendation": "x" * 200,
+        "escalation_target": "user",
+    }
+    with pytest.raises(CRPSchemaError, match="options\\[0\\]\\.name too long"):
+        validate_crp(payload)
+
+
+def test_validate_crp_caps_tradeoffs_length() -> None:
+    payload = {
+        "options": [{"name": "fix A", "tradeoffs": "y" * 1000}],
+        "recommendation": "fix A",
+        "escalation_target": "user",
+    }
+    with pytest.raises(CRPSchemaError, match="tradeoffs too long"):
+        validate_crp(payload)
+
+
+# ------------------------------------------------------------------
+# serialize / deserialize round-trip
+# ------------------------------------------------------------------
+
+
+def test_serialize_then_deserialize_round_trip() -> None:
+    crp = validate_crp(_good_crp())
+    raw = serialize_crp(crp)
+    parsed = deserialize_crp(raw)
+    assert parsed == crp
+
+
+def test_serialize_rejects_oversized_payload() -> None:
+    crp = validate_crp(_good_crp())
+    crp["options"][0]["tradeoffs"] = "z" * 9000  # over the 8KB serialized cap
+    with pytest.raises(CRPSchemaError, match="serialized form"):
+        serialize_crp(crp)
+
+
+def test_deserialize_returns_none_for_empty_input() -> None:
+    assert deserialize_crp(None) is None
+    assert deserialize_crp("") is None
+    assert deserialize_crp("   ") is None
+
+
+def test_deserialize_rejects_corrupt_json() -> None:
+    with pytest.raises(CRPSchemaError, match="not valid JSON"):
+        deserialize_crp("{not json}")
+
+
+def test_deserialize_revalidates_to_block_silent_drift() -> None:
+    # A hand-edited DB row that dropped the recommendation field should
+    # NOT deserialize successfully — that would re-introduce the
+    # very drift the schema was added to fix.
+    raw = json.dumps({"options": [{"name": "fix A"}], "escalation_target": "user"})
+    with pytest.raises(CRPSchemaError, match="recommendation"):
+        deserialize_crp(raw)
+
+
+# ------------------------------------------------------------------
+# format_crp_for_humans
+# ------------------------------------------------------------------
+
+
+def test_format_crp_for_humans_includes_all_required_sections() -> None:
+    rendered = format_crp_for_humans(_good_crp())
+    assert "Consultation Request Pack" in rendered
+    assert "**fix A**" in rendered
+    assert "**fix B**" in rendered
+    assert "**Recommendation:** fix A" in rendered
+    assert "**Escalation target:** user" in rendered
+
+
+def test_format_crp_for_humans_skips_decision_when_unset() -> None:
+    rendered = format_crp_for_humans(_good_crp())
+    assert "Decision" not in rendered
+
+
+def test_format_crp_for_humans_renders_decision_when_set() -> None:
+    payload = _good_crp()
+    payload["decision"] = "approved"
+    rendered = format_crp_for_humans(payload)
+    assert "**Decision (from human):** approved" in rendered
+
+
+def test_format_crp_for_humans_annotates_cost() -> None:
+    rendered = format_crp_for_humans(_good_crp())
+    # cost was "low" for fix A, "medium" for fix B
+    assert "cost: low" in rendered
+    assert "cost: medium" in rendered
