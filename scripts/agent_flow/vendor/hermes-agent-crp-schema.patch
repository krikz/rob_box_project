index 000000000..9c377c42b
--- /dev/null
+++ b/hermes_cli/crp.py
@@ -0,0 +1,252 @@
+"""Consultation Request Pack (CRP) — SASE framework decision-point schema.
+
+A CRP is a structured handoff a worker emits to a human when it needs a
+decision it cannot make on its own. SASE (Structured Agentic Software
+Engineering, arXiv 2509.06216) names this as one of the five canonical
+human↔agent artifacts; we adopt a minimal subset that fits our kanban:
+
+    {
+      "options": [
+        {"name": "fix A", "tradeoffs": "...", "cost": "low"},
+        {"name": "fix B", "tradeoffs": "...", "cost": "high"}
+      ],
+      "recommendation": "fix A",
+      "escalation_target": "user | architect | devops | reviewer | ...",
+      "decision": null  # set by the human in response
+    }
+
+Two surfaces consume this module:
+
+* ``kanban_create(crp_schema=...)`` — attaches a CRP to a task body so a
+  downstream worker / reviewer sees the options up-front. Stored on the
+  task as JSON.
+* ``kanban_block(crp=...)`` — a worker emits a CRP as the formal reason
+  for blocking. The legacy free-text ``reason`` remains supported for
+  non-CRP blocks, but when ``crp`` is set it carries the structured
+  decision point and ``reason`` becomes a short headline.
+
+Validation is deliberately strict: an empty ``options`` list, a missing
+``recommendation``, or an absent ``escalation_target`` are errors, not
+warnings. The whole point of CRP is to force the worker to enumerate the
+options before asking a human to choose — silently accepting a single-
+option "CRP" re-introduces the free-text drift the schema was added to
+fix. (See add-research-2026-08-19.md §6.2, retromania t_bf689117,
+t_cca7c074.)
+"""
+
+from __future__ import annotations
+
+from typing import Any, Optional
+
+# Minimum number of options a CRP must enumerate. SASE doesn't pin a
+# number; we pick 1 as a sane lower bound — a CRP with zero options
+# is just a complaint, not a consultation. Two or three is typical.
+CRP_MIN_OPTIONS = 1
+
+# Cap on option names / tradeoffs / cost string length. Keeps a malformed
+# tool call from filling a kanban row with a megabyte of free text.
+CRP_MAX_OPTION_NAME = 120
+CRP_MAX_OPTION_TRADEOFFS = 800
+CRP_MAX_OPTION_COST = 60
+CRP_MAX_RECOMMENDATION = 400
+CRP_MAX_ESCALATION_TARGET = 80
+CRP_MAX_DECISION = 400
+# Total cap on the rendered CRP JSON (after validation). Kanban bodies
+# are already inlined into the agent's prompt, so a runaway CRP
+# balloons every downstream tool call.
+CRP_MAX_SERIALIZED_BYTES = 8 * 1024
+
+
+class CRPSchemaError(ValueError):
+    """Raised when a candidate CRP fails validation.
+
+    The error message is safe to surface to the worker / human — it
+    points at the offending field with a one-line hint.
+    """
+
+
+def _require_str(value: Any, field: str, *, max_len: int) -> str:
+    if not isinstance(value, str):
+        raise CRPSchemaError(
+            f"crp.{field} must be a string, got {type(value).__name__}"
+        )
+    stripped = value.strip()
+    if not stripped:
+        raise CRPSchemaError(f"crp.{field} must be a non-empty string")
+    if len(stripped) > max_len:
+        raise CRPSchemaError(
+            f"crp.{field} too long: {len(stripped)} chars > {max_len} max"
+        )
+    return stripped
+
+
+def _validate_option(opt: Any, idx: int) -> dict[str, str]:
+    if not isinstance(opt, dict):
+        raise CRPSchemaError(
+            f"crp.options[{idx}] must be an object, got {type(opt).__name__}"
+        )
+    name = _require_str(opt.get("name"), f"options[{idx}].name",
+                         max_len=CRP_MAX_OPTION_NAME)
+    tradeoffs_raw = opt.get("tradeoffs", "")
+    if tradeoffs_raw is None:
+        tradeoffs_raw = ""
+    if not isinstance(tradeoffs_raw, str):
+        raise CRPSchemaError(
+            f"crp.options[{idx}].tradeoffs must be a string when present"
+        )
+    tradeoffs = tradeoffs_raw.strip()
+    if len(tradeoffs) > CRP_MAX_OPTION_TRADEOFFS:
+        raise CRPSchemaError(
+            f"crp.options[{idx}].tradeoffs too long: "
+            f"{len(tradeoffs)} > {CRP_MAX_OPTION_TRADEOFFS} max"
+        )
+    cost_raw = opt.get("cost", "")
+    if cost_raw is None:
+        cost_raw = ""
+    if not isinstance(cost_raw, str):
+        raise CRPSchemaError(
+            f"crp.options[{idx}].cost must be a string when present"
+        )
+    cost = cost_raw.strip()
+    if len(cost) > CRP_MAX_OPTION_COST:
+        raise CRPSchemaError(
+            f"crp.options[{idx}].cost too long: "
+            f"{len(cost)} > {CRP_MAX_OPTION_COST} max"
+        )
+    out: dict[str, str] = {"name": name, "tradeoffs": tradeoffs, "cost": cost}
+    # Drop empty optionals so the stored JSON is tight.
+    return {k: v for k, v in out.items() if v}
+
+
+def validate_crp(value: Any) -> dict[str, Any]:
+    """Validate and normalise a CRP dict.
+
+    Returns a new dict with only the canonical fields populated (options,
+    recommendation, escalation_target, decision). Raises
+    :class:`CRPSchemaError` for any structural problem. The returned
+    dict is JSON-serialisable by construction.
+    """
+    if value is None:
+        raise CRPSchemaError("crp is required (use reason for free-text blocks)")
+    if not isinstance(value, dict):
+        raise CRPSchemaError(
+            f"crp must be an object with options/recommendation/"
+            f"escalation_target, got {type(value).__name__}"
+        )
+    options_raw = value.get("options")
+    if not isinstance(options_raw, list):
+        raise CRPSchemaError(
+            "crp.options must be a list of {name, tradeoffs?, cost?} objects"
+        )
+    if len(options_raw) < CRP_MIN_OPTIONS:
+        raise CRPSchemaError(
+            f"crp.options must enumerate at least {CRP_MIN_OPTIONS} option(s); "
+            f"got {len(options_raw)}"
+        )
+    options = [_validate_option(o, i) for i, o in enumerate(options_raw)]
+    # Every recommendation must match a known option name. SASE
+    # recommends a "named" recommendation so the human can refer to it
+    # ("fix A"). If we accept arbitrary free text here, the human-side
+    # renderer can't tell which option was picked.
+    recommendation = _require_str(
+        value.get("recommendation"), "recommendation",
+        max_len=CRP_MAX_RECOMMENDATION,
+    )
+    if not any(o["name"] == recommendation for o in options):
+        raise CRPSchemaError(
+            f"crp.recommendation={recommendation!r} does not match any "
+            f"option.name; must be one of "
+            f"{[o['name'] for o in options]}"
+        )
+    escalation_target = _require_str(
+        value.get("escalation_target"), "escalation_target",
+        max_len=CRP_MAX_ESCALATION_TARGET,
+    )
+    decision_raw = value.get("decision")
+    decision: Optional[str] = None
+    if decision_raw is not None:
+        decision = _require_str(
+            decision_raw, "decision", max_len=CRP_MAX_DECISION,
+        )
+    out: dict[str, Any] = {
+        "options": options,
+        "recommendation": recommendation,
+        "escalation_target": escalation_target,
+    }
+    if decision is not None:
+        out["decision"] = decision
+    return out
+
+
+def serialize_crp(crp: dict[str, Any]) -> str:
+    """JSON-encode a validated CRP, enforcing the size cap.
+
+    Raises :class:`CRPSchemaError` if the encoded form exceeds
+    :data:`CRP_MAX_SERIALIZED_BYTES`. Callers should treat that as a
+    content error, not a storage error — it means the worker tried to
+    stuff the CRP with prose that should live in the task body instead.
+    """
+    import json
+
+    encoded = json.dumps(crp, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+    if len(encoded.encode("utf-8")) > CRP_MAX_SERIALIZED_BYTES:
+        raise CRPSchemaError(
+            f"crp serialized form is {len(encoded)} bytes; "
+            f"max {CRP_MAX_SERIALIZED_BYTES}. Trim option tradeoffs."
+        )
+    return encoded
+
+
+def deserialize_crp(raw: Optional[str]) -> Optional[dict[str, Any]]:
+    """Parse a stored CRP JSON string back into a dict.
+
+    Returns ``None`` for ``None``/empty input. Raises
+    :class:`CRPSchemaError` if the stored string is malformed or fails
+    re-validation — stored data should already be valid, so a parse
+    failure is a corruption signal worth surfacing rather than
+    silently dropping.
+    """
+    if raw is None or not str(raw).strip():
+        return None
+    import json
+
+    try:
+        parsed = json.loads(raw)
+    except json.JSONDecodeError as e:
+        raise CRPSchemaError(f"crp stored value is not valid JSON: {e}") from e
+    # Re-run validation so a hand-edited DB row that lost a required
+    # field still surfaces as a hard error instead of crashing the
+    # renderer.
+    return validate_crp(parsed)
+
+
+def format_crp_for_humans(crp: dict[str, Any]) -> str:
+    """Render a validated CRP as a markdown decision block.
+
+    Used by the task renderer so a human opening the card sees the
+    options, the worker's recommendation, and the escalation target
+    up-front instead of having to scroll through a raw JSON dump.
+    """
+    lines = ["## Consultation Request Pack (CRP)"]
+    lines.append("")
+    lines.append("**Options:**")
+    for i, opt in enumerate(crp.get("options", []), 1):
+        label = opt.get("name", f"option-{i}")
+        cost = opt.get("cost", "")
+        tradeoffs = opt.get("tradeoffs", "")
+        suffix = f" _(cost: {cost})_" if cost else ""
+        lines.append(f"{i}. **{label}**{suffix}")
+        if tradeoffs:
+            lines.append(f"   - {tradeoffs}")
+    lines.append("")
+    rec = crp.get("recommendation", "")
+    if rec:
+        lines.append(f"**Recommendation:** {rec}")
+    target = crp.get("escalation_target", "")
+    if target:
+        lines.append(f"**Escalation target:** {target}")
+    decision = crp.get("decision")
+    if decision:
+        lines.append(f"**Decision (from human):** {decision}")
+    lines.append("")
+    return "\n".join(lines)
