+++ b/tests/hermes_cli/test_crp_integration.py
@@ -0,0 +1,238 @@
+"""Tests for CRP integration into create_task / block_task.
+
+The pure schema validation lives in :mod:`tests.hermes_cli.test_crp`; this
+file pins the *wiring*: that ``create_task`` actually writes a
+``crp_schema`` column from a dict or JSON string, that ``block_task``
+actually writes ``crp_block`` on every block path (dependency / loop /
+regular), and that the human-readable rendering composes with the task
+body in the way the agent-flow harness expects.
+
+Sourced from retromania t_bf689117 (free-text drift re-introduced when
+workers learned to skip the structured surface).
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from hermes_cli import kanban_db as kb
+
+
+@pytest.fixture
+def kanban_home(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    kb.init_db()
+    return home
+
+
+def _good_crp() -> dict:
+    return {
+        "options": [
+            {"name": "fix A", "tradeoffs": "touches 1 file", "cost": "low"},
+            {"name": "fix B", "tradeoffs": "touches 3 files", "cost": "high"},
+        ],
+        "recommendation": "fix A",
+        "escalation_target": "user",
+    }
+
+
+def _running_task(conn, title="t", assignee="worker"):
+    tid = kb.create_task(conn, title=title, assignee=assignee)
+    with kb.write_txn(conn):
+        conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (tid,))
+    kb.claim_task(conn, tid, claimer=assignee)
+    return tid
+
+
+# ------------------------------------------------------------------
+# create_task: crp_schema wiring
+# ------------------------------------------------------------------
+
+
+def test_create_task_persists_crp_schema_from_dict(kanban_home: Path) -> None:
+    with kb.connect_closing() as conn:
+        tid = kb.create_task(
+            conn, title="fix", assignee="worker", crp_schema=_good_crp(),
+        )
+        row = conn.execute(
+            "SELECT crp_schema FROM tasks WHERE id=?", (tid,)
+        ).fetchone()
+        stored = json.loads(row["crp_schema"])
+        assert stored["recommendation"] == "fix A"
+        assert stored["escalation_target"] == "user"
+        # Round-trip through Task dataclass too — the renderer path
+        # reads via Task.crp_schema, not via raw SQL.
+        task = kb.get_task(conn, tid)
+        assert task is not None
+        parsed = json.loads(task.crp_schema or "{}")
+        assert parsed["recommendation"] == "fix A"
+
+
+def test_create_task_accepts_crp_schema_as_json_string(kanban_home: Path) -> None:
+    crp_json = json.dumps(_good_crp())
+    with kb.connect_closing() as conn:
+        tid = kb.create_task(
+            conn, title="fix", assignee="worker", crp_schema=crp_json,
+        )
+        task = kb.get_task(conn, tid)
+        assert task is not None and task.crp_schema
+        assert json.loads(task.crp_schema)["recommendation"] == "fix A"
+
+
+def test_create_task_rejects_invalid_crp(kanban_home: Path) -> None:
+    # Empty options list — the schema-level guard for "CRP is not a
+    # complaint" must propagate up here, not be silently coerced to NULL.
+    bad = {"options": [], "recommendation": "x", "escalation_target": "u"}
+    with kb.connect_closing() as conn:
+        with pytest.raises(ValueError, match="crp_schema"):
+            kb.create_task(
+                conn, title="fix", assignee="worker", crp_schema=bad,
+            )
+
+
+def test_create_task_rejects_malformed_json_string(kanban_home: Path) -> None:
+    with kb.connect_closing() as conn:
+        with pytest.raises(ValueError, match="crp_schema is not valid JSON"):
+            kb.create_task(
+                conn, title="fix", assignee="worker", crp_schema="{not json}",
+            )
+
+
+def test_create_task_without_crp_leaves_column_null(kanban_home: Path) -> None:
+    with kb.connect_closing() as conn:
+        tid = kb.create_task(conn, title="plain", assignee="worker")
+        task = kb.get_task(conn, tid)
+        assert task is not None
+        assert task.crp_schema is None
+        assert task.crp_block is None
+
+
+def test_create_task_rejects_unsupported_crp_type(kanban_home: Path) -> None:
+    with kb.connect_closing() as conn:
+        with pytest.raises(ValueError, match="crp_schema must be a string or dict"):
+            kb.create_task(
+                conn, title="fix", assignee="worker", crp_schema=42,
+            )
+
+
+# ------------------------------------------------------------------
+# block_task: crp wiring
+# ------------------------------------------------------------------
+
+
+def test_block_task_persists_crp_on_regular_block(kanban_home: Path) -> None:
+    with kb.connect_closing() as conn:
+        tid = _running_task(conn)
+        kb.block_task(
+            conn, tid, reason="needs human",
+            kind="needs_input", crp=_good_crp(),
+        )
+        task = kb.get_task(conn, tid)
+        assert task is not None
+        assert task.status == "blocked"
+        assert task.crp_block is not None
+        stored = json.loads(task.crp_block)
+        assert stored["recommendation"] == "fix A"
+
+
+def test_block_task_persists_crp_on_dependency_block(kanban_home: Path) -> None:
+    with kb.connect_closing() as conn:
+        tid = _running_task(conn)
+        kb.block_task(
+            conn, tid, reason="waiting on parent",
+            kind="dependency", crp=_good_crp(),
+        )
+        task = kb.get_task(conn, tid)
+        assert task is not None
+        # dependency routes to 'todo', not 'blocked' — crp_block must
+        # still be written, otherwise the human reading the queued task
+        # sees no structured options.
+        assert task.status == "todo"
+        assert task.crp_block is not None
+        assert json.loads(task.crp_block)["escalation_target"] == "user"
+
+
+def test_block_task_persists_crp_when_loop_escalates_to_triage(
+    kanban_home: Path,
+) -> None:
+    """BLOCK_RECURRENCE_LIMIT=2: first block + unblock + re-block trips."""
+    with kb.connect_closing() as conn:
+        tid = _running_task(conn)
+        kb.block_task(conn, tid, reason="x", kind="capability",
+                      crp=_good_crp())
+        kb.unblock_task(conn, tid)
+        # Re-claim so block_task can act on the running task again.
+        with kb.write_txn(conn):
+            conn.execute("UPDATE tasks SET status='ready' WHERE id=?", (tid,))
+        kb.claim_task(conn, tid, claimer="worker")
+        kb.block_task(conn, tid, reason="x", kind="capability",
+                      crp=_good_crp())
+        task = kb.get_task(conn, tid)
+        assert task is not None
+        assert task.status == "triage"
+        assert task.crp_block is not None
+
+
+def test_block_task_rejects_invalid_crp(kanban_home: Path) -> None:
+    with kb.connect_closing() as conn:
+        tid = _running_task(conn)
+        bad = {"options": [{"name": "x"}]}  # no recommendation
+        with pytest.raises(ValueError, match="crp:"):
+            kb.block_task(
+                conn, tid, reason="x", kind="needs_input", crp=bad,
+            )
+        # The task must still be running — failed validation must not
+        # consume the block.
+        task = kb.get_task(conn, tid)
+        assert task is not None
+        assert task.status == "running"
+        assert task.crp_block is None
+
+
+def test_block_task_without_crp_still_works(kanban_home: Path) -> None:
+    """Legacy free-text blocks keep working — additive change only."""
+    with kb.connect_closing() as conn:
+        tid = _running_task(conn)
+        kb.block_task(conn, tid, reason="plain", kind="needs_input")
+        task = kb.get_task(conn, tid)
+        assert task is not None
+        assert task.status == "blocked"
+        assert task.crp_block is None
+
+
+# ------------------------------------------------------------------
+# Migration: legacy rows survive
+# ------------------------------------------------------------------
+
+
+def test_legacy_row_without_crp_columns_deserializes(kanban_home: Path) -> None:
+    """A row created before the migration (no crp_schema, no crp_block)
+    must still deserialise cleanly. from_row() is defensive — old rows
+    have no such column."""
+    with kb.connect_closing() as conn:
+        tid = kb.create_task(conn, title="legacy", assignee="worker")
+        # Synthesise a pre-migration row by dropping the columns and
+        # re-inserting the same id. Not a real back-compat exercise but
+        # exercises the row-key path that a missing column would hit.
+        with kb.write_txn(conn):
+            row = conn.execute(
+                "SELECT * FROM tasks WHERE id=?", (tid,)
+            ).fetchone()
+            keys = tuple(row.keys())
+            values = tuple(row[k] for k in keys)
+            conn.execute("DELETE FROM tasks WHERE id=?", (tid,))
+            placeholders = ",".join("?" for _ in keys)
+            conn.execute(
+                f"INSERT INTO tasks ({','.join(keys)}) VALUES ({placeholders})",
+                values,
+            )
+        task = kb.get_task(conn, tid)
+        assert task is not None
+        assert task.crp_schema is None
+        assert task.crp_block is None
