+# ---------------------------------------------------------------------------
+# Cost attribution (#1462 — P10)
+#
+# Each kanban run's worker session accumulates LLM API costs in two
+# databases that live on the same SQLite connection family:
+#
+#   - ``hermes_state.db`` (sessions / session_model_usage) — every API call
+#     recorded by the worker lands here, with ``sessions.id`` linking to
+#     the worker session and ``session_model_usage.estimated_cost_usd``
+#     holding the priced delta. The worker session id is stamped onto the
+#     task_runs row's ``metadata`` field by
+#     ``tools/kanban_tools.py::_stamp_worker_session_metadata`` when the
+#     worker calls ``kanban_complete`` / ``kanban_block``.
+#
+# The cost we attribute to a kanban run is the SUM of estimated_cost_usd
+# over that worker's session id (one row in ``sessions``, possibly many
+# rows in ``session_model_usage`` per (model, billing_provider, task)
+# bucket). We convert dollars to cents and round to whole cents; the
+# dashboard layer formats to 2-decimal display.
+#
+# The two helper functions below own the SQL: ``_compute_run_cost_cents``
+# is the read-side query (called from ``_end_run`` and the heartbeat
+# tick), and ``_record_cost_attribution_event`` is the write-side that
+# emits a ``cost_attribution`` event row alongside the terminal event.
+# ---------------------------------------------------------------------------
+
+
+def _compute_run_cost_cents(
+    conn: sqlite3.Connection,
+    *,
+    worker_session_id: Optional[str],
+    run_id: Optional[int] = None,
+) -> Optional[float]:
+    """Return the dollar total of this run's LLM costs, in whole-cent cents.
+
+    Resolution order (first hit wins):
+
+    1. ``worker_session_id`` (the worker's hermes session id, stamped by
+       ``_stamp_worker_session_metadata`` when the worker called
+       ``kanban_complete`` / ``kanban_block``). SUMs
+       ``session_model_usage.estimated_cost_usd`` for that session id.
+       Auxiliary calls recorded with a non-empty ``task`` (vision /
+       compression / title_generation / ...) are included — they were
+       paid for by this worker run.
+    2. Fallback: ``run_id`` from ``task_runs.metadata``'s
+       ``worker_session_id`` (legacy path for callers that still pass
+       metadata but no explicit ``worker_session_id``). Same query, same
+       session_id.
+
+    Returns ``None`` when no worker session id is resolvable (e.g. the
+    task was completed by a CLI user without ever spawning a worker, or
+    before the cost-tracking instrumentation landed). The caller writes
+    a ``cost_attribution`` event with ``cost_in_cents=None`` in that
+    case — that's distinguishable from "cost was $0.00" because the SQL
+    layer only returns ``None`` when there was no session at all.
+    """
+    if not worker_session_id:
+        return None
+    try:
+        row = conn.execute(
+            "SELECT COALESCE(SUM(estimated_cost_usd), 0.0) AS usd "
+            "FROM session_model_usage WHERE session_id = ?",
+            (worker_session_id,),
+        ).fetchone()
+    except sqlite3.OperationalError as exc:
+        # session_model_usage lives in hermes_state.db; kanban's DB
+        # connection may not have that table attached. Surface as None
+        # rather than crashing the completion txn.
+        _log.debug("cost attribution skipped: %s", exc)
+        return None
+    usd = float(row["usd"] or 0.0)
+    # Round to integer-cent so the dashboard's $X.YZ formatting stays
+    # stable across sums (no float-drift artefacts).
+    return round(usd * 100.0, 2)
+
+
+def _resolve_worker_session_id(
+    metadata: Optional[Mapping[str, Any]],
+) -> Optional[str]:
+    """Pull ``worker_session_id`` out of a task_runs metadata dict.
+
+    Centralised so the cost-attribution helper, the dashboard backend,
+    and the CLI ``cost`` subcommand all agree on the lookup key.
+    """
+    if not metadata:
+        return None
+    sid = metadata.get("worker_session_id")
+    if isinstance(sid, str) and sid:
+        return sid
+    return None
+
+
+def _record_cost_attribution_event(
+    conn: sqlite3.Connection,
+    *,
+    task_id: str,
+    run_id: Optional[int],
+    cost_in_cents: Optional[float],
+    source: str,
+) -> None:
+    """Emit a ``cost_attribution`` event for the just-completed run.
+
+    ``source`` is one of ``"end_run"`` (terminal transition) or
+    ``"heartbeat"`` (mid-run tick) — surfaced in the payload so the
+    dashboard can render "live tick" vs "final" distinctly.
+    """
+    _append_event(
+        conn,
+        task_id,
+        "cost_attribution",
+        {
+            "source": source,
+            "cost_in_cents": cost_in_cents,
+            "cost_usd": (cost_in_cents / 100.0) if cost_in_cents is not None else None,
+        },
+        run_id=run_id,
+        cost_in_cents=cost_in_cents,
+    )
+
+
