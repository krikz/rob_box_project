+    board = _resolve_board(board)
+    conn = _conn(board=board)
+    try:
+        return kanban_db.cost_summary(
+            conn,
+            task_id=task_id,
+            since=since,
+            until=until,
+            assignee=assignee,
+            board=board,
+            group_by=group_by,
+        )
+    finally:
+        conn.close()
+
