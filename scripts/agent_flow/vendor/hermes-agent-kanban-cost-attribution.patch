+    unbounded. ``task_id`` scopes to one task; ``assignee`` filters by
+    the ``tasks.assignee`` column (the profile that ran the worker).
+    ``board`` is informational only — kanban_db doesn't tag events by
+    board, so this is mostly a hint that gets surfaced in the response.
+
+    The query selects the *terminal* cost_attribution event per run
+    (kind='cost_attribution' AND payload.source='end_run', picked as the
+    max id per task+run group) so heartbeat ticks don't inflate the
+    sum. ``cost_in_cents`` carries the cents value at write time, so the
+    SUM is the dollar total in cents; ``cost_usd`` is a convenience
+    echo for non-SQL consumers.
+    """
+    where: list[str] = ["e.kind = 'cost_attribution'", "e.cost_in_cents IS NOT NULL"]
+    params: list[Any] = []
+    if task_id is not None:
+        where.append("e.task_id = ?")
+        params.append(task_id)
+    if since is not None:
+        where.append("COALESCE(r.ended_at, e.created_at) >= ?")
+        params.append(int(since))
+    if until is not None:
+        where.append("COALESCE(r.ended_at, e.created_at) < ?")
+        params.append(int(until))
+    if assignee is not None:
+        where.append("t.assignee = ?")
+        params.append(assignee)
+    base_where = " AND ".join(where)
+
+    # Subquery ``final_per_run`` only consumes since/until — those are
+    # the time bounds on the inner ``SELECT MAX(e.id)``. task_id and
+    # assignee are applied in the outer WHERE (via ``base_where``),
+    # so they must NOT appear as bind params for the subquery. The
+    # previous ``params + params`` passed every param twice, which
+    # raised ``Incorrect number of bindings supplied`` whenever
+    # ``final_per_run`` had a different ``?`` count than ``base_where``.
+    final_per_run_params: list[Any] = []
+    final_per_run = (
+        "SELECT e.task_id, e.run_id, MAX(e.id) AS max_id "
+        "FROM task_events e "
+        "LEFT JOIN task_runs r ON r.id = e.run_id "
+        "WHERE e.kind = 'cost_attribution' AND e.cost_in_cents IS NOT NULL "
+    )
+    if since is not None:
+        final_per_run += " AND COALESCE(r.ended_at, e.created_at) >= ? "
+        final_per_run_params.append(int(since))
+    if until is not None:
+        final_per_run += " AND COALESCE(r.ended_at, e.created_at) < ? "
+        final_per_run_params.append(int(until))
+    final_per_run += " GROUP BY e.task_id, e.run_id "
+
+    # Reusable join clause so every GROUP BY can bucket by the run's
+    # settled ended_at instead of the (now-arbitrary) event timestamp.
+    run_join = "LEFT JOIN task_runs r ON r.id = e.run_id"
+
+    buckets: list[dict[str, Any]] = []
+    total_cents = 0.0
+    total_runs = 0
+    total_tasks: set[str] = set()
+    try:
+        if group_by == "task":
+            for row in conn.execute(
+                f"""
+                SELECT t.id AS task_id, t.title AS title, t.assignee AS assignee,
+                       COALESCE(SUM(e.cost_in_cents), 0.0) AS cents,
+                       COUNT(*) AS n_runs,
+                       MAX(COALESCE(r.ended_at, e.created_at)) AS last_attributed_at
+                FROM task_events e
+                JOIN tasks t ON t.id = e.task_id
+                {run_join}
+                JOIN ({final_per_run}) latest
+                  ON latest.max_id = e.id
+                WHERE {base_where}
+                GROUP BY t.id, t.title, t.assignee
+                ORDER BY cents DESC
+                """,
+                final_per_run_params + params,
+            ):
+                cents = round(float(row["cents"] or 0.0), 2)
+                buckets.append({
+                    "task_id": row["task_id"],
+                    "title": row["title"],
+                    "assignee": row["assignee"],
+                    "cost_in_cents": cents,
+                    "cost_usd": round(cents / 100.0, 4),
+                    "n_runs": int(row["n_runs"] or 0),
+                    "last_attributed_at": int(row["last_attributed_at"] or 0),
+                })
+                total_cents += cents
+                total_runs += int(row["n_runs"] or 0)
+                total_tasks.add(row["task_id"])
+        elif group_by == "day":
+            for row in conn.execute(
+                f"""
+                SELECT strftime('%Y-%m-%d', COALESCE(r.ended_at, e.created_at), 'unixepoch') AS day,
+                       COALESCE(SUM(e.cost_in_cents), 0.0) AS cents,
+                       COUNT(*) AS n_runs
+                FROM task_events e
+                JOIN tasks t ON t.id = e.task_id
+                {run_join}
+                JOIN ({final_per_run}) latest
+                  ON latest.max_id = e.id
+                WHERE {base_where}
+                GROUP BY day
+                ORDER BY day ASC
+                """,
+                final_per_run_params + params,
+            ):
+                cents = round(float(row["cents"] or 0.0), 2)
+                buckets.append({
+                    "day": row["day"],
+                    "cost_in_cents": cents,
+                    "cost_usd": round(cents / 100.0, 4),
+                    "n_runs": int(row["n_runs"] or 0),
+                })
+                total_cents += cents
+                total_runs += int(row["n_runs"] or 0)
+        elif group_by == "assignee":
+            for row in conn.execute(
+                f"""
+                SELECT t.assignee AS assignee,
+                       COALESCE(SUM(e.cost_in_cents), 0.0) AS cents,
+                       COUNT(*) AS n_runs,
+                       COUNT(DISTINCT t.id) AS n_tasks
+                FROM task_events e
+                JOIN tasks t ON t.id = e.task_id
+                {run_join}
+                JOIN ({final_per_run}) latest
+                  ON latest.max_id = e.id
+                WHERE {base_where}
+                GROUP BY t.assignee
+                ORDER BY cents DESC
+                """,
+                final_per_run_params + params,
+            ):
+                cents = round(float(row["cents"] or 0.0), 2)
+                buckets.append({
+                    "assignee": row["assignee"],
+                    "cost_in_cents": cents,
+                    "cost_usd": round(cents / 100.0, 4),
+                    "n_runs": int(row["n_runs"] or 0),
+                    "n_tasks": int(row["n_tasks"] or 0),
+                })
+                total_cents += cents
+                total_runs += int(row["n_runs"] or 0)
+        else:  # 'total'
+            row = conn.execute(
+                f"""
+                SELECT COALESCE(SUM(e.cost_in_cents), 0.0) AS cents,
+                       COUNT(*) AS n_runs,
+                       COUNT(DISTINCT e.task_id) AS n_tasks
+                FROM task_events e
+                JOIN tasks t ON t.id = e.task_id
+                {run_join}
+                JOIN ({final_per_run}) latest
+                  ON latest.max_id = e.id
+                WHERE {base_where}
+                """,
+                final_per_run_params + params,
+            ).fetchone()
+            total_cents = round(float(row["cents"] or 0.0), 2)
+            total_runs = int(row["n_runs"] or 0)
+            n_tasks = int(row["n_tasks"] or 0)
+            buckets.append({
+                "cost_in_cents": total_cents,
+                "cost_usd": round(total_cents / 100.0, 4),
+                "n_runs": total_runs,
+                "n_tasks": n_tasks,
+            })
+    except sqlite3.OperationalError:
+        # Column missing on a pre-migration DB — return an empty result
+        # rather than crashing the dashboard.
+        return {"buckets": [], "total_cents": 0.0, "total_usd": 0.0,
+                "total_runs": 0, "total_tasks": 0, "group_by": group_by,
+                "filters": {"task_id": task_id, "since": since,
+                            "until": until, "assignee": assignee,
+                            "board": board}}
+
+    return {
+        "buckets": buckets,
+        "total_cents": round(total_cents, 2),
+        "total_usd": round(total_cents / 100.0, 4),
+        "total_runs": total_runs,
+        "total_tasks": len(total_tasks) if group_by != "task" else len(buckets),
+        "group_by": group_by,
+        "filters": {"task_id": task_id, "since": since,
+                    "until": until, "assignee": assignee,
+                    "board": board},
+    }
+
+
