diff --git a/tests/hermes_cli/test_kanban_cost_attribution.py b/tests/hermes_cli/test_kanban_cost_attribution.py
new file mode 100644
index 000000000..746fc9ec3
--- /dev/null
+++ b/tests/hermes_cli/test_kanban_cost_attribution.py
@@ -0,0 +1,341 @@
+"""Cost-attribution column + rollup helpers (issue #1462, P10 gap).
+
+Coverage:
+
+* ``task_events.cost_in_cents`` is created by the additive migration and
+  remains ``NULL`` by default — the schema passes through existing rows
+  without rewriting them.
+* ``_end_run`` writes a ``cost_attribution`` event whose
+  ``cost_in_cents`` is sourced from ``session_model_usage`` for the
+  worker session id stored in ``task_runs.metadata``.
+* ``cost_summary`` rolls up the right slice (per-task / per-day /
+  per-assignee / total) and skips heartbeat ticks so the live tick
+  doesn't get summed on top of the terminal ``end_run`` event.
+* ``board_stats`` returns a ``cost_by_assignee`` slice even when there
+  are no cost events yet.
+"""
+
+from __future__ import annotations
+
+import json
+import sqlite3
+from pathlib import Path
+
+from hermes_cli import kanban_db as kb
+
+
+def _setup_home(tmp_path, monkeypatch) -> Path:
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    db_path = kb.kanban_db_path(board="default")
+    db_path.parent.mkdir(parents=True, exist_ok=True)
+    kb._INITIALIZED_PATHS.discard(str(db_path.resolve()))
+    return db_path
+
+
+def _attach_session_model_usage(conn: sqlite3.Connection) -> None:
+    """Attach a ``session_model_usage`` table to the kanban DB connection.
+
+    The cost-attribution helper queries this table; on a fresh kanban DB
+    the table doesn't exist because it lives in hermes_state.db. Tests
+    create it here so the read-side SQL has something to scan.
+    """
+    conn.executescript(
+        """
+        CREATE TABLE session_model_usage (
+            session_id TEXT NOT NULL,
+            model TEXT NOT NULL,
+            billing_provider TEXT NOT NULL DEFAULT '',
+            billing_base_url TEXT NOT NULL DEFAULT '',
+            billing_mode TEXT NOT NULL DEFAULT '',
+            task TEXT NOT NULL DEFAULT '',
+            api_call_count INTEGER NOT NULL DEFAULT 0,
+            input_tokens INTEGER NOT NULL DEFAULT 0,
+            output_tokens INTEGER NOT NULL DEFAULT 0,
+            cache_read_tokens INTEGER NOT NULL DEFAULT 0,
+            cache_write_tokens INTEGER NOT NULL DEFAULT 0,
+            reasoning_tokens INTEGER NOT NULL DEFAULT 0,
+            estimated_cost_usd REAL NOT NULL DEFAULT 0,
+            actual_cost_usd REAL NOT NULL DEFAULT 0,
+            cost_status TEXT,
+            cost_source TEXT,
+            first_seen REAL,
+            last_seen REAL
+        )
+        """
+    )
+
+
+def _create_running_task(conn, task_id: str = "t-cost-1") -> int:
+    """Create a task in 'running' state with a current_run_id.
+
+    Mimics what ``claim_task`` would do at the SQL level — the kanban
+    helper functions under test rely on ``current_run_id`` being
+    non-null so ``_end_run`` actually emits an event.
+    """
+    now = 1700000000
+    conn.execute(
+        "INSERT INTO tasks (id, title, status, current_run_id, "
+        "                    assignee, created_at, started_at) "
+        "VALUES (?, 'cost test', 'running', NULL, 'devops', ?, ?)",
+        (task_id, now, now),
+    )
+    cur = conn.execute(
+        "INSERT INTO task_runs (task_id, profile, status, started_at) "
+        "VALUES (?, 'devops', 'running', ?) RETURNING id",
+        (task_id, now),
+    )
+    run_id = int(cur.fetchone()[0])
+    conn.execute(
+        "UPDATE tasks SET current_run_id = ? WHERE id = ?",
+        (run_id, task_id),
+    )
+    conn.commit()
+    return run_id
+
+
+def test_cost_in_cents_column_added_by_migration(tmp_path, monkeypatch):
+    """``task_events.cost_in_cents`` exists post-init and is nullable."""
+    db_path = _setup_home(tmp_path, monkeypatch)
+    with kb.connect(db_path) as conn:
+        cols = {
+            r["name"]: r
+            for r in conn.execute("PRAGMA table_info(task_events)")
+        }
+        assert "cost_in_cents" in cols
+        # SQLite stores REAL with notnull=0 for our additive column.
+        assert cols["cost_in_cents"]["notnull"] == 0
+        assert "REAL" in cols["cost_in_cents"]["type"].upper()
+
+
+def test_cost_in_cents_index_present(tmp_path, monkeypatch):
+    """Partial index over non-null cost rows is created for rollups."""
+    db_path = _setup_home(tmp_path, monkeypatch)
+    with kb.connect(db_path) as conn:
+        idx = {
+            r["name"]
+            for r in conn.execute("SELECT name FROM sqlite_master WHERE type='index'")
+        }
+        assert "idx_events_cost" in idx
+
+
+def test_end_run_emits_cost_attribution_event(tmp_path, monkeypatch):
+    """``_end_run`` writes a ``cost_attribution`` event with the right cents."""
+    db_path = _setup_home(tmp_path, monkeypatch)
+    with kb.connect(db_path) as conn:
+        _attach_session_model_usage(conn)
+        run_id = _create_running_task(conn)
+        # Simulate the worker session recording 5 USD = 500 cents.
+        conn.execute(
+            "INSERT INTO session_model_usage "
+            "(session_id, model, estimated_cost_usd) VALUES (?, 'm', ?)",
+            ("sess-xyz", 5.0),
+        )
+        # Stamp metadata like _stamp_worker_session_metadata does.
+        metadata = {"worker_session_id": "sess-xyz"}
+        run_id = kb._end_run(
+            conn, "t-cost-1",
+            outcome="completed",
+            metadata=metadata,
+        )
+        assert run_id is not None
+        evs = conn.execute(
+            "SELECT kind, payload, cost_in_cents FROM task_events "
+            "WHERE task_id = 't-cost-1' ORDER BY id"
+        ).fetchall()
+    cost_evs = [e for e in evs if e["kind"] == "cost_attribution"]
+    assert len(cost_evs) == 1, cost_evs
+    ev = cost_evs[0]
+    assert ev["cost_in_cents"] == 500.0  # 5 USD * 100 = 500 cents
+    payload = json.loads(ev["payload"])
+    assert payload["source"] == "end_run"
+    assert payload["cost_usd"] == 5.0
+
+
+def test_end_run_no_session_id_writes_none_cost(tmp_path, monkeypatch):
+    """A run closed without a worker session id still emits the event."""
+    db_path = _setup_home(tmp_path, monkeypatch)
+    with kb.connect(db_path) as conn:
+        _attach_session_model_usage(conn)
+        _create_running_task(conn, "t-cost-2")
+        kb._end_run(
+            conn, "t-cost-2",
+            outcome="completed",
+            metadata=None,
+        )
+        evs = conn.execute(
+            "SELECT cost_in_cents FROM task_events "
+            "WHERE task_id='t-cost-2' AND kind='cost_attribution'"
+        ).fetchall()
+    assert len(evs) == 1
+    # Without a session id we can't attribute the cost — that's a
+    # distinct state from "$0.00", so cost_in_cents stays NULL.
+    assert evs[0]["cost_in_cents"] is None
+
+
+def test_cost_summary_per_task_rollup(tmp_path, monkeypatch):
+    """``cost_summary(group_by='task')`` sums per-issue, sorted desc."""
+    db_path = _setup_home(tmp_path, monkeypatch)
+    with kb.connect(db_path) as conn:
+        _attach_session_model_usage(conn)
+        for tid, usd in [
+            ("t-big", 50.0),
+            ("t-small", 5.0),
+            ("t-mid", 20.0),
+        ]:
+            _create_running_task(conn, tid)
+            sess = f"sess-{tid}"
+            conn.execute(
+                "INSERT INTO session_model_usage "
+                "(session_id, model, estimated_cost_usd) VALUES (?, 'm', ?)",
+                (sess, usd),
+            )
+            kb._end_run(
+                conn, tid,
+                outcome="completed",
+                metadata={"worker_session_id": sess},
+            )
+        summary = kb.cost_summary(conn, group_by="task")
+    assert summary["total_cents"] == 7500.0  # 75 USD
+    task_ids = [b["task_id"] for b in summary["buckets"]]
+    # Sorted by cents DESC.
+    assert task_ids[0] == "t-big"
+    assert task_ids[-1] == "t-small"
+
+
+def test_cost_summary_per_day_rollup(tmp_path, monkeypatch):
+    """Per-day grouping uses UTC calendar days."""
+    db_path = _setup_home(tmp_path, monkeypatch)
+    with kb.connect(db_path) as conn:
+        _attach_session_model_usage(conn)
+        for ts, usd in [(1_700_000_000, 10.0), (1_700_086_400, 20.0)]:
+            tid = f"t-{ts}"
+            _create_running_task(conn, tid)
+            sess = f"sess-{tid}"
+            conn.execute(
+                "INSERT INTO session_model_usage "
+                "(session_id, model, estimated_cost_usd) VALUES (?, 'm', ?)",
+                (sess, usd),
+            )
+            kb._end_run(
+                conn, tid,
+                outcome="completed",
+                metadata={"worker_session_id": sess},
+            )
+            # Pin ended_at to a deterministic value so the per-day
+            # bucketing test doesn't depend on ``int(time.time())``.
+            conn.execute(
+                "UPDATE task_runs SET ended_at = ? "
+                "WHERE id = (SELECT id FROM task_runs "
+                "             WHERE task_id = ? AND ended_at IS NOT NULL "
+                "             ORDER BY id DESC LIMIT 1)",
+                (ts, tid),
+            )
+            conn.commit()
+        summary = kb.cost_summary(conn, group_by="day")
+    # Two distinct days, total 30 USD = 3000 cents.
+    assert summary["total_cents"] == 3000.0
+    assert len(summary["buckets"]) == 2
+
+
+def test_cost_summary_per_assignee_rollup(tmp_path, monkeypatch):
+    """Per-assignee grouping collapses runs by the same assignee."""
+    db_path = _setup_home(tmp_path, monkeypatch)
+    with kb.connect(db_path) as conn:
+        _attach_session_model_usage(conn)
+        for tid, assignee, usd in [
+            ("t-a", "devops", 10.0),
+            ("t-b", "devops", 20.0),
+            ("t-c", "architect", 5.0),
+        ]:
+            _create_running_task(conn, tid)
+            # Override the default assignee set by _create_running_task
+            # so we can assert the per-assignee rollup collapses
+            # correctly. Commit immediately so the next _end_run sees it.
+            conn.execute(
+                "UPDATE tasks SET assignee = ? WHERE id = ?",
+                (assignee, tid),
+            )
+            conn.commit()
+            sess = f"sess-{tid}"
+            conn.execute(
+                "INSERT INTO session_model_usage "
+                "(session_id, model, estimated_cost_usd) VALUES (?, 'm', ?)",
+                (sess, usd),
+            )
+            kb._end_run(
+                conn, tid,
+                outcome="completed",
+                metadata={"worker_session_id": sess},
+            )
+        summary = kb.cost_summary(conn, group_by="assignee")
+    by_assignee = {b["assignee"]: b["cost_in_cents"] for b in summary["buckets"]}
+    assert by_assignee.get("devops") == 3000.0
+    assert by_assignee.get("architect") == 500.0
+
+
+def test_cost_summary_heartbeat_ticks_excluded(tmp_path, monkeypatch):
+    """Heartbeat ticks (source='heartbeat') don't inflate the rollup."""
+    db_path = _setup_home(tmp_path, monkeypatch)
+    with kb.connect(db_path) as conn:
+        _attach_session_model_usage(conn)
+        run_id = _create_running_task(conn, "t-tick")
+        sess = "sess-tick"
+        # First heartbeat (mid-run): worker has done $10 of LLM calls.
+        conn.execute(
+            "INSERT INTO session_model_usage "
+            "(session_id, model, estimated_cost_usd) VALUES (?, 'm', 10.0)",
+            (sess,),
+        )
+        kb.heartbeat_worker(conn, "t-tick")
+        # Now the worker pushes to $30 total before ending.
+        conn.execute(
+            "INSERT INTO session_model_usage "
+            "(session_id, model, estimated_cost_usd) VALUES (?, 'm', 20.0)",
+            (sess,),
+        )
+        kb._end_run(
+            conn, "t-tick",
+            outcome="completed",
+            metadata={"worker_session_id": sess},
+        )
+        summary = kb.cost_summary(conn, group_by="task")
+    assert summary["total_cents"] == 3000.0, (
+        "Should be the terminal total (30 USD = 3000¢), "
+        "NOT 30 + 10 from the heartbeat tick."
+    )
+
+
+def test_board_stats_cost_by_assignee(tmp_path, monkeypatch):
+    """``board_stats`` returns a cost slice next to per-assignee counts."""
+    db_path = _setup_home(tmp_path, monkeypatch)
+    with kb.connect(db_path) as conn:
+        _attach_session_model_usage(conn)
+        run_id = _create_running_task(conn, "t-bs")
+        conn.execute(
+            "INSERT INTO session_model_usage "
+            "(session_id, model, estimated_cost_usd) VALUES (?, 'm', 1234.0)",
+            ("sess-bs",),
+        )
+        kb._end_run(
+            conn, "t-bs",
+            outcome="completed",
+            metadata={"worker_session_id": "sess-bs"},
+        )
+        stats = kb.board_stats(conn)
+    assert "cost_by_assignee" in stats
