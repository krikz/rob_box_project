+def _parse_cost_window_arg(raw: Optional[str]) -> Optional[int]:
+    """Best-effort parser for the ``--since`` / ``--until`` flags.
+
+    Accepts unix-epoch seconds (int / float string), 'Nd' / 'Nh' / 'Nm'
+    relative deltas (subtracted from ``time.time()`` so ``--since=7d``
+    means "the last 7 days"), and ISO-8601 timestamps. Returns ``None``
+    on ``None`` / empty input so the caller can leave the bound open.
+    """
+    if raw is None:
+        return None
+    s = str(raw).strip()
+    if not s:
+        return None
+    # Relative deltas (Nd / Nh / Nm)
+    m = re.match(r"^(\d+)\s*([dhm])$", s, flags=re.IGNORECASE)
+    if m:
+        n = int(m.group(1))
+        unit = m.group(2).lower()
+        seconds = n * {"d": 86400, "h": 3600, "m": 60}[unit]
+        return int(time.time()) - seconds
+    # Pure int / float
+    try:
+        return int(float(s))
+    except ValueError:
+        pass
+    # ISO-8601 fallback
+    try:
+        from datetime import datetime
+        dt = datetime.fromisoformat(s.replace("Z", "+00:00"))
+        return int(dt.timestamp())
+    except ValueError:
+        print(f"kanban cost: cannot parse time argument {raw!r}", file=sys.stderr)
+        return None
+
