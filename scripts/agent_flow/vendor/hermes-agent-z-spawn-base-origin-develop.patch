+# Drift threshold (commits) above which _ensure_git_worktree emits a
+# warning to stderr when a NEW branch is being created. The base is
+# ``HEAD`` when ``origin/develop`` cannot be reached (network down,
+# no upstream configured, etc.), so workers that dispatch during a
+# network blip get a clear signal — not a silent drift. Issue #1571.
+_WORKTREE_BASE_DRIFT_WARN_THRESHOLD = 10
