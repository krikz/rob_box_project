+def _resolve_worktree_base_ref(repo_root: Path, base_branch: str = "develop") -> str:
+    """Return the ref to use as the base for a new worktree branch.
+
+    Best-effort ``git fetch origin <base_branch>`` (timeout 30s); on
+    success returns ``"origin/<base_branch>"`` so the worktree branch
+    is created from fresh upstream rather than the (possibly stale)
+    local ``HEAD`` of the main worktree. On any failure — non-zero
+    exit, timeout, missing remote — falls back to ``"HEAD"`` and emits
+    a ``WORKTREE_BASE_FETCH_FAILED: ...`` warning to stderr so the
+    dispatcher log carries an observable signal (vs. silent drift).
+
+    Ретро issue #1571 (workers observed starting from 48-50 commits
+    behind origin/develop because the main worktree hadn't refreshed
+    its HEAD).
+    """
+    fetch_cmd = ["git", "-C", str(repo_root), "fetch", "origin", base_branch]
+    try:
+        result = subprocess.run(
+            fetch_cmd,
+            capture_output=True,
+            text=True, encoding='utf-8', errors='replace',
+            timeout=30,
+            check=False,
+        )
+    except subprocess.TimeoutExpired:
+        print(
+            f"WORKTREE_BASE_FETCH_FAILED: timeout (>30s) on "
+            f"{' '.join(fetch_cmd)}; falling back to HEAD. "
+            f"Branch {base_branch!r} may be stale — see issue #1571.",
+            file=sys.stderr,
+            flush=True,
+        )
+        return "HEAD"
+    except Exception as exc:
+        print(
+            f"WORKTREE_BASE_FETCH_FAILED: {type(exc).__name__}: {exc} on "
+            f"{' '.join(fetch_cmd)}; falling back to HEAD. "
+            f"Branch {base_branch!r} may be stale — see issue #1571.",
+            file=sys.stderr,
+            flush=True,
+        )
+        return "HEAD"
+    if result.returncode != 0:
+        stderr = (result.stderr or result.stdout or "").strip()
+        print(
+            f"WORKTREE_BASE_FETCH_FAILED: rc={result.returncode} on "
+            f"{' '.join(fetch_cmd)}: {stderr}; falling back to HEAD. "
+            f"Branch {base_branch!r} may be stale — see issue #1571.",
+            file=sys.stderr,
+            flush=True,
+        )
+        return "HEAD"
+    return f"origin/{base_branch}"
+
