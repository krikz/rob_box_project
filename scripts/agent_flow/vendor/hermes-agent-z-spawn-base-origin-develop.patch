+            f"WORKTREE_BASE_DRIFT: HEAD..{base_ref} = {behind} commits "
+            f"(threshold {threshold}; base_branch={base_branch!r}). "
+            f"Worker spawned from potentially stale HEAD. See issue #1571.",
+            file=sys.stderr,
+            flush=True,
+        )
+
