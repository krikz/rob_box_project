+def _warn_worktree_base_drift(
+    repo_root: Path, base_ref: str, base_branch: str = "develop",
+    threshold: int = _WORKTREE_BASE_DRIFT_WARN_THRESHOLD,
+) -> None:
+    """Emit a ``WORKTREE_BASE_DRIFT`` warning to stderr when ``HEAD`` lags
+    ``base_ref`` by more than ``threshold`` commits.
+
+    Called from ``_ensure_git_worktree`` BEFORE creating a fresh branch
+    so dispatch logs carry an observable signal when the dispatcher
+    is about to spawn a worker from a stale base. Network failures
+    during the upstream fetch degrade gracefully: ``base_ref`` falls
+    back to ``HEAD`` and no drift count is computable (no warning),
+    so this helper is intentionally a no-op when ``base_ref`` does
+    not resolve to a remote tracking branch.
+
+    Ретро issue #1571.
+    """
+    try:
+        result = subprocess.run(
+            ["git", "-C", str(repo_root), "rev-list", "--count", f"HEAD..{base_ref}"],
+            capture_output=True,
+            text=True, encoding='utf-8', errors='replace',
+            timeout=10,
+            check=False,
+        )
+    except (subprocess.TimeoutExpired, Exception):
+        return
+    if result.returncode != 0:
