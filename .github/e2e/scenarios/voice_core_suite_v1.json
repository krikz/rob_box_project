{
  "name": "voice_core_suite_v1",
  "description": "E2E для больших голосовых фич (последние 2 недели): command-intent gate (#1279), new-session reset, альтернативный wake word (#1252), music start/stop (#1358). Музыка стартует через Renardo (execute_music_code) — MiniMax generate_music ИСКЛЮЧЁН (недоступен), gen_delete_from_library ИСКЛЮЧЁН. Маркеры сверены с кодом dialogue_node.py / command_node.py.",
  "steps": [
    {
      "label": "cc01_status_gate",
      "voice": "anton",
      "text": "Робот, где ты",
      "patterns": [
        "LLM dispatch skipped",
        "command intent"
      ]
    },
    {
      "label": "ns01_reset_session",
      "voice": "anton",
      "text": "Робот, сбрось всё",
      "patterns": [
        "session reset"
      ]
    },
    {
      "label": "ww01_roboks_wake",
      "voice": "anton",
      "text": "Робокс, как дела",
      "patterns": []
    },
    {
      "label": "dj01_start_renardo",
      "voice": "anton",
      "text": "Робот, сыграй renardo бит",
      "patterns": [
        "execute_music_code"
      ],
      "acceptance": {
        "expected_tool_calls": [
          "execute_music_code"
        ],
        "must_not_call": [
          "generate_music"
        ]
      }
    },
    {
      "label": "dj02_stop_music",
      "voice": "anton",
      "text": "Робот, стоп музыку",
      "patterns": [
        "stop_music"
      ],
      "acceptance": {
        "expected_tool_calls": [
          "stop_music"
        ],
        "must_not_call": []
      }
    }
  ]
}
