{
  "name": "voice_core_suite_v1",
  "description": "E2E для больших голосовых фич (последние 2 недели): command-intent gate (#1279), new-session reset, альтернативный wake word (#1252), music start/stop (#1358), мульти-голос #1219 (set_voice + много-голосовое поведение). MiniMax generate_music и gen_delete_from_library ИСКЛЮЧЕНЫ (Music API недоступен, удаление не валидируем). Бэклог-аккумулятор и мульти-спикер — out-of-scope для voice-e2e (требуют симуляции без-wake фразы или двух спикеров в одном физическом канале — см. docs/analysis/voice-features-e2e-validation-2026-08-22.md §6).",
  "steps": [
    {
      "label": "cc01_status_gate",
      "voice": "anton",
      "text": "Робот, где ты",
      "patterns": [
        "LLM dispatch skipped",
        "command intent"
      ]
    },
    {
      "label": "ns01_reset_session",
      "voice": "anton",
      "text": "Робот, сбрось всё",
      "patterns": [
        "session reset"
      ]
    },
    {
      "label": "ww01_roboks_wake",
      "voice": "anton",
      "text": "Робокс, как дела",
      "patterns": []
    },
    {
      "label": "mv01_set_voice_alena",
      "voice": "anton",
      "text": "Робот, говори голосом Алены",
      "patterns": [
        "set_voice",
        "alena"
      ],
      "acceptance": {
        "expected_tool_calls": [
          "set_voice"
        ],
        "must_not_call": []
      }
    },
    {
      "label": "mv02_speak_alena",
      "voice": "anton",
      "text": "Робот, скажи привет",
      "patterns": [
        "current_voice",
        "alena"
      ]
    },
    {
      "label": "mv03_two_voices_skazka",
      "voice": "anton",
      "text": "Робот, расскажи сказку про Красную Шапочку разными голосами",
      "patterns": [
        "voice_used"
      ]
    },
    {
      "label": "dj01_start_renardo",
      "voice": "anton",
      "text": "Робот, сыграй renardo бит",
      "patterns": [
        "execute_music_code"
      ],
      "acceptance": {
        "expected_tool_calls": [
          "execute_music_code"
        ],
        "must_not_call": [
          "generate_music"
        ]
      }
    },
    {
      "label": "dj02_stop_music",
      "voice": "anton",
      "text": "Робот, стоп музыку",
      "patterns": [
        "stop_music"
      ],
      "acceptance": {
        "expected_tool_calls": [
          "stop_music"
        ],
        "must_not_call": []
      }
    }
  ]
}
