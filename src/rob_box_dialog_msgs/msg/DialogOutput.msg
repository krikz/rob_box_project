# Вывод диалога в канал (ADR-0150 §10.1). Для telegram заменяет /voice/dialogue/response.

# Агент.
string agent
# Ссылка на канал (например telegram:495039871).
string channel_ref
# Текст.
string text
# Реплика речи, к которой привязан текст ("" - только текст).
string speech_id
# Герой реплики (ADR-0160 §2.3); "" - рассказчик. Оформитель чата ставит роль в заголовок.
string role
# Вид вывода: "" - реплика, "progress" - ход процесса (text - подпись шага; чат правит одно сообщение).
string kind
