<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rob_box_teleop</name>
  <version>0.1.0</version>
  <description>Teleoperation package for Rob Box robot with joystick/gamepad support</description>
  <maintainer email="krikz@rob-box.ru">Rob Box Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <!-- proximity_guard_node (#4365): /odom, поза лидара из TF, footprint из nav2_params.yaml -->
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- proximity: скан и угроза векторно (CPU Main Pi, #4365) -->
  <exec_depend>python3-numpy</exec_depend>
  <!-- speech_client.say -> SpeechRequest (PR-15 part 15-0d); the types come from the msgs image -->
  <depend>rob_box_core</depend>
  <depend>rob_box_dialog_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
