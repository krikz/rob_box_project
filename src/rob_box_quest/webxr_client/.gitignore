node_modules/
dist/
dist-types/
*.log
.DS_Store
.vite/
coverage/

# glTF asset pipeline (Phase 2.0 — see ADR-0032):
# raw glTF sources are produced externally (Blender export / Quaternius /
# Khronos Sample Assets). Only the *optimized* outputs may be committed.
# The gltf:verify CI guard will reject any *.glb that lacks Draco + Meshopt.
public/models/**/*.glb
public/models/**/*.gltf

# Phase 2.0/2.1 committed optimized assets (canonical or .optimized suffix).
!public/models/**/*.optimized.glb

# Phase 2.1 canonical avatar artifact (kanban t_90c362bd, issue #1677):
# gltf:optimize writes *.optimized.glb; the canonical published name for
# the avatar is avatar.glb so the runtime can drop the `.optimized.` suffix
# without renaming. Same compression contract (Draco + Meshopt) applies —
# see gltf:verify and avatar_pipeline.test.ts.
!public/models/avatar/avatar.glb

# Build scratch dirs for programmatic assets (Phase 2.1 build-avatar,
# build_bridge_assets). Raw .glb + sidecar .json are written here during
# the build; only the optimised output (above allowlist) is committed.
public/models/**/_raw/
