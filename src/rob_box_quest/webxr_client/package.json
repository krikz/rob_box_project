{
  "name": "@rob_box/quest-webxr-client",
  "version": "0.1.0",
  "description": "Meta Quest / WebXR Captain Bridge client for rob_box_quest (Phase 2.0: glTF asset pipeline + Three.js + WebXR).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gltf:optimize": "node scripts/gltf-optimize.mjs",
    "gltf:verify": "node scripts/gltf-verify.mjs",
    "build:avatar": "node scripts/build-avatar.mjs"
  },
  "dependencies": {
    "three": "^0.170.0",
    "lil-gui": "^0.19.2"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@types/node": "^20.12.7",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "draco3dgltf": "^1.5.7",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.33.5",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
