{
  "name": "@rob_box/quest-webxr-client",
  "version": "0.2.0",
  "description": "Meta Quest / WebXR Captain Bridge client for rob_box_quest (Phase 2.1: bridge env + IBL).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "assets:build": "node scripts/build_bridge_assets.mjs",
    "assets:validate": "node scripts/validate_glbs.mjs",
    "hdr:validate": "node scripts/test_hdr_ibl.mjs"
  },
  "dependencies": {
    "three": "^0.170.0",
    "lil-gui": "^0.19.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@types/three": "^0.170.0",
    "@types/node": "^20.12.7",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}