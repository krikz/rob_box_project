<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypp="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rob_box_llm</name>
  <version>0.1.0</version>
  <description>Shared LLM provider abstraction for rob_box_voice and rob_box_telegram. P0 foundation for harness architecture (ADR-0001).</description>
  <maintainer email="kukoreken@rob-box.local">krikz</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>python3-openai</exec_depend>
  <exec_depend>python3-httpx</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-pytest-asyncio</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
