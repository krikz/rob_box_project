<?xml version="1.0"?>
<robot name="rob_box" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<!-- Переменные - обновлено из Fusion 360 Export -->
	<xacro:property name="base_size" value="0.4757 0.238 0.1885"/>  <!-- Legacy collision box, use mesh instead -->
	<xacro:property name="wheel_radius" value="0.1143"/>  <!-- Замер 2026-02-23: 9" колёса с редукторами -->
	<xacro:property name="wheel_length" value="0.05"/>
	<xacro:property name="rocker_length" value="0.28934"/>
	<xacro:property name="rocker_width" value="0.05"/>
	<xacro:property name="rocker_thickness" value="0.01"/>
	<xacro:property name="wheel_mass" value="21.68159743475603"/>  <!-- От Fusion 360: 21.68 кг -->
	<xacro:property name="rocker_mass" value="3"/>
	<xacro:property name="base_mass" value="62.64527022934752"/>  <!-- От Fusion 360: 62.65 кг -->

	<xacro:arg name="sim" default="false"/>
	<xacro:property name="is_sim" value="${'$(arg sim)'.lower() in ('true', '1')}"/>
	<xacro:if value="${is_sim}">
		<!-- ═══ Режим симуляции (sim:=true), Gazebo Fortress + gz_ros2_control ═══ -->
		<!-- План: docs/research/2026-11-04-gazebo-sim-navigation.md §6 шаг 1.      -->
		<!-- При sim:=false (робот) сгенерированный URDF побайтно тот же, что и     -->
		<!-- до появления аргумента: все сим-добавки живут внутри xacro:if, тест    -->
		<!-- src/rob_box_description/test/test_xacro_sim_arg.py сверяет с эталоном. -->
		<!-- Масса: Шифу 03.11 — робот весит ~20 кг (Fusion-масса 149 кг неверна).  -->
		<!-- Пока правим ТОЛЬКО для сима: шасси 14 кг + 4 колеса по 1.5 кг.         -->
		<!-- Инерция шасси — Fusion-тензор, умноженный на 14/62.65 (форма та же).   -->
	</xacro:if>
	<xacro:property name="sim_base_mass" value="14.0"/>
	<xacro:property name="sim_wheel_mass" value="1.5"/>
	<xacro:property name="sim_base_inertia_scale" value="${sim_base_mass / base_mass}"/>
	<xacro:property name="sim_wheel_width" value="0.075"/>

	<!-- Микрофонный массив ReSpeaker USB Mic Array v2.0 (ADR-0130 §2.9, ADR-0137 §2.2). -->
	<!-- Положение со слов владельца (28.09.2026): на высоте лидара (z=0.4765), в той же  -->
	<!-- плоскости x, что лидар и потолочная камера (x≈-0.1707), на ТОМ ЖЕ борту, что и   -->
	<!-- потолочная камера (y=+0.065, левый борт робота = справа при взгляде на робота     -->
	<!-- лицом к лицу), чуть ближе к центру: y≈+0.05. Рулеткой не измерено (ADR-0137 §4, в.1). -->
	<!-- yaw: ось X фрейма = направление, в котором прошивка отдаёт DOAANGLE = 0°;    -->
	<!-- знак отсчёта (по/против часовой) и yaw — из замера measure_doa.py (§4, в.2). -->
	<xacro:property name="mic_array_xyz" value="-0.1707 0.05 0.4765"/>
	<xacro:property name="mic_array_rpy" value="0 0 0"/>

	<!-- base_footprint - корневой фрейм робота на уровне пола -->
	<!-- Используется как reference frame в соответствии с REP-120 -->
	<link name="base_footprint">
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<sphere radius="0.001"/>
			</geometry>
		</visual>
	</link>

	<!-- Основное шасси - обновлено из Fusion 360 Export -->
	<!-- base_link в системе ROS (X вперед, Y влево) - исправленный экспорт из Fusion -->
	<link name="base_link">
		<xacro:unless value="${is_sim}">
		<!-- Меш base_link.stl из Fusion 360 - нормализован относительно base_link (0,0,0) -->
		<inertial>
			<!-- Инерциальные параметры из Fusion 360 (исправленный экспорт 2e0e5f8) -->
			<origin xyz="-0.025488169162561854 -2.4090750285970683e-05 0.14529190576177384" rpy="0 0 0"/>
			<mass value="${base_mass}"/>
			<inertia ixx="1.926172" iyy="2.829827" izz="3.653023" ixy="0.001791" iyz="-0.001655" ixz="0.302171"/>
		</inertial>
		</xacro:unless>
		<xacro:if value="${is_sim}">
		<inertial>
			<origin xyz="-0.025488169162561854 -2.4090750285970683e-05 0.14529190576177384" rpy="0 0 0"/>
			<mass value="${sim_base_mass}"/>
			<inertia ixx="${1.926172 * sim_base_inertia_scale}" iyy="${2.829827 * sim_base_inertia_scale}" izz="${3.653023 * sim_base_inertia_scale}" ixy="${0.001791 * sim_base_inertia_scale}" iyz="${-0.001655 * sim_base_inertia_scale}" ixz="${0.302171 * sim_base_inertia_scale}"/>
		</inertial>
		</xacro:if>
		<visual>
			<!-- Меш БЕЗ ПОВОРОТА - frame base_link уже повернут через base_footprint_joint -->
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<mesh filename="package://rob_box_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="silver">
				<color rgba="0.75 0.75 0.75 1"/>
			</material>
		</visual>
		<xacro:unless value="${is_sim}">
		<collision>
			<!-- Collision также БЕЗ ПОВОРОТА -->
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<mesh filename="package://rob_box_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
		</xacro:unless>
		<xacro:if value="${is_sim}">
		<collision>
			<!-- Сим: коробка по габаритам base_link.stl (x -0.30..0.31, z -0.005..0.49), -->
			<!-- по Y — между колёсами. Меш-коллизия для физики тяжела.             -->
			<origin xyz="0.0014 0 0.243" rpy="0 0 0"/>
			<geometry>
				<box size="0.61 0.38 0.496"/>
			</geometry>
		</collision>
		</xacro:if>
	</link>

	<!-- Джойнт base_footprint -> base_link БЕЗ ПОВОРОТА -->
	<!-- base_footprint на уровне пола, base_link поднят на высоту колеса -->
	<joint name="base_footprint_joint" type="fixed">
		<parent link="base_footprint"/>
		<child link="base_link"/>
		<!-- БЕЗ ПОВОРОТА - визуал и одометрия должны соответствовать физическому роботу -->
		<origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
	</joint>

	<!-- Макросы -->
	<!-- Wheel Macro - обновлено из Fusion 360 Export (исправленный экспорт 2e0e5f8) -->
	<xacro:macro name="wheel" params="name origin_xyz axis_xyz visual_origin_xyz sim_center_y:=0.0375">
		<link name="${name}">
			<xacro:unless value="${is_sim}">
			<!-- Инерциальные параметры из Fusion 360 (исправленный экспорт) -->
			<inertial>
				<mass value="${wheel_mass}"/>
				<!-- Inertial origin: смещение центра масс колеса -->
				<origin xyz="0 0.0375 0"/>
				<inertia ixx="0.073667" iyy="0.129466" izz="0.073667" ixy="0" iyz="0" ixz="0"/>
			</inertial>
			</xacro:unless>
			<xacro:if value="${is_sim}">
			<!-- Сим: сплошной цилиндр r=wheel_radius, ширина 0.075 (по мешу), ось — Y -->
			<inertial>
				<mass value="${sim_wheel_mass}"/>
				<origin xyz="0 ${sim_center_y} 0"/>
				<inertia ixx="${sim_wheel_mass * (3 * wheel_radius * wheel_radius + sim_wheel_width * sim_wheel_width) / 12}" iyy="${sim_wheel_mass * wheel_radius * wheel_radius / 2}" izz="${sim_wheel_mass * (3 * wheel_radius * wheel_radius + sim_wheel_width * sim_wheel_width) / 12}" ixy="0" iyz="0" ixz="0"/>
			</inertial>
			</xacro:if>
			<visual>
				<!-- Visual origin: offset меша относительно линка БЕЗ ПОВОРОТА -->
				<!-- Frame base_link уже повернут через base_footprint_joint -->
				<origin xyz="${visual_origin_xyz}" rpy="0 0 0"/>
				<geometry>
					<mesh filename="package://rob_box_description/meshes/${name}.stl" scale="0.001 0.001 0.001"/>
				</geometry>
				<material name="black">
					<color rgba="0.1 0.1 0.1 1"/>
				</material>
			</visual>
			<xacro:unless value="${is_sim}">
			<collision>
				<!-- Collision также БЕЗ ПОВОРОТА -->
				<origin xyz="${visual_origin_xyz}" rpy="0 0 0"/>
				<geometry>
					<mesh filename="package://rob_box_description/meshes/${name}.stl" scale="0.001 0.001 0.001"/>
				</geometry>
			</collision>
			</xacro:unless>
			<xacro:if value="${is_sim}">
			<collision>
				<!-- Сим: цилиндр вместо меша — ровный контакт колесо–пол -->
				<origin xyz="0 ${sim_center_y} 0" rpy="${pi / 2} 0 0"/>
				<geometry>
					<cylinder radius="${wheel_radius}" length="${sim_wheel_width}"/>
				</geometry>
			</collision>
			</xacro:if>
		</link>
		<joint name="${name}_joint" type="continuous">
			<parent link="base_link"/>
			<child link="${name}"/>
			<origin xyz="${origin_xyz}" rpy="0 0 0"/>
			<axis xyz="${'0 1 0' if is_sim else axis_xyz}"/>
		</joint>
		<xacro:if value="${is_sim}">
		<!-- Сим: у всех колёс ось +Y. В боевом URDF правые колёса — ось -Y, и     -->
		<!-- diff_drive_controller в Gazebo крутил их назад: команда «вперёд»       -->
		<!-- разворачивала робота на месте (замер на песочнице 04.11). На роботе    -->
		<!-- знак, видимо, учитывает железо VESC — там ось не трогаем.             -->
		<!-- Трение колёс: стартовые значения, подбор под «эффективную колею 1.11» — шаг 5 плана -->
		<gazebo reference="${name}">
			<mu1>1.0</mu1>
			<mu2>1.0</mu2>
			<kp>1000000.0</kp>
			<kd>100.0</kd>
			<minDepth>0.001</minDepth>
		</gazebo>
		</xacro:if>
	</xacro:macro>

	<!-- Сенсоры -->
	<xacro:macro name="lidar" params="name parent_link origin_xyz origin_rpy:='0 0 0' topic_name">
		<link name="${name}">
			<visual>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<cylinder radius="0.026" length="0.0361"/>
				</geometry>
				<material name="black">
					<color rgba="0 0 0 1"/>
				</material>
			</visual>
			<collision>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<cylinder radius="0.026" length="0.0361"/>
				</geometry>
			</collision>
			<inertial>
				<mass value="0.06"/>
				<origin xyz="0 0 0"/>
				<inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
			</inertial>
		</link>
		<joint name="${name}_joint" type="fixed">
			<parent link="${parent_link}"/>
			<child link="${name}"/>
			<origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
		</joint>
		<xacro:if value="${is_sim}">
		<!-- Сим: как настоящий LSLIDAR N10 — полный круг без обрезки                 -->
		<!-- (angle_disable_min/max 0.0), 0.15–10 м (docker/main/config/lslidar/       -->
		<!-- lsx10_custom.yaml:14-17), 10 Гц. 360 лучей = 1°. Плоскость скана поднята  -->
		<!-- на 0.025 м — над верхом меша base_link (z 0.4915), иначе gpu_lidar видит  -->
		<!-- собственный корпус. Плагин Sensors — в мире (rob_box_sim/worlds).          -->
		<gazebo reference="${name}">
			<sensor name="${name}_sensor" type="gpu_lidar">
				<pose>0 0 0.025 0 0 0</pose>
				<topic>scan</topic>
				<ignition_frame_id>${name}</ignition_frame_id>
				<update_rate>10</update_rate>
				<ray>
					<scan>
						<horizontal>
							<samples>360</samples>
							<resolution>1</resolution>
							<min_angle>-3.14159265</min_angle>
							<max_angle>3.12413936</max_angle>
						</horizontal>
						<vertical>
							<samples>1</samples>
							<resolution>1</resolution>
							<min_angle>0</min_angle>
							<max_angle>0</max_angle>
						</vertical>
					</scan>
					<range>
						<min>0.15</min>
						<max>10.0</max>
						<resolution>0.01</resolution>
					</range>
					<noise>
						<type>gaussian</type>
						<mean>0.0</mean>
						<stddev>0.01</stddev>
					</noise>
				</ray>
				<always_on>1</always_on>
				<visualize>false</visualize>
			</sensor>
		</gazebo>
		</xacro:if>
		<xacro:unless value="${is_sim}">
		<gazebo reference="${name}">
			<sensor name="${name}_sensor" type="gpu_lidar">
				<pose>0 0 0 0 0 0</pose>
				<topic>${topic_name}</topic>
				<update_rate>10</update_rate>
				<ray>
					<scan>
						<horizontal>
							<samples>640</samples>
							<resolution>1</resolution>
							<min_angle>-1.396263</min_angle>
							<max_angle>1.396263</max_angle>
						</horizontal>
						<vertical>
							<samples>1</samples>
							<resolution>0.01</resolution>
							<min_angle>0</min_angle>
							<max_angle>0</max_angle>
						</vertical>
					</scan>
					<range>
						<min>0.08</min>
						<max>10.0</max>
						<resolution>0.01</resolution>
					</range>
				</ray>
				<always_on>1</always_on>
				<visualize>true</visualize>
			</sensor>
			<plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
				<render_engine>ogre2</render_engine>
			</plugin>
		</gazebo>
		</xacro:unless>
	</xacro:macro>

	<!-- OAK-D Camera Macro - соответствует реальной структуре фреймов depthai_ros_driver -->
	<xacro:macro name="oak_d_camera" params="name parent_link origin_xyz origin_rpy">
		<!-- camera_link - основной корпус камеры -->
		<link name="${name}_link">
			<visual>
				<!-- Visual offset из экспорта Fusion (компенсация позиции меша) -->
				<origin xyz="0.115772 0.000238 -0.4595" rpy="0 0 0"/>
				<geometry>
					<mesh filename="package://rob_box_description/meshes/camera_oak.stl" scale="0.001 0.001 0.001"/>
				</geometry>
				<material name="dark_grey">
					<color rgba="0.2 0.2 0.2 1"/>
				</material>
			</visual>
			<collision>
				<!-- Collision offset из экспорта Fusion -->
				<origin xyz="0.115772 0.000238 -0.4595" rpy="0 0 0"/>
				<geometry>
					<mesh filename="package://rob_box_description/meshes/camera_oak.stl" scale="0.001 0.001 0.001"/>
				</geometry>
			</collision>
			<inertial>
				<mass value="0.350"/>  <!-- 350g из экспорта Fusion -->
				<origin xyz="0.00875 0.015 0"/>  <!-- Из экспорта Fusion -->
				<inertia ixx="0.000264" ixy="0" ixz="0" iyy="0.000032" iyz="0" izz="0.00025"/>
			</inertial>
		</link>

		<!-- Присоединение к роботу -->
		<joint name="${name}_joint" type="fixed">
			<parent link="${parent_link}"/>
			<child link="${name}_link"/>
			<origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
		</joint>

		<!-- camera (intermediate frame - используется depthai_ros_driver) -->
		<link name="${name}"/>
		<joint name="${name}_base_joint" type="fixed">
			<parent link="${name}_link"/>
			<child link="${name}"/>
			<origin xyz="0 0 0" rpy="0 0 0"/>
		</joint>

		<!-- RGB camera frames (depthai_ros_driver использует именование rgb_camera, не color) -->
		<link name="${name}_rgb_camera_frame"/>
		<joint name="${name}_rgb_camera_frame_joint" type="fixed">
			<parent link="${name}"/>
			<child link="${name}_rgb_camera_frame"/>
			<!-- Смещение RGB камеры относительно базы (из calibration) -->
			<origin xyz="0 0 0" rpy="0 0 0"/>
		</joint>

		<link name="${name}_rgb_camera_optical_frame"/>
		<joint name="${name}_rgb_camera_optical_frame_joint" type="fixed">
			<parent link="${name}_rgb_camera_frame"/>
			<child link="${name}_rgb_camera_optical_frame"/>
			<!-- Optical frame: X right, Y down, Z forward (ROS camera convention) -->
			<origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
		</joint>

		<!-- Compatibility aliases for current depthai_ros_driver color frame naming -->
		<link name="${name}_color_frame"/>
		<joint name="${name}_color_frame_joint" type="fixed">
			<parent link="${name}_rgb_camera_frame"/>
			<child link="${name}_color_frame"/>
			<origin xyz="0 0 0" rpy="0 0 0"/>
		</joint>

		<link name="${name}_color_optical_frame"/>
		<joint name="${name}_color_optical_frame_joint" type="fixed">
			<parent link="${name}_rgb_camera_optical_frame"/>
			<child link="${name}_color_optical_frame"/>
			<origin xyz="0 0 0" rpy="0 0 0"/>
		</joint>

		<!-- Depth/Stereo camera frames -->
		<link name="${name}_stereo_camera_frame"/>
		<joint name="${name}_stereo_camera_frame_joint" type="fixed">
			<parent link="${name}"/>
			<child link="${name}_stereo_camera_frame"/>
			<!-- Depth камера немного смещена (левая камера stereo пары) -->
			<origin xyz="0 0.0375 0" rpy="0 0 0"/>
		</joint>

		<link name="${name}_stereo_camera_optical_frame"/>
		<joint name="${name}_stereo_camera_optical_frame_joint" type="fixed">
			<parent link="${name}_stereo_camera_frame"/>
			<child link="${name}_stereo_camera_optical_frame"/>
			<origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
		</joint>

		<!-- IMU frame (если используется) -->
		<link name="${name}_imu_frame"/>
		<joint name="${name}_imu_frame_joint" type="fixed">
			<parent link="${name}"/>
			<child link="${name}_imu_frame"/>
			<origin xyz="0 0 0" rpy="3.14159 0 1.5708"/>
		</joint>
	</xacro:macro>

	<!-- Simple USB Camera Macro - для обычных USB камер (ceiling camera, etc.) -->
	<!-- optical_rpy: поворот оптического кадра от линка; по умолчанию оптическая ось Z = +X линка (вперёд) -->
	<xacro:macro name="usb_camera" params="name parent_link origin_xyz origin_rpy optical_rpy:='-1.5708 0 -1.5708'">
		<!-- camera_link - основной корпус камеры -->
		<link name="${name}_link">
			<visual>
				<!-- Visual offset из экспорта Fusion (компенсация позиции меша) -->
				<origin xyz="0.170663 -0.065 -0.4615" rpy="0 0 0"/>
				<geometry>
					<mesh filename="package://rob_box_description/meshes/camera_rpi.stl" scale="0.001 0.001 0.001"/>
				</geometry>
				<material name="black">
					<color rgba="0.1 0.1 0.1 1"/>
				</material>
			</visual>
			<collision>
				<!-- Collision offset из экспорта Fusion -->
				<origin xyz="0.170663 -0.065 -0.4615" rpy="0 0 0"/>
				<geometry>
					<mesh filename="package://rob_box_description/meshes/camera_rpi.stl" scale="0.001 0.001 0.001"/>
				</geometry>
			</collision>
			<inertial>
				<mass value="0.029"/>  <!-- 29g из экспорта Fusion -->
				<origin xyz="0 0 0.008"/>  <!-- Из экспорта Fusion -->
				<inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000002" iyz="0" izz="0.000001"/>
			</inertial>
		</link>

		<!-- Присоединение к роботу -->
		<joint name="${name}_joint" type="fixed">
			<parent link="${parent_link}"/>
			<child link="${name}_link"/>
			<origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
		</joint>

		<!-- Optical frame (ROS camera convention): X вправо по кадру, Y вниз по кадру, Z по оптической оси -->
		<link name="${name}_optical_frame"/>
		<joint name="${name}_optical_frame_joint" type="fixed">
			<parent link="${name}_link"/>
			<child link="${name}_optical_frame"/>
			<origin xyz="0 0 0" rpy="${optical_rpy}"/>
		</joint>
	</xacro:macro>

	<!-- Использование макросов - ОБНОВЛЕНО из Fusion 360 (исправленный экспорт 2e0e5f8) -->
	<!-- Система координат теперь соответствует ROS: X вперед, Y влево -->
	<!-- Naming convention: matches controller_manager.yaml (left/right_front/rear_wheel) -->
	<!-- Left wheels -->
	<!-- Left Rear: Fusion 360 исправленный экспорт origin="-0.143797 0.195 0.028767" -->
	<xacro:wheel name="left_rear_wheel" 
	             origin_xyz="-0.143797 0.195 0.028767" 
	             axis_xyz="0.0 1.0 0.0"
	             visual_origin_xyz="0.143797 -0.195 -0.028767"/>
	<!-- Left Front: Fusion 360 исправленный экспорт origin="0.145731 0.195 0.0289" -->
	<xacro:wheel name="left_front_wheel" 
	             origin_xyz="0.145731 0.195 0.0289" 
	             axis_xyz="0.0 1.0 0.0"
	             visual_origin_xyz="-0.145731 -0.195 -0.0289"/>
	
	<!-- Right wheels -->
	<!-- Right Front: Fusion 360 исправленный экспорт origin="0.144669 -0.195967 0.0289" -->
	<xacro:wheel name="right_front_wheel" sim_center_y="-0.0375" 
	             origin_xyz="0.144669 -0.195967 0.0289" 
	             axis_xyz="0.0 -1.0 0.0"
	             visual_origin_xyz="-0.144669 0.195967 -0.0289"/>
	<!-- Right Rear: Fusion 360 исправленный экспорт origin="-0.143797 -0.195 0.028767" -->
	<xacro:wheel name="right_rear_wheel" sim_center_y="-0.0375" 
	             origin_xyz="-0.143797 -0.195 0.028767" 
	             axis_xyz="0.0 -1.0 0.0"
	             visual_origin_xyz="0.143797 0.195 -0.028767"/>

	<!-- Сенсоры - ОБНОВЛЕНО из Fusion 360 Export (исправленный экспорт 2e0e5f8) -->
	<!-- LiDAR: Fusion 360 исправленный экспорт xyz="-0.170806 -0.000331 0.4765" -->
	<xacro:lidar name="lslidar_n10" parent_link="base_link" origin_xyz="-0.170806 -0.000331 0.4765" origin_rpy="0 0 0" topic_name="/scan"/>
	<!-- OAK-D-Lite камера: Fusion 360 исправленный экспорт xyz="-0.115772 -0.000238 0.4595" rpy="0 0 0" -->
	<xacro:oak_d_camera name="camera" parent_link="base_link" origin_xyz="-0.115772 -0.000238 0.4595" origin_rpy="0 0 0"/>
	<!-- Потолочная USB камера: Fusion 360 исправленный экспорт xyz="-0.170663 0.065 0.4615" -->
	<!-- Камера смотрит вертикально вверх (HARDWARE.md §3.3). Линк оставлен как в Fusion   -->
	<!-- (rpy 0, к нему привязан меш), поворачивается только оптический кадр:               -->
	<!-- Z оптики = +Z base_link (вверх), верх кадра (−Y оптики) = +X (вперёд),             -->
	<!-- правый край кадра (+X оптики) = +Y (влево; снизу вверх картинка зеркальна).         -->
	<!-- Поворот кадра вокруг оси НЕ измерен: проверка — тег на потолке, робот едет вперёд, -->
	<!-- тег в кадре уходит вниз (docs/guides/ceiling-camera-calibration.md, шаг 5).        -->
	<xacro:usb_camera name="ceiling_camera" parent_link="base_link" origin_xyz="-0.170663 0.065 0.4615" origin_rpy="0 0 0" optical_rpy="0 0 1.5708"/>

	<!-- Микрофонный массив: только фрейм (без меша). Центр массива, Z вверх.     -->
	<!-- Потребитель — азимут DOA → трек (ADR-0130 §2.9, этап 5). Положение — см. выше. -->
	<link name="mic_array_link"/>
	<joint name="mic_array_joint" type="fixed">
		<parent link="base_link"/>
		<child link="mic_array_link"/>
		<origin xyz="${mic_array_xyz}" rpy="${mic_array_rpy}"/>
	</joint>

	<xacro:if value="${is_sim}">
	<!-- Сим: IMU. gz-топик imu → ROS /camera/camera/imu (как сырой IMU OAK-D на роботе) -->
	<!-- делает ros_gz_bridge (rob_box_sim); дальше imu-filter (madgwick) → rtabmap.       -->
	<!-- Шум гироскопа/акселерометра — порядок BMI270 (OAK-D), не измерен на роботе:       -->
	<!-- без шума и смещения курс по гироскопу в симе был бы идеальным.                   -->
	<gazebo reference="camera_imu_frame">
		<sensor name="imu_sensor" type="imu">
			<always_on>1</always_on>
			<update_rate>100</update_rate>
			<topic>imu</topic>
			<ignition_frame_id>camera_imu_frame</ignition_frame_id>
			<imu>
				<angular_velocity>
					<x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev><bias_mean>0.0005</bias_mean><bias_stddev>0.0002</bias_stddev></noise></x>
					<y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev><bias_mean>0.0005</bias_mean><bias_stddev>0.0002</bias_stddev></noise></y>
					<z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev><bias_mean>0.0005</bias_mean><bias_stddev>0.0002</bias_stddev></noise></z>
				</angular_velocity>
				<linear_acceleration>
					<x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
					<y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
					<z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
				</linear_acceleration>
			</imu>
		</sensor>
	</gazebo>
	<!-- Сим: истинная поза робота (для проверки, что робот реально едет:           -->
	<!-- /odom у diff_drive_controller open_loop и считается из команд, а не из физики). -->
	<gazebo>
		<plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
			<odom_frame>sim_world</odom_frame>
			<robot_base_frame>base_footprint</robot_base_frame>
			<odom_topic>/model/rob_box/ground_truth/odom</odom_topic>
			<odom_publish_frequency>20</odom_publish_frequency>
			<dimensions>3</dimensions>
		</plugin>
	</gazebo>
	</xacro:if>

	<!-- ros2_control Hardware Interface - VESC Nexus -->
	<xacro:include filename="rob_box_ros2_control.xacro"/>
</robot>