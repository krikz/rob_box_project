<?xml version="1.0"?>
<robot name="rob_box" xmlns:xacro="http://www.ros.org/wiki/xacro">
	<!-- Переменные - обновлено из Fusion 360 Export -->
	<xacro:property name="base_size" value="0.4757 0.238 0.1885"/>  <!-- Legacy collision box, use mesh instead -->
	<xacro:property name="wheel_radius" value="0.115"/>
	<xacro:property name="wheel_length" value="0.05"/>
	<xacro:property name="rocker_length" value="0.28934"/>
	<xacro:property name="rocker_width" value="0.05"/>
	<xacro:property name="rocker_thickness" value="0.01"/>
	<xacro:property name="wheel_mass" value="21.68159743475603"/>  <!-- От Fusion 360: 21.68 кг -->
	<xacro:property name="rocker_mass" value="3"/>
	<xacro:property name="base_mass" value="62.64527022934752"/>  <!-- От Fusion 360: 62.65 кг -->

	<!-- base_footprint - корневой фрейм робота на уровне пола -->
	<!-- Используется как reference frame в соответствии с REP-120 -->
	<link name="base_footprint">
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<sphere radius="0.001"/>
			</geometry>
		</visual>
	</link>

	<!-- Основное шасси - обновлено из Fusion 360 Export -->
	<!-- Frame base_link повернут на -90° вокруг Z через base_footprint_joint -->
	<link name="base_link">
		<!-- Меш base_link.stl из Fusion 360 - нормализован относительно base_link (0,0,0) -->
		<inertial>
			<!-- Инерциальные параметры из Fusion 360 -->
			<origin xyz="-2.4090750286344156e-05 0.025488169162562517 0.14529190576177464" rpy="0 0 0"/>
			<mass value="${base_mass}"/>
			<inertia ixx="2.829827" iyy="1.926172" izz="3.653023" ixy="-0.001791" iyz="-0.302171" ixz="-0.001655"/>
		</inertial>
		<visual>
			<!-- Меш БЕЗ ПОВОРОТА - frame base_link уже повернут через base_footprint_joint -->
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<mesh filename="package://rob_box_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
			</geometry>
			<material name="silver">
				<color rgba="0.75 0.75 0.75 1"/>
			</material>
		</visual>
		<collision>
			<!-- Collision также БЕЗ ПОВОРОТА -->
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<mesh filename="package://rob_box_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
			</geometry>
		</collision>
	</link>

	<!-- Джойнт base_footprint -> base_link С ПОВОРОТОМ -->
	<!-- base_footprint на уровне пола, base_link поднят на высоту колеса -->
	<joint name="base_footprint_joint" type="fixed">
		<parent link="base_footprint"/>
		<child link="base_link"/>
		<!-- ПОВОРОТ НА -90° вокруг Z для соответствия ROS convention (X вперёд) -->
		<!-- Fusion 360: Y вперёд → ROS: X вперёд → поворот на -90° -->
		<origin xyz="0 0 ${wheel_radius}" rpy="0 0 -1.5708"/>
	</joint>

	<!-- Макросы -->
	<!-- Wheel Macro - обновлено из Fusion 360 Export (прямое подключение к base_link, без rocker) -->
	<xacro:macro name="wheel" params="name origin_xyz axis_xyz visual_origin_xyz">
		<link name="${name}">
			<!-- Инерциальные параметры из Fusion 360 -->
			<inertial>
				<mass value="${wheel_mass}"/>
				<!-- Inertial origin: смещение центра масс колеса -->
				<origin xyz="0.0375 0 0"/>
				<inertia ixx="0.129466" iyy="0.073667" izz="0.073667" ixy="0" iyz="0" ixz="0"/>
			</inertial>
			<visual>
				<!-- Visual origin: offset меша относительно линка БЕЗ ПОВОРОТА -->
				<!-- Frame base_link уже повернут через base_footprint_joint -->
				<origin xyz="${visual_origin_xyz}" rpy="0 0 0"/>
				<geometry>
					<mesh filename="package://rob_box_description/meshes/${name}.stl" scale="0.001 0.001 0.001"/>
				</geometry>
				<material name="black">
					<color rgba="0.1 0.1 0.1 1"/>
				</material>
			</visual>
			<collision>
				<!-- Collision также БЕЗ ПОВОРОТА -->
				<origin xyz="${visual_origin_xyz}" rpy="0 0 0"/>
				<geometry>
					<mesh filename="package://rob_box_description/meshes/${name}.stl" scale="0.001 0.001 0.001"/>
				</geometry>
			</collision>
		</link>
		<joint name="${name}_joint" type="continuous">
			<parent link="base_link"/>
			<child link="${name}"/>
			<origin xyz="${origin_xyz}" rpy="0 0 0"/>
			<axis xyz="${axis_xyz}"/>
		</joint>
	</xacro:macro>

	<!-- Сенсоры -->
	<xacro:macro name="lidar" params="name parent_link origin_xyz origin_rpy:='0 0 0' topic_name">
		<link name="${name}">
			<visual>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<cylinder radius="0.026" length="0.0361"/>
				</geometry>
				<material name="black">
					<color rgba="0 0 0 1"/>
				</material>
			</visual>
			<collision>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<cylinder radius="0.026" length="0.0361"/>
				</geometry>
			</collision>
			<inertial>
				<mass value="0.06"/>
				<origin xyz="0 0 0"/>
				<inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
			</inertial>
		</link>
		<joint name="${name}_joint" type="fixed">
			<parent link="${parent_link}"/>
			<child link="${name}"/>
			<origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
		</joint>
		<gazebo reference="${name}">
			<sensor name="${name}_sensor" type="gpu_lidar">
				<pose>0 0 0 0 0 0</pose>
				<topic>${topic_name}</topic>
				<update_rate>10</update_rate>
				<ray>
					<scan>
						<horizontal>
							<samples>640</samples>
							<resolution>1</resolution>
							<min_angle>-1.396263</min_angle>
							<max_angle>1.396263</max_angle>
						</horizontal>
						<vertical>
							<samples>1</samples>
							<resolution>0.01</resolution>
							<min_angle>0</min_angle>
							<max_angle>0</max_angle>
						</vertical>
					</scan>
					<range>
						<min>0.08</min>
						<max>10.0</max>
						<resolution>0.01</resolution>
					</range>
				</ray>
				<always_on>1</always_on>
				<visualize>true</visualize>
			</sensor>
			<plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
				<render_engine>ogre2</render_engine>
			</plugin>
		</gazebo>
	</xacro:macro>

	<!-- OAK-D Camera Macro - соответствует реальной структуре фреймов depthai_ros_driver -->
	<xacro:macro name="oak_d_camera" params="name parent_link origin_xyz origin_rpy">
		<!-- camera_link - основной корпус камеры -->
		<link name="${name}_link">
			<visual>
				<!-- БЕЗ ПОВОРОТА - frame base_link уже повернут через base_footprint_joint -->
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<box size="0.097 0.0275 0.0214"/>  <!-- Размеры OAK-D-Lite -->
				</geometry>
				<material name="dark_grey">
					<color rgba="0.2 0.2 0.2 1"/>
				</material>
			</visual>
			<collision>
				<!-- Collision также БЕЗ ПОВОРОТА -->
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<box size="0.097 0.0275 0.0214"/>
				</geometry>
			</collision>
			<inertial>
				<mass value="0.061"/>  <!-- 61g вес OAK-D-Lite -->
				<origin xyz="0 0 0"/>
				<inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
			</inertial>
		</link>

		<!-- Присоединение к роботу -->
		<joint name="${name}_joint" type="fixed">
			<parent link="${parent_link}"/>
			<child link="${name}_link"/>
			<origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
		</joint>

		<!-- camera (intermediate frame - используется depthai_ros_driver) -->
		<link name="${name}"/>
		<joint name="${name}_base_joint" type="fixed">
			<parent link="${name}_link"/>
			<child link="${name}"/>
			<origin xyz="0 0 0" rpy="0 0 0"/>
		</joint>

		<!-- RGB camera frames (depthai_ros_driver использует именование rgb_camera, не color) -->
		<link name="${name}_rgb_camera_frame"/>
		<joint name="${name}_rgb_camera_frame_joint" type="fixed">
			<parent link="${name}"/>
			<child link="${name}_rgb_camera_frame"/>
			<!-- Смещение RGB камеры относительно базы (из calibration) -->
			<origin xyz="0 0 0" rpy="0 0 0"/>
		</joint>

		<link name="${name}_rgb_camera_optical_frame"/>
		<joint name="${name}_rgb_camera_optical_frame_joint" type="fixed">
			<parent link="${name}_rgb_camera_frame"/>
			<child link="${name}_rgb_camera_optical_frame"/>
			<!-- Optical frame: X right, Y down, Z forward (ROS camera convention) -->
			<origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
		</joint>

		<!-- Depth/Stereo camera frames -->
		<link name="${name}_stereo_camera_frame"/>
		<joint name="${name}_stereo_camera_frame_joint" type="fixed">
			<parent link="${name}"/>
			<child link="${name}_stereo_camera_frame"/>
			<!-- Depth камера немного смещена (левая камера stereo пары) -->
			<origin xyz="0 0.0375 0" rpy="0 0 0"/>
		</joint>

		<link name="${name}_stereo_camera_optical_frame"/>
		<joint name="${name}_stereo_camera_optical_frame_joint" type="fixed">
			<parent link="${name}_stereo_camera_frame"/>
			<child link="${name}_stereo_camera_optical_frame"/>
			<origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
		</joint>

		<!-- IMU frame (если используется) -->
		<link name="${name}_imu_frame"/>
		<joint name="${name}_imu_frame_joint" type="fixed">
			<parent link="${name}"/>
			<child link="${name}_imu_frame"/>
			<origin xyz="0 0 0" rpy="3.14159 0 1.5708"/>
		</joint>
	</xacro:macro>

	<!-- Simple USB Camera Macro - для обычных USB камер (ceiling camera, etc.) -->
	<xacro:macro name="usb_camera" params="name parent_link origin_xyz origin_rpy">
		<!-- camera_link - основной корпус камеры -->
		<link name="${name}_link">
			<visual>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<box size="0.03 0.03 0.02"/>  <!-- Размеры generic USB камеры -->
				</geometry>
				<material name="black">
					<color rgba="0.1 0.1 0.1 1"/>
				</material>
			</visual>
			<collision>
				<origin xyz="0 0 0" rpy="0 0 0"/>
				<geometry>
					<box size="0.03 0.03 0.02"/>
				</geometry>
			</collision>
			<inertial>
				<mass value="0.05"/>  <!-- ~50g -->
				<origin xyz="0 0 0"/>
				<inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
			</inertial>
		</link>

		<!-- Присоединение к роботу -->
		<joint name="${name}_joint" type="fixed">
			<parent link="${parent_link}"/>
			<child link="${name}_link"/>
			<origin xyz="${origin_xyz}" rpy="${origin_rpy}"/>
		</joint>

		<!-- Optical frame: X right, Y down, Z forward (ROS camera convention) -->
		<link name="${name}_optical_frame"/>
		<joint name="${name}_optical_frame_joint" type="fixed">
			<parent link="${name}_link"/>
			<child link="${name}_optical_frame"/>
			<origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
		</joint>
	</xacro:macro>

	<!-- Использование макросов - ОРИГИНАЛЬНЫЕ позиции из Fusion 360 -->
	<!-- Frame base_link повернут на -90° через base_footprint_joint, поэтому позиции остаются как в Fusion -->
	<!-- Naming convention: matches controller_manager.yaml (left/right_front/rear_wheel) -->
	<!-- Left wheels -->
	<!-- Left Rear: Fusion 360 origin="0.195 0.143797 0.028767" visual="-0.195 -0.143797 -0.028767" -->
	<xacro:wheel name="left_rear_wheel" 
	             origin_xyz="0.195 0.143797 0.028767" 
	             axis_xyz="1.0 0.0 0.0"
	             visual_origin_xyz="-0.195 -0.143797 -0.028767"/>
	<!-- Left Front: Fusion 360 origin="0.195 -0.145731 0.0289" visual="-0.195 0.145731 -0.0289" -->
	<xacro:wheel name="left_front_wheel" 
	             origin_xyz="0.195 -0.145731 0.0289" 
	             axis_xyz="1.0 0.0 0.0"
	             visual_origin_xyz="-0.195 0.145731 -0.0289"/>
	
	<!-- Right wheels -->
	<!-- Right Front: Fusion 360 origin="-0.195967 -0.144669 0.0289" visual="0.195967 0.144669 -0.0289" -->
	<xacro:wheel name="right_front_wheel" 
	             origin_xyz="-0.195967 -0.144669 0.0289" 
	             axis_xyz="-1.0 0.0 0.0"
	             visual_origin_xyz="0.195967 0.144669 -0.0289"/>
	<!-- Right Rear: Fusion 360 origin="-0.195 0.143797 0.028767" visual="0.195 -0.143797 -0.028767" -->
	<xacro:wheel name="right_rear_wheel" 
	             origin_xyz="-0.195 0.143797 0.028767" 
	             axis_xyz="-1.0 0.0 0.0"
	             visual_origin_xyz="0.195 -0.143797 -0.028767"/>

	<!-- Сенсоры - ОРИГИНАЛЬНЫЕ позиции из Fusion 360 Export -->
	<!-- Frame base_link повернут на -90° через base_footprint_joint, поэтому позиции остаются как в Fusion -->
	<!-- LiDAR: Fusion 360 Rigid 2 joint xyz="-0.000331 0.170806 0.4765" -->
	<xacro:lidar name="lslidar_n10" parent_link="base_link" origin_xyz="-0.000331 0.170806 0.4765" origin_rpy="0 0 0" topic_name="/scan"/>
	<!-- OAK-D-Lite камера: Fusion 360 Rigid 3 joint xyz="-0.000238 0.115772 0.4595" -->
	<xacro:oak_d_camera name="camera" parent_link="base_link" origin_xyz="-0.000238 0.115772 0.4595" origin_rpy="0 0 0"/>
	<!-- Потолочная USB камера: Fusion 360 xyz="0.065 0.170663 0.4615" -->
	<xacro:usb_camera name="ceiling_camera" parent_link="base_link" origin_xyz="0.065 0.170663 0.4615" origin_rpy="0 0 0"/>

	<!-- ros2_control Hardware Interface - VESC Nexus -->
	<xacro:include filename="rob_box_ros2_control.xacro"/>
</robot>