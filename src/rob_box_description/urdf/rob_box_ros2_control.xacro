<?xml version="1.0"?>
<!-- 
  rob_box_ros2_control.xacro
  
  ros2_control интеграция с VESC Nexus hardware interface
  Определяет 4 колеса с VESC моторами через CAN
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- ros2_control Hardware Interface - VESC Nexus                    -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  
  <xacro:arg name="controllers_yaml" default="/config/controllers/controller_manager.yaml"/>
  <!-- HIL (docs/research/2026-11-04-hil-robot-on-gazebo-data.md §5.2): узел, у которого   -->
  <!-- gz_ros2_control берёт robot_description. Пусто — по умолчанию плагина              -->
  <!-- (/robot_state_publisher, обычный сим). В HIL на Main Pi под этим именем живёт      -->
  <!-- боевой RSP с URDF VESC, поэтому сим задаёт свой узел, например                     -->
  <!-- /sim/robot_state_publisher (src/rob_box_sim/launch/sim.launch.py, hil:=true).      -->
  <xacro:arg name="sim_robot_param_node" default=""/>
  <!-- Сим: второй файл параметров поверх controllers_yaml — эффективная колея Gazebo   -->
  <!-- (#4495). Путь — внутри контейнера gazebo (docker/sim/Dockerfile ставит rob_box_sim -->
  <!-- в /ws/install). Порядок важен: файл позже — его параметры сильнее.              -->
  <xacro:arg name="sim_drive_yaml" default="/ws/install/rob_box_sim/share/rob_box_sim/config/sim_drive.yaml"/>
  <xacro:unless value="${is_sim}">
  <ros2_control name="VescSystem" type="system">
    <hardware>
      <plugin>vesc_nexus/VescSystemHardwareInterface</plugin>
      
      <!-- CAN Interface Configuration -->
      <param name="can_interface">can0</param>
      
      
      <!-- Передаточное число редуктора (motor_rps / gear_ratio = wheel_rps) -->
      <!-- Эмпирическая калибровка 2026-02-27: физ. редуктор 5:1, но max_rps=6.5 -->
      <!-- уже частично учитывает передачу. Подбирается так чтобы -->
      <!-- Калибровка 2026-02-28: 2.26/1.04=2.17 (физ 104см vs ожид 100см @0.2m/s×5s) -->
      <!-- #4360, тахометр 04.11 (кирпичи, 0.2/0.6/1.0 м/с): драйвер завышал скорость колеса в 1.326 раза. -->
      <!-- gear_ratio делит eRPM в state (velocity/position колеса): 2.17×1.326 = 2.87742. -->
      <!-- max_rps в joint'ах умножен на тот же 1.326 (12.2 → 16.1772): duty = wheel_rps·gear_ratio/max_rps -->
      <!-- зависит только от отношения gear_ratio/max_rps, поэтому команда на моторы не изменилась. -->
      <param name="gear_ratio">2.87742</param>
      
      <!-- Минимальный duty cycle для преодоления мёртвой зоны VESC -->
      <!-- Используется только в режиме control_mode=duty -->
      <!-- Калибровка 2026-02-28: 0.08→0.04→0.05 -->
      <param name="min_duty">0.05</param>
      
      <!-- Режим управления моторами: "duty" или "rpm" -->
      <!-- duty: открытый контур, отправляет duty cycle (% напряжения) -->
      <!-- rpm: замкнутый контур, отправляет целевой ERPM, VESC PID держит скорость -->
      <!-- rpm пока вызывает дребезг моторов на низких ERPM (hall interp + PID tuning) -->
      <param name="control_mode">duty</param>
    </hardware>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Left Front Wheel -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <joint name="left_front_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>  <!-- м/с -->
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
      
      <!-- VESC Configuration -->
      <param name="can_id">49</param>              <!-- CAN ID в VESC Tool -->
      <param name="poles">30</param>               <!-- Количество полюсов мотора -->
      <param name="min_erpm">24</param>           <!-- Минимальный ERPM для движения -->
      <param name="wheel_radius">0.1143</param>    <!-- Замер 2026-02-23: 9" с редуктором -->
      <param name="max_rps">16.1772</param>            <!-- Калибровка 2026-02-28: ratio=1.22@0.2m/s×5s, max_rps=10×1.22 -->
    </joint>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Right Front Wheel -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <joint name="right_front_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
      
      <param name="can_id">94</param>
      <param name="poles">30</param>
      <param name="min_erpm">24</param>
      <param name="wheel_radius">0.1143</param>    <!-- Замер 2026-02-23: 9" с редуктором -->
      <param name="max_rps">16.1772</param>            <!-- Калибровка 2026-02-28: ratio=1.22@0.2m/s×5s -->
    </joint>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Left Rear Wheel -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <joint name="left_rear_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
      
      <param name="can_id">81</param>
      <param name="poles">30</param>
      <param name="min_erpm">24</param>
      <param name="wheel_radius">0.1143</param>    <!-- Замер 2026-02-23: 9" с редуктором -->
      <param name="max_rps">16.1772</param>            <!-- Калибровка 2026-02-28: ratio=1.22@0.2m/s×5s -->
    </joint>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Right Rear Wheel -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <joint name="right_rear_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
      
      <param name="can_id">124</param>
      <param name="poles">30</param>
      <param name="min_erpm">24</param>
      <param name="wheel_radius">0.1143</param>    <!-- Замер 2026-02-23: 9" с редуктором -->
      <param name="max_rps">16.1772</param>            <!-- Калибровка 2026-02-28: ratio=1.22@0.2m/s×5s -->
    </joint>
  </ros2_control>
  </xacro:unless>

  <xacro:if value="${is_sim}">
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <!-- Сим (sim:=true): те же 4 сустава и интерфейсы, железо — Gazebo.  -->
  <!-- Контроллеры — ТОТ ЖЕ controller_manager.yaml, что на роботе      -->
  <!-- (docker/main/config/controllers/), путь — аргумент controllers_yaml. -->
  <!-- ═══════════════════════════════════════════════════════════════ -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_front_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="right_front_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="left_rear_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="right_rear_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_yaml)</parameters>
      <parameters>$(arg sim_drive_yaml)</parameters>
      <xacro:if value="${'$(arg sim_robot_param_node)' != ''}">
      <robot_param_node>$(arg sim_robot_param_node)</robot_param_node>
      </xacro:if>
    </plugin>
  </gazebo>
  </xacro:if>

</robot>
