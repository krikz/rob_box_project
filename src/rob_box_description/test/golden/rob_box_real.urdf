      <param name="wheel_radius">0.1143</param>
      <!-- Замер 2026-02-23: 9" с редуктором -->
      <param name="max_rps">16.1772</param>
      <!-- Калибровка 2026-02-28: ratio=1.22@0.2m/s×5s -->
    </joint>
  </ros2_control>
</robot>
