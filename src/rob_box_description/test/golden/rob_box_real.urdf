      <!-- Замер 2026-02-23: 9" с редуктором -->
      <param name="max_rps">16.1772</param>
      <!-- Калибровка 2026-02-28: ratio=1.22@0.2m/s×5s, max_rps=10×1.22 -->
    </joint>
