<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypp="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rob_box_dialog</name>
  <version>0.1.0</version>
  <description>Pure-Python dialog v2 core (ADR-0150): one knowledge table, LLM command + validator, session, phrases. No ROS, no network, no LLM clients.</description>
  <maintainer email="kukoreken@rob-box.local">krikz</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rob_box_core</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
