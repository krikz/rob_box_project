# club: dj_dave_32, A# minor, i-iv-VI-v, бочка by_design, seed=0
# 16 блоков × 2 такта, 128 долей; '#' = четверть звучит
# kick | .... ...# #### #### | #### #### ###. .... | #### #### #### #### | #### #### #### #..#
# hats | #### #### #### .### | #### #### #### #### | #### #### #### #### | #### #### #### ####
# clap | .... .... .... .... | .... #### #### ...# | #### #### #### .### | .... #### .... ####
# lead | .... .... .... .... | .... .... #### #### | #### #### #### #### | .... .... #### ####
# bass | .... #### #### #### | #### #### ##.. .... | #### #### #### #### | #### #### #### ####
# pad  | #### #### #### #### | #### #### #### #### | #### #### #### #### | #### #### #### ####
Clock.clear()
Clock.bpm = 124

d1 >> play("X..X..X..(.X)X.....", dur=1/4, amp=var([0, 0.263, 0, 0.263, 0, 0.263], [14, 40, 10, 58, 4, 2]))
d2 >> play("---(-.)(-.)----------(-.)", dur=1/4, hpf=2500, amp=var([0.85, 0.061, 0, 0.061, 0.85, 0.061], [8, 16, 2, 30, 8, 64]))
d3 >> play("..=.*.=...=.*.=.", dur=1/4, lpf=3000, room=0.25, amp=var([0, 0.105, 0, 0.105, 0, 0.105, 0, 0.105, 0, 0.105], [40, 16, 6, 26, 2, 6, 8, 8, 8, 8]))

p1 >> pluck([68, 65, 68, 68, 68, 73, 77, 75, 68, 65, 68, 68, 68, 73, 73, 70,
             68, 65, 68, 68, 68, 73, 77, 75, 68, 65, 68, 68, 70, 68, 70, 68,
             68, 66, 68, 68, 68, 73, 78, 75, 68, 66, 68, 68, 68, 73, 73, 70,
             68, 66, 68, 68, 68, 73, 78, 75, 68, 66, 68, 68, 70, 68, 70, 68,
             68, 66, 68, 68, 68, 73, 78, 75, 68, 66, 68, 68, 68, 73, 73, 70,
             68, 66, 68, 68, 68, 73, 78, 75, 68, 66, 68, 68, 70, 68, 70, 68,
             68, 65, 68, 68, 68, 72, 77, 75, 68, 65, 68, 68, 68, 72, 72, 70,
             68, 65, 68, 68, 68, 72, 77, 75, 68, 65, 68, 68, 70, 68, 70, 68],
            dur=1/4, scale=Scale.chromatic, root=0, oct=0, sus=0.15,
            lpf=linvar([900, 4000], 31), hpf=linvar([0, 0, 1500, 0], [48, 16, 0, 64]), room=0.6, mix=0.3,
            amp=var([0, 0.123, 0.85, 0.123, 0, 0.123], [48, 8, 8, 32, 16, 16]),
            amplify=[0.25, 0.75, 0.75, 0.25, 0.75, 0.75, 0.25, 0.75, 0.75, 0.25, 0.25, 0.75, 0.75, 0.75, 0.75, 0.75])

p2 >> bass([(34, 46)] * 32 + [(39, 51)] * 32 + [(42, 54)] * 32 + [(41, 53)] * 32,
           dur=1/4, scale=Scale.chromatic, root=0, oct=0, sus=0.2,
           lpf=linvar([500, 2500], 61), room=0.25,
           amp=var([0, 0.175, 0, 0.175], [8, 44, 12, 64]),
           amplify=[0.25, 0.75, 0.75, 0.25, 0.75, 0.75, 0.25, 0.75, 0.75, 0.25, 0.25, 0.75, 0.75, 0.75, 0.75, 0.75])

p3 >> sinepad([(58, 61, 65), (51, 54, 58), (54, 58, 61), (53, 56, 60)], dur=8,
              scale=Scale.chromatic, root=0, oct=0, room=0.7, mix=0.4,
              amp=var([0.85, 0.048, 0.85, 0.048], [8, 48, 8, 64]))

Clock.future(128, Clock.clear)
