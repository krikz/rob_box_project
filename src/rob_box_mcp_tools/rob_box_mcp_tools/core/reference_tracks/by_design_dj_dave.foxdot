# Эталон качества DJ-режима: перекладка Strudel-трека на Renardo/FoxDot.
# Оригинал: «By Design [DJ_Dave Edit]», Spill Tab / DJ_Dave, код на strudel.cc,
# лицензия CC BY-NC-SA 4.0 (https://creativecommons.org/licenses/by-nc-sa/4.0/).
# Перекладка — производная работа под той же лицензией, только как эталон
# для сравнения на слух (docs/design/2026-09-28-dj-live-coding-quality-plan.md §7).
#
# Что перенесено и почему так (Strudel → FoxDot):
#   setCps(100/60/4)                      → Clock.bpm = 100 (1 цикл = 1 такт)
#   kick struct "x ~ ~ x ~ ~ x ~ ~ [~|x] x ~ ~ ~ ~ ~"
#                                          → play("X..X..X..(.X)X....."), (.X) чередует
#   sidechain "{0.5 1.5!2 ... 0.5!2 1.5!5}" → amp=P[...] на плеерах с dur=1/4:
#       просадка ровно на шагах кика (0,3,6,9,10). Бас и арпеджио
#       перезапускаются 16-ми, поэтому громкость на каждую 16-ю и есть пампинг.
#       Значения абсолютные (0.5:1.5 = 1:3): _cap_amp режет каждое значение
#       P[...] до max_amp, множители >1 недопустимы.
#   notes irand(23) a#2 minor pentatonic x16, decay .1, lpf slider
#                                          → pluck(PRand(0, 15)), root=10, oct=3,
#       диапазон сужен с 23 до 15 ступеней (16 кГц), слайдер → linvar
#   bassline "f#2@3 c#2@5 g#2@3 <d#2 a#1>@5".slow(2), struct x*16, [0,-12,12]
#                                          → bass по 16-м, слои (n, n+12);
#       -12 (суб 30-45 Гц) убран — динамик ReSpeaker его не воспроизводит
#   clap "~ cp" fast(2) + "~ hh" fast(4)   → один play(): клэп на 2 и 4,
#       открытый хэт на слабые 8-е (разные шаги, коллизий нет)
#   hh "x*16 | [x!3 ~!2 x!10 ~]"           → "(-.)" чередует дыры по циклам
#   vox mask "0!3 1".slow(8)               → пэд по аккордам баса только в
#       7-8 такте из каждых 8 (amp=var([0, a], [24, 8]))
#   dur=1/4 у play() ОБЯЗАТЕЛЕН: по умолчанию у play() dur=0.5 (renardo_lib
#       Players.py:602) — 16 шагов шли бы восьмыми, 2 такта, и пампинг
#       баса/арпа (dur=1/4) промахивался бы мимо бочки.
#   Сэмплы пака DJ_Dave (issue #3219, ставит Ресурсный пак, в git их нет;
#   короткие имена в loop() санитайзер переписывает в путь до файла, флаг
#   ROB_BOX_PACK1_LOOPS=1):
#   клэп "~ cp" fast(2)                   → в d1 символом * на шагах 4 и 12,
#       amp=P[...] на d1 опускает его до 0.3 (кик 0.7); шаги кика не тронуты
#   открытый хэт "~ hh" fast(4)            → символ = на слабых 8-х шагах d2
#   s("spilltab") вокальные чопы           → p3 >> loop('algorave_spilltab',
#       P[...], dur=1/2): позиции в файле (в долях), маска amp=var([0, a],
#       [24, 8]) — слышно в 7-8 такте из 8, как маска "0!3 1".slow(8).
#       Заменил ПЭД sinepad (он и так звучал только в тех же двух тактах):
#       слотов ровно шесть (d1-d3, p1-p3), седьмого санитайзер не даёт.
#   psr-перкуссия s("psr")                 → d3 >> loop('dirt_psr_05',
#       dur=PDur(5,16)/4): евклидов рисунок на один такт. Какой именно psr
#       и какой рисунок был в оригинале — в перекладке не сохранилось,
#       выбрано на глаз.
#   НЕ перенесено: jux(rev) (динамик моно), almostNever(ply) (stutter с
#   d3 ушёл вместе с клэпом), аккорды пэда (слот отдан вокалу).
#   НЕ проверено на слух и на роботе: позиции P[...] в loop() (единицы —
#   по RENARDO_REFERENCE.md), громкость сэмплов на 16 kHz DAC, mono/stereo
#   (psr — моно, а loop читает буфер как стерео).
Clock.clear()
Clock.bpm = 100

d1 >> play("X..X*.X..(.X)X.*...", dur=1/4,
           amp=P[0.7, 0.7, 0.7, 0.7, 0.3, 0.7, 0.7, 0.7, 0.7, 0.7, 0.7, 0.7, 0.3, 0.7, 0.7, 0.7])
d2 >> play("--=(-.)(-.)-=---=---=(-.)", dur=1/4, amp=0.18, hpf=2500)
d3 >> loop('dirt_psr_05', dur=PDur(5, 16) / 4, amp=0.25, lpf=6000)

p1 >> pluck(PRand(0, 15), dur=1/4, scale=Scale.minorPentatonic, root=10, oct=3,
            sus=0.15, lpf=linvar([900, 4000], 32), room=0.8, mix=0.4,
            amp=P[0.08, 0.24, 0.24, 0.08, 0.24, 0.24, 0.08, 0.24, 0.24, 0.08, 0.08, 0.24, 0.24, 0.24, 0.24, 0.24])

p2 >> bass([(42, 54)] * 6 + [(37, 49)] * 10 + [(44, 56)] * 6 + [(39, 51)] * 10
           + [(42, 54)] * 6 + [(37, 49)] * 10 + [(44, 56)] * 6 + [(34, 46)] * 10,
           dur=1/4, scale=Scale.chromatic, root=0, oct=0, sus=0.2,
           lpf=linvar([500, 2500], 64), room=0.25,
           amp=P[0.12, 0.36, 0.36, 0.12, 0.36, 0.36, 0.12, 0.36, 0.36, 0.12, 0.12, 0.36, 0.36, 0.36, 0.36, 0.36])

p3 >> loop('algorave_spilltab', P[0, 3, 7, 3, 12, 5, 9, 2], dur=1/2,
             amp=var([0, 0.3], [24, 8]), room=0.4, mix=0.3)
