<?xml version="1.0"?>
<!--
  Гладкий коридор 1.4 м в свету, x -12..24, без выступов.
  От участка езды x 0..10 оба торца дальше 10 м (дальность лидара): ICP вдоль
  коридора вырожден, как в реальном коридоре 14–16.12.2025.
  Робот спавнится в (0, 0), смотрит по +X.

  Файл сгенерирован: python3 -m rob_box_sim.worlds_catalog (или grid_to_sdf). Руками не править.
  Системы мира: Sensors (ogre2) нужен gpu_lidar, Imu — IMU-сенсору робота.
-->
<sdf version="1.8">
  <world name="corridor">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="corridor_walls">
      <static>true</static>
      <link name="side_north">
        <pose>6.000 0.750 0.500 0 0 0.000000</pose>
        <collision name="collision"><geometry><box><size>36.200 0.100 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>36.200 0.100 1.000</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
      <link name="side_south">
        <pose>6.000 -0.750 0.500 0 0 0.000000</pose>
        <collision name="collision"><geometry><box><size>36.200 0.100 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>36.200 0.100 1.000</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
      <link name="end_west">
        <pose>-12.050 0.000 0.500 0 0 0.000000</pose>
        <collision name="collision"><geometry><box><size>0.100 1.400 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.100 1.400 1.000</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
      <link name="end_east">
        <pose>24.050 0.000 0.500 0 0 0.000000</pose>
        <collision name="collision"><geometry><box><size>0.100 1.400 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.100 1.400 1.000</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
