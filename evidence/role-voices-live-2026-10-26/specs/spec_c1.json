[
{
"id": "m-en_WhisperingGirl_p01",
"provider": "minimax",
"voice": "English_Whispering_girl",
"pitch": 0,
"speed": 1.0,
"text": "Робот, который сейчас час, и сколько осталось до утра?"
},
{
"id": "m-en_WhisperingGirl_p02",
"provider": "minimax",
"voice": "English_Whispering_girl",
"pitch": 0,
"speed": 1.0,
"text": "Робот, сколько у тебя осталось заряда, до утра дотянешь?"
},
{
"id": "m-en_WhisperingGirl_p03",
"provider": "minimax",
"voice": "English_Whispering_girl",
"pitch": 0,
"speed": 1.0,
"text": "Робот, доложи статус: всё ли у тебя работает, ничего не отвалилось?"
},
{
"id": "m-en_WhisperingGirl_p04",
"provider": "minimax",
"voice": "English_Whispering_girl",
"pitch": 0,
"speed": 1.0,
"text": "Робот, где ты сейчас находишься?"
},
{
"id": "m-en_WhisperingGirl_p05",
"provider": "minimax",
"voice": "English_Whispering_girl",
"pitch": 0,
"speed": 1.0,
"text": "Робот, что ты видишь вокруг себя, опиши в двух словах."
},
{
"id": "m-en_WhisperingGirl_p06",
"provider": "minimax",
"voice": "English_Whispering_girl",
"pitch": 0,
"speed": 1.0,
"text": "Робот, какие звуки ты вообще умеешь издавать?"
},
{
"id": "m-en_WhisperingGirl_p07",
"provider": "minimax",
"voice": "English_Whispering_girl",
"pitch": 0,
"speed": 1.0,
"text": "Робот, у тебя сейчас играет какая-нибудь музыка?"
},
{
"id": "m-en_WhisperingGirl_p08",
"provider": "minimax",
"voice": "English_Whispering_girl",
"pitch": 0,
"speed": 1.0,
"text": "Робот, ты меня слышишь? Ответь коротко."
},
{
"id": "m-en_WhisperingGirl_p09",
"provider": "minimax",
"voice": "English_Whispering_girl",
"pitch": 0,
"speed": 1.0,
"text": "Робот, посмотри, пожалуйста, не горит ли лампочка на зарядке."
},
{
"id": "m-en_WhisperingGirl_p10",
"provider": "minimax",
"voice": "English_Whispering_girl",
"pitch": 0,
"speed": 1.0,
"text": "Робот, расскажи, какая завтра погода за окном мастерской."
},
{
"id": "m-en_WhisperingGirl_p11",
"provider": "minimax",
"voice": "English_Whispering_girl",
"pitch": 0,
"speed": 1.0,
"text": "Робот, повтори, пожалуйста, что ты говорил про колёса."
},
{
"id": "m-en_WhisperingGirl_p12",
"provider": "minimax",
"voice": "English_Whispering_girl",
"pitch": 0,
"speed": 1.0,
"text": "Робот, подскажи, сколько будет семью восемь, только без шуток."
},
{
"id": "m-en_WhisperingGirl_p13",
"provider": "minimax",
"voice": "English_Whispering_girl",
"pitch": 0,
"speed": 1.0,
"text": "Робот, а какой сегодня день недели?"
},
{
