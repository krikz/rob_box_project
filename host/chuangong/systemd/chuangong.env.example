# /etc/chuangong/chuangong.env — конфиг агента chuangong на одной Pi (пример, ADR-0168).
CHUANGONG_ROBOT_ID=RBXU100001
# main | vision | sound
CHUANGONG_NODE=main
CHUANGONG_CHANNEL=dev
# Реестр площадки. Пока katana; фаза A переводит на registry.<site>.in.robbox.tech по https.
CHUANGONG_REGISTRY=http://10.1.1.249:5000
CHUANGONG_PUBKEY=/etc/chuangong/release.pub
# REST zenoh-роутера своей Pi.
CHUANGONG_ZENOH=http://127.0.0.1:8000
# observe — смотреть и докладывать; stage — ещё скачивать заранее бандл и образы роли.
CHUANGONG_MODE=observe
CHUANGONG_DRY_RUN=0
CHUANGONG_RESERVE_GB=2
