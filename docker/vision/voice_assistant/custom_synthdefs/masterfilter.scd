// masterfilter.scd — мастер-шина: защита от NaN + анти-алиасинг + мягкий потолок
//
// Заменяет masterlimiter, снятый 31.08. Тот глушил весь выход, и разбор
// показал почему: детектор до него видел чистый сигнал, детектор сразу
// после — NaN (CheckBadValues на живой музыке). Порченые сэмплы уходили в
// ReplaceOut, и мастер-шина умирала целиком. На чистой синусоиде он при
// этом работал — поэтому и продержался так долго незамеченным.
//
// Отсюда три правила этого файла.
//
// 1. NaN НЕ ДОЛЖЕН ВЫХОДИТЬ ОТСЮДА. Один сломанный плеер не имеет права
//    убивать весь звук робота. Порченые сэмплы заменяются нулём ДО всего
//    остального: фильтры, умножения и ReplaceOut распространяют NaN дальше,
//    поэтому чистить надо на входе.
//
// 2. НИКАКОЙ ДИНАМИКИ С СОСТОЯНИЕМ. Compander считает усиление делением по
//    огибающей, Limiter держит буфер упреждения — оба имеют внутреннее
//    состояние, которое, однажды защёлкнувшись на NaN, не восстанавливается.
//    Вместо них tanh: чистая функция без состояния и без деления, мягко
//    насыщается около единицы и для любого конечного входа даёт конечный
//    выход. Потолок слабее брикволла, но он не может «залипнуть».
//
// 3. СРЕЗ СЧИТАЕТСЯ ОТ ЧАСТОТЫ СЕРВЕРА, А НЕ В ГЕРЦАХ. scsynth на роботе
//    работает на 16 kHz (потолок ReSpeaker UAC1.0), Найквист — 8 kHz. Число
//    7000, безобидное на 44.1/48 kHz, там оказывается на 0.875 Найквиста.
//
// Зачем вообще анти-алиасинг (RC5 в docs/analysis/2026-08-30-music-quality-audit.md):
// пилообразные и дисторшн-тембры (saw, varsaw, fuzz, dirt, supersawlead)
// дают обертоны выше Найквиста, они зеркалятся обратно в слышимую полосу
// негармоничным визгом. Живой пример 31.08: «дэт-метал» — три перегруженных
// слоя разом (dirt + fuzz + supersawlead). Полное решение — синтез на 48 kHz
// с ресемплингом (P7 в аудите), здесь смягчение.
//
// От этого фильтра зависит потолок октав в music.py (_cap_amp, max_oct).
// Пока фильтра нет, потолок обязан быть ниже — это уже стреляло: лимитер
// сняли, а потолок 6 остался, и робот засвистел на bell(oct=7 -> 6).
//
// РАЗМЕЩЕНИЕ: Synth в ХВОСТЕ RootNode (node 0), см. foxdot_init.sc.
// Renardo играет в группе 1 и чистит только её, поэтому фильтр переживает
// Clock.clear(), stop_music() и DJ-переходы.

SynthDef.new(\masterfilter, {
    // gain=0.5 — тот же мастер-фейдер, что стоял у снятого лимитера. При
    // 1.0 робот заиграл ровно вдвое громче (live 31.08): tanh начинает
    // сжимать только у единицы, поэтому пики проходили почти целиком.
    // Замер на живом треке: с gain=0.5 пик 0.42, то есть до фейдера сумма
    // доходила до ~0.84 — вплотную к колену. Уровень под речь задаётся
    // отсюда, ROS-параметром music_master_gain через /n_set gain.
    |bus = 0, hpf = 35, lpf = 7000, gain = 0.5, lag = 0.15, drive = 1.0|
    var sig, bad, nyquist, cutoff;

    sig = In.ar(bus, 2);

    // ── Правило 1: вычистить NaN/Inf на входе ────────────────────────────
    // CheckBadValues возвращает 0 = норма, 1 = NaN, 2 = Inf, 3 = денормал.
    // post-режим 0: молча, иначе лог сервера зальёт сообщениями.
    // Денормалы (3) не опасны для слуха, но дороги по CPU — их тоже в ноль.
    bad = CheckBadValues.ar(sig, 0, 0);
    sig = Select.ar(bad, [sig, DC.ar(0), DC.ar(0), DC.ar(0)]);

    // ── Субниз ───────────────────────────────────────────────────────────
    // На 16 kHz DAC его не воспроизводит, но место в сумме он занимает.
    sig = HPF.ar(sig, hpf);

    // ── Правило 3: анти-алиасинговый срез ────────────────────────────────
    nyquist = SampleRate.ir * 0.5;
    cutoff = min(lpf, nyquist * 0.55);
    sig = LPF.ar(sig, cutoff);

    // ── Правило 2: мягкий потолок без состояния ──────────────────────────
    // Renardo суммирует слои в bus 0 без контроля суммы. tanh почти линеен
    // до ~0.5 и плавно сжимает выше, поэтому внутренняя динамика микса
    // сохраняется, а сумма не уходит за единицу.
    sig = (sig * drive).tanh;

    // Мастер-фейдер. Lag.kr — чтобы смена gain не давала щелчок.
    sig = sig * Lag.kr(gain, lag);

    ReplaceOut.ar(bus, sig);
}).add;
