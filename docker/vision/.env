# Docker configuration for DEVELOP branch
# This file is automatically loaded when deploying from develop branch

ROS_DISTRO=humble
#IMAGE_TAG=test
#REGISTRY=ghcr.io
IMAGE_TAG=dev
REGISTRY=10.1.1.249:5000
REPOSITORY_OWNER=krikz
BASE_IMAGE_PREFIX=${REGISTRY}/${REPOSITORY_OWNER}/rob_box_base
SERVICE_IMAGE_PREFIX=${REGISTRY}/${REPOSITORY_OWNER}/rob_box

# Robot ID for namespace isolation
ROBOT_ID=RBXU100001

# Monitoring configuration
# Set to IP address or hostname of the monitoring machine
LOKI_HOST=monitoring-machine

# Hailo AI HAT+ (ADR-0089 Phase 1.5): real inference.
# hailo_enabled=true включается только когда в образе есть python-биндинг
# hailo_platform (Dockerfile: HAILO_INSTALL_BINDING=whl) и HEF скачан в
# /opt/rob_box/models/yolov8n.hef. ENV wins над hailo_models.yaml (SSoT).
HAILO_ENABLED=true
HEF_PATH=/opt/rob_box/models/yolov8n.hef

# Лицевая детекция (ADR-0089 Phase 2, issue #2599 PR-A). Переменные
# независимы от person-детекции: compose подставляет их ТОЛЬКО в сервис
# vision-face (FACE_HAILO_ENABLED → HAILO_ENABLED внутри контейнера).
#
# Почему именно здесь, а не в hailo_models.yaml: compose всегда передаёт
# HAILO_ENABLED=${FACE_HAILO_ENABLED:-false}, а start_vision_face.sh
# отдаёт ENV приоритет над YAML ("ENV override wins"). Поэтому правка
# одного YAML не включает real-режим — нужна эта переменная.
#
# HEF кладёт на хост шаг деплоя "[Vision Pi] Ensure HEF models"
# (download_retinaface_hef.sh, SHA256 прибит). Если файла нет, нода
# честно уходит в degraded и логирует причину (ADR-0018), а не падает.
FACE_HAILO_ENABLED=true
FACE_HEF_PATH=/opt/rob_box/models/retinaface_mobilenet_v1.hef

# ArcFace-узнавание лиц (ADR-0123, issue #2599 PR-B). Отдельная пара от
# FACE_HAILO_ENABLED/FACE_HEF_PATH выше: та управляет ДЕТЕКЦИЕЙ (RetinaFace),
# эта — УЗНАВАНИЕМ (ArcFace-эмбеддинг). HEF кладёт тот же шаг деплоя
# "[Vision Pi] Ensure HEF models" (запись arcface-hef в
# scripts/resource_pack/manifest.yaml, sha256 прибит). Отсутствие файла —
# degrade (детекция жива, узнавания нет), не fail-deploy.
FACE_ARCFACE_ENABLED=true
FACE_ARCFACE_HEF_PATH=/opt/rob_box/models/arcface_mobilefacenet.hef

# Хранилище лиц и режим приватности (ADR-0123 §2/§4-5). workshop — решение
# владельца от 16.09.2026 (см. заметку "face-privacy-workshop-mode"):
# эмбеддинги+снимки пишутся на диск для всех, включая незнакомцев. Порог
# узнавания НЕ откалиброван — стартовое значение.
FACE_STORE_ROOT=/data/faces
FACE_PRIVACY_MODE=workshop
FACE_IDENTIFY_THRESHOLD=0.45

# Test image tags will be:
# - ghcr.io/krikz/rob_box:voice-assistant-humble-test
# - ghcr.io/krikz/rob_box:oak-d-humble-test
# etc.
