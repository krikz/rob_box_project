# 🔒 API Keys для Voice Assistant и Internal Dialogue
# ⚠️ ВАЖНО: Скопируйте этот файл в .env.secrets и заполните реальными ключами!
#
# Команды:
#   cp .env.secrets.template .env.secrets
#   nano .env.secrets
#   docker compose config | grep -E "MIMO_API_KEY|DEEPSEEK_API_KEY|YANDEX"

# ============================================================
# LLM API Keys (для DialogueNode и ReflectionNode)
# ============================================================
# Система автоматического fallback: если один провайдер недоступен,
# автоматически переключается на другой (после 3 ошибок подряд)

# MiMo API Key (Xiaomi — основной провайдер)
# Где взять: https://mimo.mi.com/console/api-keys
# Формат: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MIMO_API_KEY=sk-your_mimo_api_key_here

# DeepSeek API Key (резервный провайдер для fallback)
# Где взять: https://platform.deepseek.com/api_keys
# Формат: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here

# Опционально: Унифицированный ключ (если используете один ключ для обоих)
# Приоритет: LLM_API_KEY → MIMO_API_KEY/DEEPSEEK_API_KEY (в зависимости от провайдера)
# LLM_API_KEY=sk-your_llm_api_key_here

# ============================================================
# Yandex Cloud API (для TTSNode - синтез речи)
# ============================================================

# Yandex Cloud API Key
# Где взять: https://console.cloud.yandex.ru/folders/<folder_id>/iam/service-accounts
# Формат: AQVNxxxxxxxxxxxxxxxxxxxxxxxx
YANDEX_API_KEY=your_yandex_api_key_here

# Yandex Cloud Folder ID
# Где взять: https://console.cloud.yandex.ru/ (в URL после /folders/)
# Формат: ajexxxxxxxxxxxxxxx
YANDEX_FOLDER_ID=your_yandex_folder_id_here

# ============================================================
# Telegram Bot (для TelegramNode - операторский интерфейс)
# ============================================================

# Telegram Bot Token
# Где взять: @BotFather в Telegram → /newbot
# Формат: 123456789:ABCdefGhIjKlMnOpQrStUvWxYz
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Список авторизованных Telegram chat ID (через запятую)
# Как узнать свой chat ID: отправьте /myid боту
# Формат: 123456789,987654321
TELEGRAM_ALLOWED_USERS=

# ============================================================
# MiniMax (для TTSNode - опциональный синтез речи через MiniMax T2A v2)
# ============================================================
# Использование: установить ROS-параметр tts_node.provider=minimax и
# заполнить оба ключа ниже. Без них MiniMax-провайдер не активируется,
# нода продолжит использовать Yandex gRPC + Silero.

# MiniMax API Key (Bearer-токен)
# Где взять: https://platform.MiniMax.io/user-center/basic-information/interface-key
# Формат: строка без префикса, например "eyJhbGciOi..."
MINIMAX_API_KEY=

# MiniMax Group ID
# Где взять: там же, в разделе "Account / Group"
# Формат: цифро-буквенный идентификатор
MINIMAX_GROUP_ID=
