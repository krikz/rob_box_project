{
  // Zenoh router config для тестового окружения
  // Минимальная конфигурация: только localhost, без внешних соединений
  mode: "router",
  
  listen: {
    endpoints: ["tcp/0.0.0.0:7447"]
  },
  
  // REST API для healthcheck
  plugins: {
    rest: {
      __required__: true,
      http_port: 8000
    }
  }
}
