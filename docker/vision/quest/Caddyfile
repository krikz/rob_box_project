# Caddyfile для Meta Quest WebXR-консоли (Phase 1.6, ADR-0027 §4.1)
#
# Lab-only self-signed TLS. Никакого ACME / certbot: 10.1.1.11 — приватный IP,
# 80-порт наружу не нужен. Cert генерируется на старте контейнера
# (см. start_quest.sh).
#
# Headers — собрано из:
#   - ADR-0027 §4.1 (Caddy выбран как HTTPS-стек)
#   - PR #33 microbbox (MERGED) — Permissions-Policy + flush_interval + TLS 1.2/1.3
#   - HSTS — обязателен для Quest-браузера: пока кэширует "только HTTPS"

{
    # auto_https off: мы отдаём TLS явно через tls /certs/...
    # (если оставить on — Caddy попытается обновить ACME и наломает дров)
    auto_https off

    # admin endpoint не нужен в продакшене: локальный контейнер на host network.
    admin off
}

:8443 {
    tls /certs/selfsigned.crt /certs/selfsigned.key {
        protocols tls1.2 tls1.3
    }

    # Безопасные заголовки для WebXR (PR #33 lessons) + снижение fingerprint.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Permissions-Policy "accelerometer=*, camera=*, gyroscope=*, magnetometer=*, xr-spatial-tracking=*"
        X-Content-Type-Options "nosniff"
        -Server
    }

    # Статический WebXR-клиент (Vite build из /srv/quest_static)
    root * /srv/quest_static
    encode gzip zstd
    file_server

    # Healthcheck endpoint — проксируем в aiohttp, который умеет /healthz.
    handle /healthz {
        reverse_proxy localhost:8765
    }

    # Всё остальное → aiohttp WSS-server (rob_box_quest).
    # flush_interval -1 — без буферизации, иначе WebSocket-фреймы JPEG/LiDAR
    # будут копиться в очереди Caddy и на Quest появится лаг.
    reverse_proxy localhost:8765 {
        flush_interval -1
        transport http {
            versions h2c 1.1
        }
    }
}
