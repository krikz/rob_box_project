+bool
+NavfnPlanner::pathTailBlocked(
+  const nav_msgs::msg::Path & path, std::string * reason) const
+{
+  // 253 = inscribed (COST_OBS_ROS): the lidar already marked a wall. Unknown
+  // beyond that wall is not "not yet explored" — NavFn drew through it.
+  // Unknown with no seen lethal/inscribed on the path stays allowed, so a goal
+  // in unscanned space with a free path to the known frontier still starts.
+  constexpr unsigned char kSeenWall = 253;
+  bool seen_wall = false;
+  bool unknown_after_wall = false;
+  double block_x = 0.0;
+  double block_y = 0.0;
+  unsigned int block_mx = 0;
+  unsigned int block_my = 0;
+  unsigned char block_cost = 0;
+  bool have_block = false;
+  for (const auto & pose : path.poses) {
+    unsigned int mx = 0;
+    unsigned int my = 0;
+    const double wx = pose.pose.position.x;
+    const double wy = pose.pose.position.y;
+    if (!costmap_->worldToMap(wx, wy, mx, my)) {
+      continue;
+    }
+    const unsigned char cost = costmap_->getCost(mx, my);
+    if (cost == nav2_costmap_2d::LETHAL_OBSTACLE) {
+      if (reason != nullptr) {
+        *reason =
+          std::string("refusing path whose tail is unknown or lethal beyond a seen wall")
+          + " world_x=" + std::to_string(wx)
+          + " world_y=" + std::to_string(wy)
+          + " mx=" + std::to_string(mx)
+          + " my=" + std::to_string(my)
+          + " cost=" + std::to_string(static_cast<int>(cost));
+      }
+      return true;
+    }
+    if (cost >= kSeenWall && cost != nav2_costmap_2d::NO_INFORMATION) {
+      seen_wall = true;
+    } else if (seen_wall && cost == nav2_costmap_2d::NO_INFORMATION) {
+      if (!have_block) {
+        block_x = wx;
+        block_y = wy;
+        block_mx = mx;
+        block_my = my;
+        block_cost = cost;
+        have_block = true;
+      }
+      unknown_after_wall = true;
+    }
+  }
+  if (unknown_after_wall && have_block && reason != nullptr) {
+    *reason =
+      std::string("refusing path whose tail is unknown or lethal beyond a seen wall")
+      + " world_x=" + std::to_string(block_x)
+      + " world_y=" + std::to_string(block_y)
+      + " mx=" + std::to_string(block_mx)
+      + " my=" + std::to_string(block_my)
+      + " cost=" + std::to_string(static_cast<int>(block_cost));
+  }
+  return unknown_after_wall;
+}
