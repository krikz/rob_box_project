+bool
+NavfnPlanner::pathTailBlocked(
+  const nav_msgs::msg::Path & path, std::string * reason) const
+{
+  // 253 = inscribed (COST_OBS_ROS): the lidar already marked a wall. Unknown
+  // beyond that wall is not "not yet explored" — NavFn drew through it.
+  // Unknown with no seen lethal/inscribed on the path stays allowed, so a goal
+  // in unscanned space with a free path to the known frontier still starts.
+  // Decision uses live getCost (rule unchanged). cost_navfn is the same cell on
+  // the char-map snapshot taken under lock at setCostmap (#4771 proof).
+  constexpr unsigned char kSeenWall = 253;
+  bool seen_wall = false;
+  bool unknown_after_wall = false;
+  double block_x = 0.0;
+  double block_y = 0.0;
+  unsigned int block_mx = 0;
+  unsigned int block_my = 0;
+  unsigned char block_cost_live = 0;
+  unsigned char block_cost_navfn = 0;
+  size_t block_index = 0;
+  bool have_block = false;
+  const char * block_branch = nullptr;
+  const size_t path_n = path.poses.size();
+
+  auto cost_navfn_at = [this](unsigned int mx, unsigned int my, unsigned char fallback)
+    -> unsigned char
+  {
+    if (!have_navfn_cost_snap_ || !navfn_cost_snap_ || navfn_cost_snap_nx_ == 0) {
+      return fallback;
+    }
+    if (mx >= navfn_cost_snap_nx_) {
+      return fallback;
+    }
+    const size_t idx =
+      static_cast<size_t>(my) * static_cast<size_t>(navfn_cost_snap_nx_) +
+      static_cast<size_t>(mx);
+    if (idx >= navfn_cost_snap_size_) {
+      return fallback;
+    }
+    return navfn_cost_snap_[idx];
+  };
+
+  auto path_xy_samples = [&path, path_n]() -> std::string
+  {
+    auto one = [](const geometry_msgs::msg::PoseStamped & ps) {
+      return std::to_string(ps.pose.position.x) + "," +
+             std::to_string(ps.pose.position.y);
+    };
+    std::string head;
+    std::string tail;
+    if (path_n <= 6) {
+      for (size_t i = 0; i < path_n; ++i) {
+        if (!head.empty()) {
+          head += ";";
+        }
+        head += one(path.poses[i]);
+      }
+    } else {
+      for (size_t i = 0; i < 3; ++i) {
+        if (!head.empty()) {
+          head += ";";
+        }
+        head += one(path.poses[i]);
+      }
+      for (size_t i = path_n - 3; i < path_n; ++i) {
+        if (!tail.empty()) {
+          tail += ";";
+        }
+        tail += one(path.poses[i]);
+      }
+    }
+    std::string out = " head_xy=" + head;
+    if (!tail.empty()) {
+      out += " tail_xy=" + tail;
+    }
+    return out;
+  };
+
+  auto fill_reason = [&](
+      const char * branch, double wx, double wy,
+      unsigned int mx, unsigned int my,
+      unsigned char cost_live, unsigned char cost_navfn, size_t index)
+  {
+    if (reason == nullptr) {
+      return;
+    }
+    *reason =
+      std::string("refusing path whose tail is unknown or lethal beyond a seen wall")
+      + " branch=" + branch
+      + " world_x=" + std::to_string(wx)
+      + " world_y=" + std::to_string(wy)
+      + " mx=" + std::to_string(mx)
+      + " my=" + std::to_string(my)
+      + " cost=" + std::to_string(static_cast<int>(cost_live))
+      + " cost_navfn=" + std::to_string(static_cast<int>(cost_navfn))
+      + " cost_live=" + std::to_string(static_cast<int>(cost_live))
+      + " path_n=" + std::to_string(path_n)
+      + " index=" + std::to_string(index)
+      + path_xy_samples();
+  };
+
+  for (size_t i = 0; i < path_n; ++i) {
+    const auto & pose = path.poses[i];
+    unsigned int mx = 0;
+    unsigned int my = 0;
+    const double wx = pose.pose.position.x;
+    const double wy = pose.pose.position.y;
+    if (!costmap_->worldToMap(wx, wy, mx, my)) {
+      continue;
+    }
+    // cost_live: what the refusal check reads after unlock (may race with layers).
+    const unsigned char cost_live = costmap_->getCost(mx, my);
+    const unsigned char cost_navfn = cost_navfn_at(mx, my, cost_live);
+    if (cost_live == nav2_costmap_2d::LETHAL_OBSTACLE) {
+      fill_reason(
+        "lethal_on_path", wx, wy, mx, my, cost_live, cost_navfn, i);
+      return true;
+    }
+    if (cost_live >= kSeenWall && cost_live != nav2_costmap_2d::NO_INFORMATION) {
+      seen_wall = true;
+    } else if (seen_wall && cost_live == nav2_costmap_2d::NO_INFORMATION) {
+      if (!have_block) {
+        block_x = wx;
+        block_y = wy;
+        block_mx = mx;
+        block_my = my;
+        block_cost_live = cost_live;
+        block_cost_navfn = cost_navfn;
+        block_index = i;
+        block_branch = "unknown_after_seen_wall";
+        have_block = true;
+      }
+      unknown_after_wall = true;
+    }
+  }
+  if (unknown_after_wall && have_block) {
+    fill_reason(
+      block_branch, block_x, block_y, block_mx, block_my,
+      block_cost_live, block_cost_navfn, block_index);
+  }
+  return unknown_after_wall;
+}
