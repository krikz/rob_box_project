+bool
+BehaviorServer::costmapCopyFresh() const
+{
+  if (!costmap_sub_ || !costmap_sub_->received()) {
+    return false;
+  }
+  double tolerance = 0.0;
+  get_parameter(kCostmapFreshnessParam, tolerance);
+  if (tolerance <= 0.0) {
+    return false;
+  }
+  const rclcpp::Time stamp = costmap_sub_->getStamp();
+  if (stamp.nanoseconds() == 0) {
+    return false;
+  }
+  return (now() - stamp).seconds() <= tolerance;
+}
+
+
+std::string
+BehaviorServer::costmapTickAction()
+{
+  if (costmapCopyFresh()) {
+    stale_costmap_skips_ = 0;
+    return "check";
+  }
+  stale_costmap_skips_++;
+  if (stale_costmap_skips_ <= kMaxStaleCostmapSkips) {
+    return "skip";
+  }
+  return "fail";
+}
