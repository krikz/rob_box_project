+bool
+BehaviorServer::costmapCopyFresh() const
+{
+  if (!costmap_sub_ || !costmap_sub_->received()) {
+    return false;
+  }
+  double tolerance = 0.0;
+  get_parameter(kCostmapFreshnessParam, tolerance);
+  if (tolerance <= 0.0) {
+    return false;
+  }
+  const rclcpp::Time stamp = costmap_sub_->getStamp();
+  if (stamp.nanoseconds() == 0) {
+    return false;
+  }
+  return (now() - stamp).seconds() <= tolerance;
+}
+
+
+nav2_behaviors::Status
+BehaviorServer::costmapTickStatusFor(const rclcpp_lifecycle::LifecycleNode::SharedPtr & node)
+{
+  auto * server = dynamic_cast<BehaviorServer *>(node.get());
+  if (server == nullptr) {
+    return nav2_behaviors::Status::SUCCEEDED;
+  }
+  return server->costmapTickStatus();
+}
+
+
+nav2_behaviors::Status
+BehaviorServer::costmapTickStatus() const
+{
+  if (costmapCopyFresh()) {
+    stale_costmap_skips_ = 0;
+    return nav2_behaviors::Status::SUCCEEDED;
+  }
+  stale_costmap_skips_++;
+  if (stale_costmap_skips_ <= kMaxStaleCostmapSkips) {
+    return nav2_behaviors::Status::RUNNING;
+  }
+  return nav2_behaviors::Status::FAILED;
+}
