+void
+Costmap2DROS::publishCostmapNow()
+{
+  // #5101: the clear service returns before the 5 Hz loop publishes, so the
+  // subscriber keeps the pre-clear copy. Publish the reset map here, under the
+  // same lock the loop uses, so the next collision check reads the cleared map.
+  if (costmap_publisher_ == nullptr || !layered_costmap_->isInitialized()) {
+    return;
+  }
+  std::scoped_lock<std::mutex> lock(_dynamic_parameter_mutex);
+  unsigned int x0, y0, xn, yn;
+  layered_costmap_->getBounds(&x0, &xn, &y0, &yn);
+  costmap_publisher_->updateBounds(x0, xn, y0, yn);
+  costmap_publisher_->publishCostmap();
+  last_publish_ = now();
+}
