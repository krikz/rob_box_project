+void ControllerServer::stuckAgainstReset()
+{
+  // controller_server is not a rclpy node: nothing else initializes Python.
+  if (!Py_IsInitialized()) {
+    Py_Initialize();
+  }
+  PyObject * module = PyImport_ImportModule("rob_box_teleop.stuck_against");
+  if (module == nullptr) {
+    PyErr_Clear();
+    return;
+  }
+  PyObject * fn = PyObject_GetAttrString(module, "reset_controller_state");
+  Py_DECREF(module);
+  if (fn == nullptr || !PyCallable_Check(fn)) {
+    PyErr_Clear();
+    Py_XDECREF(fn);
+    return;
+  }
+  PyObject * result = PyObject_CallObject(fn, nullptr);
+  Py_DECREF(fn);
+  Py_XDECREF(result);
+  PyErr_Clear();
+}
+
+bool ControllerServer::stuckAgainstObstacle(const geometry_msgs::msg::PoseStamped & pose)
+{
+  if (!have_last_cmd_) {
+    return false;
+  }
+  if (!Py_IsInitialized()) {
+    Py_Initialize();
+  }
+  auto * costmap = costmap_ros_->getCostmap();
+  std::unique_lock<nav2_costmap_2d::Costmap2D::mutex_t> lock(*(costmap->getMutex()));
+  const unsigned int size_x = costmap->getSizeInCellsX();
+  const unsigned int size_y = costmap->getSizeInCellsY();
+  const unsigned char * map = costmap->getCharMap();
+  const double resolution = costmap->getResolution();
+  double origin_x = 0.0;
+  double origin_y = 0.0;
+  costmap->mapToWorld(0, 0, origin_x, origin_y);
+  origin_x -= resolution / 2.0;
+  origin_y -= resolution / 2.0;
+  const unsigned char lethal = nav2_costmap_2d::INSCRIBED_INFLATED_OBSTACLE;
+
+  PyObject * module = PyImport_ImportModule("rob_box_teleop.stuck_against");
+  if (module == nullptr) {
+    PyErr_Clear();
+    return false;
+  }
+  PyObject * fn = PyObject_GetAttrString(module, "controller_stuck");
+  Py_DECREF(module);
+  if (fn == nullptr || !PyCallable_Check(fn)) {
+    PyErr_Clear();
+    Py_XDECREF(fn);
+    return false;
+  }
+  PyObject * costs = PyList_New(static_cast<Py_ssize_t>(size_x) * size_y);
+  if (costs == nullptr) {
+    Py_DECREF(fn);
+    return false;
+  }
+  for (unsigned int i = 0; i < size_x * size_y; ++i) {
+    PyList_SET_ITEM(costs, i, PyLong_FromLong(map[i] >= lethal ? lethal : 0));
+  }
+  lock.unlock();
+  PyObject * result = PyObject_CallFunction(
+    fn, "dddddddiOi",
+    now().seconds(), pose.pose.position.x, pose.pose.position.y,
+    last_cmd_vel_.linear.x, last_cmd_vel_.angular.z,
+    origin_x, origin_y, resolution,
+    static_cast<int>(size_x), costs, static_cast<int>(size_y));
+  Py_DECREF(costs);
+  Py_DECREF(fn);
+  if (result == nullptr) {
+    PyErr_Clear();
+    return false;
+  }
+  const bool stuck = PyObject_IsTrue(result) == 1;
+  Py_DECREF(result);
+  return stuck;
+}
