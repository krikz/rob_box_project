+
+void ControllerServer::stuckAgainstInit()
+{
+  // #5003: CPython must be initialized from the main thread, before spin.
+  // Called once from main(). The action-server thread must not call Py_Initialize.
+  if (Py_IsInitialized()) {
+    return;
+  }
+  Py_Initialize();
+}
+
+void ControllerServer::stuckAgainstWarnOnce(const char * why)
+{
+  // A failed import must not look like "the fix is in and the base is free".
+  static bool warned = false;
+  if (warned) {
+    return;
+  }
+  warned = true;
+  RCLCPP_WARN(
+    get_logger(),
+    "stuck-against progress check unavailable, not applied: %s", why);
+}
+
+void ControllerServer::stuckAgainstReset()
+{
+  if (!Py_IsInitialized()) {
+    stuckAgainstWarnOnce("Python was not initialized from main");
+    return;
+  }
+  PyGILState_STATE gil = PyGILState_Ensure();
+  PyObject * module = PyImport_ImportModule("rob_box_teleop.stuck_against");
+  if (module == nullptr) {
+    PyObject * type = nullptr;
+    PyObject * value = nullptr;
+    PyObject * trace = nullptr;
+    PyErr_Fetch(&type, &value, &trace);
+    PyObject * text = value != nullptr ? PyObject_Str(value) : nullptr;
+    const char * why = text != nullptr ? PyUnicode_AsUTF8(text) : "import failed";
+    stuckAgainstWarnOnce(why != nullptr ? why : "import failed");
+    Py_XDECREF(text);
+    Py_XDECREF(type);
+    Py_XDECREF(value);
+    Py_XDECREF(trace);
+    PyGILState_Release(gil);
+    return;
+  }
+  PyObject * fn = PyObject_GetAttrString(module, "reset_controller_state");
+  Py_DECREF(module);
+  if (fn == nullptr || !PyCallable_Check(fn)) {
+    PyErr_Clear();
+    Py_XDECREF(fn);
+    stuckAgainstWarnOnce("reset_controller_state is missing");
+    PyGILState_Release(gil);
+    return;
+  }
+  PyObject * result = PyObject_CallObject(fn, nullptr);
+  Py_DECREF(fn);
+  if (result == nullptr) {
+    PyErr_Clear();
+    stuckAgainstWarnOnce("reset_controller_state raised");
+  }
+  Py_XDECREF(result);
+  PyGILState_Release(gil);
+}
+
+bool ControllerServer::stuckAgainstObstacle(const geometry_msgs::msg::PoseStamped & pose)
+{
+  if (!have_last_cmd_) {
+    return false;
+  }
+  if (!Py_IsInitialized()) {
+    stuckAgainstWarnOnce("Python was not initialized from main");
+    return false;
+  }
+  auto * costmap = costmap_ros_->getCostmap();
+  std::unique_lock<nav2_costmap_2d::Costmap2D::mutex_t> lock(*(costmap->getMutex()));
+  const unsigned int size_x = costmap->getSizeInCellsX();
+  const unsigned int size_y = costmap->getSizeInCellsY();
+  const unsigned char * map = costmap->getCharMap();
+  const double resolution = costmap->getResolution();
+  double origin_x = 0.0;
+  double origin_y = 0.0;
+  // mapToWorld(0, 0) is the centre of cell 0. The criterion indexes cells by
+  // their corner, so shift back half a cell. map[i] >= INSCRIBED (253) is the
+  // block: inscribed and lethal, not the inflation below that.
+  costmap->mapToWorld(0, 0, origin_x, origin_y);
+  origin_x -= resolution / 2.0;
+  origin_y -= resolution / 2.0;
+  const unsigned char lethal = nav2_costmap_2d::INSCRIBED_INFLATED_OBSTACLE;
+
+  PyGILState_STATE gil = PyGILState_Ensure();
+  PyObject * module = PyImport_ImportModule("rob_box_teleop.stuck_against");
+  if (module == nullptr) {
+    PyObject * type = nullptr;
+    PyObject * value = nullptr;
+    PyObject * trace = nullptr;
+    PyErr_Fetch(&type, &value, &trace);
+    PyObject * text = value != nullptr ? PyObject_Str(value) : nullptr;
+    const char * why = text != nullptr ? PyUnicode_AsUTF8(text) : "import failed";
+    stuckAgainstWarnOnce(why != nullptr ? why : "import failed");
+    Py_XDECREF(text);
+    Py_XDECREF(type);
+    Py_XDECREF(value);
+    Py_XDECREF(trace);
+    PyGILState_Release(gil);
+    return false;
+  }
+  PyObject * fn = PyObject_GetAttrString(module, "controller_stuck");
+  Py_DECREF(module);
+  if (fn == nullptr || !PyCallable_Check(fn)) {
+    PyErr_Clear();
+    Py_XDECREF(fn);
+    stuckAgainstWarnOnce("controller_stuck is missing");
+    PyGILState_Release(gil);
+    return false;
+  }
+  PyObject * costs = PyList_New(static_cast<Py_ssize_t>(size_x) * size_y);
+  if (costs == nullptr) {
+    Py_DECREF(fn);
+    stuckAgainstWarnOnce("could not allocate the cost list");
+    PyGILState_Release(gil);
+    return false;
+  }
+  for (unsigned int i = 0; i < size_x * size_y; ++i) {
+    PyList_SET_ITEM(costs, i, PyLong_FromLong(map[i] >= lethal ? lethal : 0));
+  }
+  lock.unlock();
+  PyObject * result = PyObject_CallFunction(
+    fn, "dddddddiOi",
+    now().seconds(), pose.pose.position.x, pose.pose.position.y,
+    last_cmd_vel_.linear.x, last_cmd_vel_.angular.z,
+    origin_x, origin_y, resolution,
+    static_cast<int>(size_x), costs, static_cast<int>(size_y));
+  Py_DECREF(costs);
+  Py_DECREF(fn);
+  if (result == nullptr) {
+    PyErr_Clear();
+    stuckAgainstWarnOnce("controller_stuck raised");
+    PyGILState_Release(gil);
+    return false;
+  }
+  const bool stuck = PyObject_IsTrue(result) == 1;
+  Py_DECREF(result);
+  PyGILState_Release(gil);
+  return stuck;
+}
