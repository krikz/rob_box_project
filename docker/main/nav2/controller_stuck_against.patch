+void ControllerServer::stuckAgainstReset()
+{
+  stuck_samples_.clear();
+  stuck_cmd_since_ = -1.0;
+  stuck_last_course_ = 0.0;
+  stuck_last_course_time_ = -1.0;
+}
+
+bool ControllerServer::stuckAgainstCourseBlocked(
+  double course_vx, double robot_x, double robot_y, double robot_yaw) const
+{
+  // Strip ahead of the body edge, out to the guard corridor stop
+  // (proximity stop_m, 0.20 m), not the side-touch gap (0.08 m) and not
+  // the body itself. The guard holds a stop while a command still pushes
+  // into an obstacle inside 0.20 m, so an 0.08 m strip in front of the
+  // nose is empty and the failure stays silent (HIL 22.11). Only
+  // lethal/inscribed counts: inflation alone is not a wall. The strip is
+  // in base_footprint. The local costmap lives in odom (nav2_params.yaml
+  // global_frame), so a cell is on the course only after its centre is
+  // turned back into the body frame. Reading the body metres as map-cell
+  // coordinates looks near the map origin and misses the wall in front of
+  // the robot (#5003, Gate 2 21.11: Running backup = 0).
+  // Course is the sign of the last non-zero vx. A zero course has no
+  // direction, so the map cannot call this a block.
+  constexpr double kCmdEps = 0.03;
+  constexpr double kBlockGapM = 0.20;
+  constexpr double kXMax = 0.3064;
+  constexpr double kXMin = -0.3036;
+  constexpr double kYMax = 0.3025;
+  constexpr double kYMin = -0.3025;
+  if (std::abs(course_vx) <= kCmdEps) {
+    return false;
+  }
+  auto * costmap = costmap_ros_->getCostmap();
+  std::unique_lock<nav2_costmap_2d::Costmap2D::mutex_t> lock(*(costmap->getMutex()));
+  const double resolution = costmap->getResolution();
+  if (resolution <= 0.0) {
+    return false;
+  }
+  const bool forward = course_vx > 0.0;
+  const double edge = forward ? kXMax : kXMin;
+  const double cos_yaw = std::cos(robot_yaw);
+  const double sin_yaw = std::sin(robot_yaw);
+  const double step = resolution / 2.0;
+  const double reach = forward ? edge + kBlockGapM : edge - kBlockGapM;
+  const unsigned char lethal = nav2_costmap_2d::INSCRIBED_INFLATED_OBSTACLE;
+  for (double bx = std::min(edge, reach); bx <= std::max(edge, reach) + 1e-9; bx += step) {
+    for (double by = kYMin; by <= kYMax + 1e-9; by += step) {
+      const double wx = robot_x + bx * cos_yaw - by * sin_yaw;
+      const double wy = robot_y + bx * sin_yaw + by * cos_yaw;
+      unsigned int mx = 0;
+      unsigned int my = 0;
+      if (!costmap->worldToMap(wx, wy, mx, my)) {
+        continue;
+      }
+      double cx = 0.0;
+      double cy = 0.0;
+      costmap->mapToWorld(mx, my, cx, cy);
+      const double dx = cx - robot_x;
+      const double dy = cy - robot_y;
+      const double local_x = dx * cos_yaw + dy * sin_yaw;
+      const double local_y = -dx * sin_yaw + dy * cos_yaw;
+      if (forward && local_x <= edge) {
+        continue;
+      }
+      if (!forward && local_x >= edge) {
+        continue;
+      }
+      if (std::abs(local_x - edge) > kBlockGapM) {
+        continue;
+      }
+      if (local_y < kYMin || local_y > kYMax) {
+        continue;
+      }
+      if (costmap->getCost(mx, my) >= lethal) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+bool ControllerServer::stuckAgainstObstacle(const geometry_msgs::msg::PoseStamped & pose)
+{
+  // Window of 2 s (shorter than the 30 s radius allowance, else a wall slide
+  // accumulates the radius), command held 0.3 s above the guard epsilon,
+  // displacement under required_movement_radius.
+  constexpr double kWindowS = 2.0;
+  constexpr double kCmdHoldS = 0.3;
+  constexpr double kCmdEps = 0.03;
+  constexpr double kProgressRadiusM = 0.08;
+  if (!have_last_cmd_) {
+    return false;
+  }
+  const double now_s = now().seconds();
+  // A gap longer than the command hold cannot establish a continuous observation.
+  if (!stuck_samples_.empty()) {
+    const double dt = now_s - stuck_samples_.back().t;
+    if (dt < 0.0 || dt > kCmdHoldS) {
+      stuckAgainstReset();
+    }
+  }
+  const double vx = last_cmd_vel_.linear.x;
+  const double wz = last_cmd_vel_.angular.z;
+  const bool commanded = std::abs(vx) > kCmdEps || std::abs(wz) > kCmdEps;
+  if (commanded) {
+    if (stuck_cmd_since_ < 0.0) {
+      stuck_cmd_since_ = now_s;
+    }
+  } else {
+    stuck_cmd_since_ = -1.0;
+  }
+  const bool held =
+    commanded && stuck_cmd_since_ >= 0.0 && now_s - stuck_cmd_since_ >= kCmdHoldS;
+  stuck_samples_.push_back(
+    StuckSample{now_s, pose.pose.position.x, pose.pose.position.y, held});
+  const double cutoff = now_s - kWindowS;
+  // Keep the last pose at or before the boundary, even between controller ticks.
+  size_t anchor = 0;
+  while (anchor + 1 < stuck_samples_.size() && stuck_samples_[anchor + 1].t <= cutoff) {
+    ++anchor;
+  }
+  stuck_samples_.erase(stuck_samples_.begin(), stuck_samples_.begin() + anchor);
+  if (std::abs(vx) > kCmdEps) {
+    stuck_last_course_ = vx;
+    stuck_last_course_time_ = now_s;
+  }
+  if (stuck_samples_.size() < 2) {
+    return false;
+  }
+  const StuckSample & start = stuck_samples_.front();
+  if (start.t > cutoff) {
+    return false;
+  }
+  bool any_held = false;
+  bool moved = false;
+  for (const StuckSample & sample : stuck_samples_) {
+    any_held = any_held || (sample.held && sample.t >= cutoff);
+    const double dx = sample.x - start.x;
+    const double dy = sample.y - start.y;
+    if (std::hypot(dx, dy) > kProgressRadiusM) {
+      moved = true;
+    }
+  }
+  if (!any_held || moved || stuck_last_course_time_ < cutoff) {
+    return false;
+  }
+  const double yaw = tf2::getYaw(pose.pose.orientation);
+  return stuckAgainstCourseBlocked(
+    stuck_last_course_, pose.pose.position.x, pose.pose.position.y, yaw);
+}
