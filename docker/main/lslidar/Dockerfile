# LSLIDAR N10 Driver ??? ROS 2 kilted
# ?????????? ??????? ????? PCL ? ?????????????????? ????????????? ??? ??????? ?????
# ????????? ??????: docker build --build-arg BASE_IMAGE=rob_box_base:pcl
ARG BASE_IMAGE=ghcr.io/krikz/rob_box_base:pcl
FROM ${BASE_IMAGE}

# ??? ??????????? ?????? (rmw-zenoh-cpp, PCL, diagnostic-updater, libpcap, boost)
# ??? ??????????? ? ??????? ??????

# ????????????? ?????????????? ??????????? ??? ?????? lslidar ????????
RUN apt-get update && apt-get install -y \
    ros-kilted-rosidl-default-generators \
    ros-kilted-rosidl-default-runtime \
    ros-kilted-builtin-interfaces \
    ros-kilted-std-msgs \
    ros-kilted-sensor-msgs \
    ros-kilted-ament-cmake \
    libboost-dev \
    libboost-thread-dev \
    && rm -rf /var/lib/apt/lists/*

# ??????? ??????? ????????????
WORKDIR /ws/src

# ????????? LSLIDAR N10 ??????? (????? M10P/N10P ??? N10)
RUN git clone --depth 1 -b M10P/N10P https://github.com/Lslidar/lslidar_ros2_driver.git

# ???????? ??? ?????? ?? ???????????
# ?????: ??????? ? ??????? ?? ?????????? ? ?????!
# ??? ??????????? ????? volumes ? docker-compose.yaml:
# - ./config:/config/shared:ro (????? ???????: zenoh, cyclonedds)
# - ./lslidar/config:/config/lslidar:ro (??????? lslidar)
# - ./lslidar/scripts:/scripts:ro (?????? ???????)
WORKDIR /ws
SHELL ["/bin/bash", "-c"]
RUN source /opt/ros/kilted/setup.bash && \
    colcon build --symlink-install --parallel-workers 1 --executor sequential

# Entrypoint ??????????? ?? volume: /scripts/start_lslidar.sh
CMD ["/scripts/start_lslidar.sh"]
