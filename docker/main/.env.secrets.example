# API Keys and Secrets for Main Pi Services
# Copy this file to .env.secrets and fill in your actual keys
# WARNING: Never commit .env.secrets to git!

# ============================================================
# LLM API Keys (для Perception/Reflection Node)
# ============================================================
# Система автоматического fallback: если один провайдер недоступен,
# автоматически переключается на другой (после 3 ошибок подряд)

# Qwen API Key (основной провайдер по умолчанию)
# Где взять: https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=sk-your-qwen-api-key-here

# DeepSeek API Key (резервный провайдер для fallback)
# Где взять: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Опционально: Унифицированный ключ (если используете один ключ для обоих)
# LLM_API_KEY=sk-your-llm-api-key-here
