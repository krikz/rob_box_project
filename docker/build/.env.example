# Build Machine Environment Variables
# Копируйте в .env и настройте под свою среду

# IP адрес build машины в локальной сети
BUILD_MACHINE_IP=10.1.1.5

# Порты сервисов (по умолчанию)
REGISTRY_PORT=5000
APT_CACHE_PORT=3142
REGISTRY_UI_PORT=8080
PORTAINER_PORT=9000

# Docker Registry настройки
REGISTRY_STORAGE_PATH=./data/registry
REGISTRY_DELETE_ENABLED=true

# APT Cache настройки
APT_CACHE_DIR=./data/apt-cache

# GitHub Runner настройки
RUNNER_WORKDIR=./data/runner/_work
