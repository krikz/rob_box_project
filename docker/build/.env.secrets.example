# GitHub Actions Runner Secrets
# ВАЖНО: Не коммитить в git! Добавлено в .gitignore

# GitHub Personal Access Token с правами:
# - repo (full control)
# - workflow (update GitHub Action workflows)
# Создать: https://github.com/settings/tokens/new
GITHUB_TOKEN=ghp_your_token_here

# GitHub настройки
GITHUB_OWNER=krikz
GITHUB_REPO=rob_box_project

# Опциональные настройки
# RUNNER_NAME=rob-box-build-machine
# RUNNER_GROUP=default
# LABELS=self-hosted,Linux,ARM64,rob-box
