# Студия канала @robbox_project — шаблон окружения.
# Скопируй в .env.secrets на машине студии и заполни значения. Сам .env.secrets в git НЕ попадает
# (docker/studio/.gitignore), шаблон с плейсхолдерами — попадает.

# Токен бота студии от @BotFather. Бот должен быть администратором канала @robbox_project
# с правом публикации. Токен бота робота (@krobbox_bot) НЕ подходит: студия ловит апдейты
# этим ботом, и пульт робота сломается.
TG_STUDIO_BOT_TOKEN=

# Личка Шифу: туда студия шлёт идеи, черновики и вопросы, там же кнопки.
TG_SHIFU_CHAT_ID=495039871

# Канал проекта.
TG_CHANNEL_ID=-1004323185327

# Ключ MiniMax: текст постов (MiniMax-M3) и фоны картинок (image-01).
MINIMAX_API_KEY=

# Токен GitHub. В брифе указан fine-grained только на чтение — так и нужно сделать:
# Settings → Developer settings → Personal access tokens → Fine-grained, доступ Read-only
# к krikz/rob_box_project, krikz/ros2leds, krikz/vesc_nexus.
#
# ВНИМАНИЕ: classic-токен gh (ghp_...) из `gh auth status` имеет scope `repo`,
# то есть пишет в репозитории. Для студии, которая только читает, он избыточен:
# при утечке с ним можно залить в репозиторий. Поэтому отдельный fine-grained.
GH_TOKEN=
