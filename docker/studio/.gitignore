# Секреты студии — никогда в git.
# Корневой .gitignore переигноривает .env правилом `!docker/*/.env`, поэтому
# здесь правило возвращается: токен бота студии и ключи лежат только на машине.
.env
.env.secrets

# Состояние студии: смещение getUpdates, идеи, статусы постов — локальное.
state.json
# Файл блокировки состояния (flock): он создаётся рядом со state.json.
state.json.lock

# Рабочие файлы сессии анализа: факты, идеи, отфильтрованный список на отправку.
run/
ideas_to_send.json
