# Docker configuration for MAIN branch (production)
# This file is automatically loaded when deploying from main branch

ROS_DISTRO=humble
IMAGE_TAG=latest
REGISTRY=ghcr.io
REPOSITORY_OWNER=krikz
BASE_IMAGE_PREFIX=${REGISTRY}/${REPOSITORY_OWNER}/rob_box_base
SERVICE_IMAGE_PREFIX=${REGISTRY}/${REPOSITORY_OWNER}/rob_box

# Robot ID for namespace isolation
ROBOT_ID=RBXU100001

# Zenoh router IPs (FA-4: parametrized instead of hardcoded in configs)
ZENOH_MAIN_PI_IP=10.1.1.10
ZENOH_CLOUD_ROUTER=tcp/zenoh.robbox.online:7447

# Production image tags will be:
# - ghcr.io/krikz/rob_box:voice-assistant-humble-latest
# - ghcr.io/krikz/rob_box:oak-d-humble-latest
# etc.
