# Docker configuration for DEVELOP branch — Sound Pi (ADR-0159)
# This file is automatically loaded when deploying from develop branch

ROS_DISTRO=humble
#IMAGE_TAG=test
#REGISTRY=ghcr.io
IMAGE_TAG=dev
REGISTRY=10.1.1.249:5000
REPOSITORY_OWNER=krikz
BASE_IMAGE_PREFIX=${REGISTRY}/${REPOSITORY_OWNER}/rob_box_base
SERVICE_IMAGE_PREFIX=${REGISTRY}/${REPOSITORY_OWNER}/rob_box

# Robot ID for namespace isolation
ROBOT_ID=RBXU100001

# Monitoring configuration
# Set to IP address or hostname of the monitoring machine
LOKI_HOST=10.1.1.249

# Узловые адреса (дефолты те же заданы в docker-compose.yaml; здесь — чтобы
# менять в одном месте). ZENOH_LISTEN_IP — адрес eth0 этого Pi;
# ZENOH_CONNECT_ENDPOINTS — линки роутера (ADR-0159 §2.2, вариант Б).
# ZENOH_LISTEN_IP=10.1.1.12
# ZENOH_CONNECT_ENDPOINTS=tcp/10.1.1.10:7447#iface=eth0,tcp/10.1.1.11:7447#iface=eth0

# ollama остался на Vision Pi (profile ai) — VoiceMemory ходит туда по сети.
# OLLAMA_HOST_URL=http://10.1.1.11:11434
