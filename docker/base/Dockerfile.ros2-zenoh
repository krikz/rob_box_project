# Базовый образ ROS 2 Humble + Zenoh
# Общая база для всех контейнеров проекта, которые не требуют специализированных пакетов
FROM ros:humble-ros-base

# Build arguments
#   APT_PROXY        — адрес apt-cacher-ng (опциональный)
#   RMW_ZENOH_VENDOR — true: использовать локальные .deb для ARM64 или AMD64 из vendor/.
#                      false: установить из официального репозитория ROS APT.
ARG APT_PROXY=""
ARG RMW_ZENOH_VENDOR=true

# Настройка APT прокси если указан и доступен
# Проверяем доступность прокси перед настройкой
RUN if [ -n "$APT_PROXY" ]; then \
        PROXY_HOST=$(echo "$APT_PROXY" | sed 's|.*://\([^:/]*\).*|\1|'); \
        PROXY_PORT=$(echo "$APT_PROXY" | sed 's|.*://[^:]*:\([0-9]*\).*|\1|'); \
        echo "🔍 Checking proxy availability at $PROXY_HOST:$PROXY_PORT..."; \
        if timeout 5 bash -c "cat < /dev/null > /dev/tcp/$PROXY_HOST/$PROXY_PORT" 2>/dev/null; then \
            echo "Acquire::http::Proxy \"$APT_PROXY\";" > /etc/apt/apt.conf.d/02proxy; \
            echo "Acquire::http::Timeout \"10\";" >> /etc/apt/apt.conf.d/02proxy; \
            echo "Acquire::Retries \"3\";" >> /etc/apt/apt.conf.d/02proxy; \
            # Pipeline-Depth 0 обязателен под qemu: с включённым
            # конвейером (по умолчанию 10 и у apt, и у apt-cacher-ng)
            # метод apt зависает намертво. Поймано 21.09.2026 на katana:
            # apt-get висел 68 минут с НУЛЁМ секунд CPU, два сокета к
            # прокси в CLOSE-WAIT с Recv-Q=1, процесс
            # qemu-binfmt/aarch64 /usr/lib/apt/methods/store — живой, но
            # ничего не делает.
            echo "Acquire::http::Pipeline-Depth \"0\";" >> /etc/apt/apt.conf.d/02proxy; \
            echo "✅ Using APT proxy: $APT_PROXY"; \
        else \
            echo "⚠️  APT proxy not accessible, will use direct connection"; \
        fi \
    fi

# Установка Zenoh middleware и минимальных зависимостей.
# Issue #5242: фиксируем RMW на 0.1.11 (Zenoh 1.10.1 с исправлениями).
COPY vendor/. /tmp/rmw-zenoh-vendor/
RUN set -eux; \
    arch=$(dpkg --print-architecture); \
    case "$arch" in \
      arm64) rmw_version=0.1.11-1jammy.20261106.124730; vendor_version=0.1.11-1jammy.20261027.195405;; \
      amd64) rmw_version=0.1.11-1jammy.20261105.191826; vendor_version=0.1.11-1jammy.20261031.173316;; \
      *) echo "unsupported arch: $arch" >&2; exit 1;; \
    esac; \
    # true: dpkg -i, не apt-get install путей. apt видит тот же пакет в ROS APT
    # и качает его с CDN вместо локального файла (Hash Sum mismatch, #5245).
    # Тот же блок — Dockerfile.depthai и Dockerfile.rtabmap.
    case "$RMW_ZENOH_VENDOR" in \
      true) \
        vnd_deb="/tmp/rmw-zenoh-vendor/ros-humble-zenoh-cpp-vendor_${vendor_version}_${arch}.deb"; \
        rmw_deb="/tmp/rmw-zenoh-vendor/ros-humble-rmw-zenoh-cpp_${rmw_version}_${arch}.deb"; \
        if [ ! -f "$vnd_deb" ] || [ ! -f "$rmw_deb" ]; then \
          echo "Missing vendored Zenoh .deb for $arch (RMW_ZENOH_VENDOR=false uses ROS APT)" >&2; \
          exit 1; \
        fi; \
        apt-get update; \
        apt-get install -y curl ca-certificates; \
        dpkg -i "$vnd_deb" "$rmw_deb" || apt-get install -y -f; \
        apt-get install -y git wget python3-pip;; \
      false) \
        apt-get update; \
        apt-get install -y curl ca-certificates; \
        apt-get install -y 'ros-humble-rmw-zenoh-cpp=0.1.11-1jammy.*' 'ros-humble-zenoh-cpp-vendor=0.1.11-1jammy.*' git wget python3-pip;; \
      *) echo "RMW_ZENOH_VENDOR must be true or false" >&2; exit 1;; \
    esac; \
    rm -rf /tmp/rmw-zenoh-vendor /var/lib/apt/lists/*

# Удаляем APT прокси конфигурацию после установки пакетов
RUN rm -f /etc/apt/apt.conf.d/02proxy

# Устанавливаем переменные окружения для Zenoh по умолчанию
ENV RMW_IMPLEMENTATION=rmw_zenoh_cpp \
    ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    RUST_LOG=zenoh=info \
    LD_LIBRARY_PATH=/opt/ros/humble/opt/zenoh_cpp_vendor/lib:/opt/ros/humble/lib/aarch64-linux-gnu:/opt/ros/humble/lib

# Метаданные образа
LABEL maintainer="rob_box_project" \
      description="Base ROS 2 Humble + Zenoh image" \
      version="1.0"
