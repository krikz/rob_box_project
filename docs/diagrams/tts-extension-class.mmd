    %% ============================================================
    %% Composition root — registry / factory / builder callback
    %% ============================================================

    class TTSProviderRegistry {
        <<NEW composition root, proposed>>
        -_builders: dict~str, ProviderBuilder~
        +register(name, builder) void
        +resolve(name) ProviderBuilder
        +names() list~str~
    }

    class TTSProviderFactory {
        <<NEW composition root, proposed>>
        -_cache: dict~tuple, BaseTTSProvider~
        +create(name, config, registry) BaseTTSProvider
    }

    class ProviderBuilder {
        <<NEW callback type, proposed>>
        +__call__(config) BaseTTSProvider
    }

    class register_builtin_tts_providers {
        <<NEW composition root, proposed>>
        +register() TTSProviderRegistry
    }

