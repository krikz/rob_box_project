/// Конфигурация Zenoh роутера для облачного развертывания
/// Этот файл должен использоваться на zenoh.robbox.online
///
/// КРИТИЧНО: Режим "router" для полной маршрутизации между клиентами
/// 
/// Применение:
///   zenohd -c zenoh_router_config.json5
///
{
  /// ========================================
  /// РЕЖИМ РАБОТЫ
  /// ========================================
  /// ✅ ROUTER - полная маршрутизация между всеми подключенными клиентами
  /// НЕ используйте "peer" - он не маршрутизирует между клиентами!
  mode: "router",

  /// ========================================
  /// ПОДКЛЮЧЕНИЯ
  /// ========================================
  /// Облачный роутер обычно не подключается к другим роутерам
  /// Только слушает входящие подключения
  connect: {
    endpoints: [],
  },

  /// ========================================
  /// ПРОСЛУШИВАНИЕ
  /// ========================================
  /// Слушаем на всех интерфейсах на стандартном порту
  listen: {
    timeout_ms: 0,
    endpoints: [
      "tcp/0.0.0.0:7447",  // Основной TCP endpoint
    ],
    exit_on_failure: true,
  },

  /// ========================================
  /// SCOUTING (ОБНАРУЖЕНИЕ)
  /// ========================================
  /// Отключаем multicast в облачном окружении
  scouting: {
    multicast: {
      enabled: false,
    },
    gossip: {
      enabled: true,
      multihop: false,
    },
  },

  /// ========================================
  /// TIMESTAMPING
  /// ========================================
  /// Включено для ROS топиков (требуется для transient_local durability)
  timestamping: {
    enabled: {
      router: true,
      peer: true,
      client: true,
    },
    drop_future_timestamp: false,
  },

  /// ========================================
  /// МАРШРУТИЗАЦИЯ
  /// ========================================
  routing: {
    router: {
      /// ✅ КРИТИЧНО: Включаем failover brokering
      /// Роутер будет пересылать данные между peers, которые не соединены напрямую
      /// Это необходимо для маршрутизации от REST API к роботам
      peers_failover_brokering: true,
    },
  },

  /// ========================================
  /// TRANSPORT ПАРАМЕТРЫ
  /// ========================================
  transport: {
    unicast: {
      /// Таймауты для облачного окружения
      open_timeout: 30000,     // 30 секунд
      accept_timeout: 30000,   // 30 секунд
      accept_pending: 1000,    // Большое количество для множества роботов
      max_sessions: 1000,      // Поддержка до 1000 роботов
      max_links: 1,
      
      qos: {
        enabled: true,
      },
      
      compression: {
        enabled: false,  // Можно включить для экономии трафика
      },
    },
    
    link: {
      tx: {
        sequence_number_resolution: "32bit",
        /// Lease для облачных соединений (может быть нестабильная сеть)
        lease: 120000,  // 2 минуты
        keep_alive: 4,  // Отправлять keep-alive каждые 30 секунд
        batch_size: 65535,
      },
      rx: {
        buffer_size: 65535,
        max_message_size: 1073741824,  // 1GB
      },
    },
  },

  /// ========================================
  /// ПЛАГИНЫ
  /// ========================================
  plugins: {
    /// REST API плагин для веб доступа
    rest: {
      /// HTTP порт для REST API
      http_port: 8000,
    },

    /// ========================================
    /// DDS ПЛАГИН (РЕКОМЕНДУЕТСЯ ДЛЯ ROS)
    /// ========================================
    /// Этот плагин автоматически транслирует между DDS (ROS) и Zenoh
    /// ВАЖНО: Раньше это использовалось и работало!
    /// 
    /// Установка:
    ///   cargo install zenoh-plugin-dds
    /// 
    /// Преимущества:
    ///   - Автоматическая конвертация DDS ↔ Zenoh
    ///   - Правильная обработка ROS типов сообщений
    ///   - Нет необходимости в дополнительных мостах
    ///
    /// Раскомментируйте для использования:
    // dds: {
    //   /// ROS Domain ID для bridge
    //   domain: 0,
    //   
    //   /// Режим: "peer" или "client"
    //   mode: "peer",
    //   
    //   /// Разрешить все топики или указать конкретные
    //   allow: {
    //     /// Разрешить все топики (не рекомендуется для production)
    //     // topics: ["**"],
    //     
    //     /// Или указать конкретные топики для команд
    //     topics: [
    //       "cmd_vel_voice",
    //       "cmd_vel_web",
    //       "cmd_vel_joy",
    //     ],
    //   },
    //   
    //   /// Опционально: запретить определённые топики
    //   // deny: {
    //   //   topics: ["internal/**"],
    //   // },
    // },

    /// Storage Manager для сохранения истории топиков
    /// ВНИМАНИЕ: Storage НЕ заменяет маршрутизацию!
    /// Он только сохраняет последние значения для запросов GET
    storage_manager: {
      storages: {
        /// Хранилище для всех данных роботов
        robot_data: {
          /// Паттерн ключей для хранения
          key_expr: "robots/**",
          
          /// Тип хранилища - в памяти (быстро, но не персистентно)
          volume: {
            id: "memory",
          },
          
          /// Опционально: можно добавить персистентное хранилище
          // volume: {
          //   id: "rocksdb",
          //   db_path: "/var/lib/zenoh/db",
          // },
        },
      },
    },
  },

  /// ========================================
  /// ADMIN SPACE
  /// ========================================
  /// Включаем для мониторинга через REST API
  adminspace: {
    enabled: true,
    permissions: {
      read: true,
      write: false,  // Только чтение для безопасности
    },
  },
}
