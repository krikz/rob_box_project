# Конфигурация версий для Docker образов РОББОКС
# Используйте этот файл для управления версиями ROS 2 и тегами образов

# =============================================================================
# ВЕРСИЯ ROS 2
# =============================================================================
# Текущая версия ROS 2 (lyrical, jazzy, kilted, и т.д.)
ROS_DISTRO=lyrical

# =============================================================================
# ТЕГИ DOCKER ОБРАЗОВ
# =============================================================================
# Тег ветки разработки:
#   - latest    : Production (main branch)
#   - dev       : Development (develop branch)  
#   - rc-X.Y.Z  : Release candidate
#   - test      : Локальное тестирование
IMAGE_TAG=latest

# Полный тег образа формируется как: ${ROS_DISTRO}-${IMAGE_TAG}
# Примеры результатов:
#   - lyrical-latest    : Production на ROS 2 Lyrical
#   - lyrical-dev       : Development на ROS 2 Lyrical
#   - jazzy-latest     : Production на ROS 2 Jazzy
#   - lyrical-rc-1.0.0  : Release candidate 1.0.0 на Lyrical

# =============================================================================
# РЕЕСТР DOCKER ОБРАЗОВ
# =============================================================================
REGISTRY=ghcr.io
REPOSITORY_OWNER=krikz

# Префиксы образов (используется в docker-compose.yaml)
BASE_IMAGE_PREFIX=${REGISTRY}/${REPOSITORY_OWNER}/rob_box_base
SERVICE_IMAGE_PREFIX=${REGISTRY}/${REPOSITORY_OWNER}/rob_box

# =============================================================================
# ПРИМЕРЫ ИСПОЛЬЗОВАНИЯ
# =============================================================================
#
# 1. Production на Humble (по умолчанию):
#    docker-compose pull && docker-compose up -d
#
# 2. Development на Humble:
#    IMAGE_TAG=dev docker-compose pull && docker-compose up -d
#
# 3. Тестирование на Jazzy:
#    ROS_DISTRO=jazzy IMAGE_TAG=dev docker-compose pull && docker-compose up -d
#
# 4. Локальные образы:
#    IMAGE_TAG=local docker-compose build && docker-compose up -d
#
# 5. Specific release:
#    IMAGE_TAG=rc-1.0.0 docker-compose pull && docker-compose up -d

# =============================================================================
# LLM ПРОВАЙДЕРЫ (text + vision, через rob_box_llm registry)
# =============================================================================
# По умолчанию dialogue_node и Telegram используют DeepSeek.
# Чтобы добавить MiniMax как opt-in провайдер (text + tools + vision),
# установите переменные ниже и выберите его через ROS-параметр
# llm_provider:=minimax (или в composition-root конфиге, см.
# docs/guides/examples/minimax_llm.yaml).
#
# Один и тот же ключ используется и для LLM, и для TTS (см. секцию ниже).
# Для chat-completions Group ID НЕ требуется (это параметр только T2A v2).
#
# MiniMax API Key (Bearer-токен для POST https://api.minimax.io/v1/chat/completions)
# Где взять: https://platform.minimaxi.com/user-center/basic-information/interface-key
# Формат: строка без префикса, например "eyJhbGciOi..."
MINIMAX_API_KEY=

# MiniMax base URL (опционально; по умолчанию в коде https://api.minimax.io/v1)
# Менять только в тестовых окружениях или при проксировании через mock-server.
MINIMAX_BASE_URL=

# MiniMax default model (опционально; по умолчанию MiniMax-M3, vision-capable).
# Альтернативы см. в docs/guides/MINIMAX.md §5.
MINIMAX_MODEL=

# =============================================================================
# TTS ПРОВАЙДЕРЫ (опционально, tts_node в rob_box_voice)
# =============================================================================
# По умолчанию TTS-нода использует Yandex Cloud TTS gRPC v3 + Silero v5 fallback.
# Чтобы переключиться на MiniMax T2A v2 (HTTP), установите:
#
#   provider=minimax  (ROS-параметр ноды)
#   MINIMAX_API_KEY=...        — bearer-токен из https://platform.minimaxi.com/user-center/basic-information/interface-key
#   MINIMAX_GROUP_ID=...       — group id из того же раздела (требуется ТОЛЬКО для TTS)
#
# Дополнительные параметры MiniMax (ROS):
#   minimax_voice       — id голоса (по умолчанию "male-qn-qingse")
#   minimax_model       — "speech-02-hd" (качество) | "speech-02-turbo" (скорость)
#   minimax_language    — "ru" | "en" | "zh" (маппится в human-readable на API)
#   minimax_speed       — 0.5 – 2.0 (по умолчанию 1.0)
#   minimax_sample_rate — Hz (по умолчанию 32000)
#   minimax_timeout     — httpx timeout в секундах (по умолчанию 30.0)
#
# Без MINIMAX_API_KEY/MINIMAX_GROUP_ID (для TTS) нода упадёт с TTSAuthError
# на первом запросе.
MINIMAX_GROUP_ID=
